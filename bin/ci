#!/usr/bin/env bash
# 로컬 CI — hooks/local-ci.sh 계약 (GitHub Actions 미사용. 설치는 README §설치 4단계)
set -euo pipefail
cd "$(dirname "$0")/.."

echo "[1/5] bash 문법 검사 (bash -n)"
fail=0
for f in scripts/*.sh hooks/*.sh bin/ci; do
  if ! bash -n "$f"; then
    echo "  ✗ $f"
    fail=1
  fi
done
[ "$fail" = 0 ] || exit 1

echo "[2/5] shellcheck (설치 시)"
if command -v shellcheck >/dev/null 2>&1; then
  shellcheck -S warning scripts/*.sh hooks/*.sh bin/ci
else
  echo "  shellcheck 미설치 — skip"
fi

echo "[3/5] repo-dir.sh 스모크 테스트"
out=$(ISSUE_RUNNER_PROJECTS_ROOT=/tmp scripts/repo-dir.sh owner/some-repo)
[ "$out" = "/tmp/some-repo" ] || { echo "  ✗ 기본 경로 해석 실패: $out"; exit 1; }

echo "[4/5] 한/영 SKILL 구조 동기화 검사 (## 헤더 개수·순서)"
fail=0
for pair in "SKILL.md:SKILL.en.md" "skills/loop-issues/SKILL.md:skills/loop-issues/SKILL.en.md" "skills/closeout/SKILL.md:skills/closeout/SKILL.en.md" "references/worker-template.md:references/worker-template.en.md"; do
  ko="${pair%%:*}"
  en="${pair#*:}"
  if [ ! -f "$ko" ] || [ ! -f "$en" ]; then
    echo "  ✗ 파일 누락: $ko ↔ $en 쌍이 모두 존재해야 한다"
    fail=1
    continue
  fi
  ko_count=$(grep -c '^## ' "$ko" || true)
  en_count=$(grep -c '^## ' "$en" || true)
  if [ "$ko_count" != "$en_count" ]; then
    echo "  ✗ 섹션 개수 불일치: $ko(${ko_count}개) vs $en(${en_count}개)"
    echo "    --- $ko"
    grep -n '^## ' "$ko" | sed 's/^/      /'
    echo "    --- $en"
    grep -n '^## ' "$en" | sed 's/^/      /'
    fail=1
    continue
  fi
  # 순서 검사: 헤더 제목은 번역되므로 텍스트 비교 불가 —
  # 언어 불변 마커(원형 숫자 ①②…)가 같은 위치에서 일치하는지 본다
  i=0
  while IFS=$'\t' read -r ko_h en_h; do
    i=$((i + 1))
    ko_mark=$(printf '%s\n' "$ko_h" | grep -o '[①②③④⑤⑥⑦⑧⑨⑩]' | head -1 || true)
    en_mark=$(printf '%s\n' "$en_h" | grep -o '[①②③④⑤⑥⑦⑧⑨⑩]' | head -1 || true)
    if [ "$ko_mark" != "$en_mark" ]; then
      echo "  ✗ 섹션 순서 불일치 (${i}번째 헤더): $ko '$ko_h' ↔ $en '$en_h'"
      fail=1
    fi
  done < <(paste <(grep '^## ' "$ko") <(grep '^## ' "$en"))
  # worker-template 쌍 한정: ## 헤더가 없는 파일이므로 절차 번호 줄(^N.) 개수도 검사
  if [ "$ko" = "references/worker-template.md" ]; then
    ko_steps=$(grep -c '^[0-9][0-9]*\.' "$ko" || true)
    en_steps=$(grep -c '^[0-9][0-9]*\.' "$en" || true)
    if [ "$ko_steps" != "$en_steps" ]; then
      echo "  ✗ 절차 번호 줄 개수 불일치: $ko(${ko_steps}개) vs $en(${en_steps}개)"
      fail=1
    fi
    # 필수 placeholder 존재 검사 — 디스패처가 런타임에 치환하는 계약
    # (<LESSONS_OR_ 는 언어별 접미사("없음"/"none")가 달라 접두만 본다)
    for ph in '<WT_PATH>' '<REPO>' '<NUM>' '<TITLE>' '<DEFAULT_BRANCH>' '<VERIFIER>' '<LESSONS_OR_'; do
      for f in "$ko" "$en"; do
        if ! grep -qF "$ph" "$f"; then
          echo "  ✗ 필수 placeholder 누락: $f 에 $ph 없음"
          fail=1
        fi
      done
    done
  fi
done
[ "$fail" = 0 ] || exit 1

echo "[5/5] 머지 게이트 PR 대상 파싱 스모크 테스트 (fail-closed)"
# gh 가 전부 실패하는 환경에서 <번호>·<URL>·<브랜치> 세 형태 모두 게이트가
# exit 2(차단)여야 한다 — 0 이면 식별 실패가 머지 우회로 새는 회귀.
tmp=$(mktemp -d)
mkdir "$tmp/stub"
printf '#!/bin/sh\nexit 1\n' > "$tmp/stub/gh"
chmod +x "$tmp/stub/gh"
gate="$PWD/hooks/ci-gate-before-pr-merge.sh"
fail=0
for form in "123" "https://github.com/o/r/pull/123" "feature-branch"; do
  rc=0
  printf '{"tool_input":{"command":"gh pr merge %s --squash"}}' "$form" \
    | (cd "$tmp" && PATH="$tmp/stub:$PATH" bash "$gate") >/dev/null 2>&1 || rc=$?
  if [ "$rc" != 2 ]; then
    echo "  ✗ gh pr merge $form → exit $rc (기대: 2 — 게이트 우회 회귀)"
    fail=1
  fi
done
rm -rf "$tmp"
[ "$fail" = 0 ] || exit 1

echo "[closeout] setup-labels.sh 에 harvesting·epic 라벨 정의 존재 검사"
for lbl in harvesting epic; do
  grep -qF "gh label create $lbl " scripts/setup-labels.sh || {
    echo "  ✗ setup-labels.sh 에 $lbl 라벨 정의 누락"; exit 1; }
done

echo "[closeout] ci-pass 헬퍼 fail-closed 스모크"
tmp=$(mktemp -d); mkdir "$tmp/stub"
printf '#!/bin/sh\nexit 1\n' > "$tmp/stub/gh"; chmod +x "$tmp/stub/gh"
rc=0; PATH="$tmp/stub:$PATH" bash scripts/closeout-ci-pass.sh owner/r 123 >/dev/null 2>&1 || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ ci-pass: gh 실패 시 exit $rc (기대 1)"; exit 1; }
rm -rf "$tmp"

echo "[closeout] ci-pass 로컬 CI 분기 세 결과 구분 스모크 (#70 — pass=0/fail=1/부재=2)"
# 로컬 CI 옵트인 레포(root 에 실행가능 bin/ci) → head SHA 캐시 결과로 0/1/2 구분.
# rebase 로 HEAD 가 바뀐 PR 은 새 SHA 결과파일이 부재 → exit 2(재검증 필요)여야 한다.
# (slug 은 repo-dir.sh 의 pwd -P 정규화 경로 기준 — macOS /tmp→/private 심링크 주의.)
ci_pass="$PWD/scripts/closeout-ci-pass.sh"
tmp=$(mktemp -d); mkdir -p "$tmp/stub" "$tmp/proj/r/bin" "$tmp/home"
printf '#!/bin/sh\nexit 0\n' > "$tmp/proj/r/bin/ci"   # 가짜 레포 체크아웃(로컬 CI 옵트인)
chmod +x "$tmp/proj/r/bin/ci"
cat > "$tmp/stub/gh" <<'STUB'
#!/bin/sh
case "$*" in
  *"pr view"*headRefOid*) echo '{"headRefOid":"cafef00d11"}' ;;
  *) echo '' ;;
esac
STUB
chmod +x "$tmp/stub/gh"
realroot=$(cd "$tmp/proj/r" && pwd -P)
slug=$(printf '%s' "$realroot" | sed 's#[/ ]#_#g; s#^_##')
mkdir -p "$tmp/home/.claude/.local-ci/$slug"
run_ci_pass_local() {
  PATH="$tmp/stub:$PATH" HOME="$tmp/home" ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" \
    bash "$ci_pass" o/r 5 >/dev/null 2>&1
}
result="$tmp/home/.claude/.local-ci/$slug/cafef00d11.result"
# (a) 결과파일 부재(현재 HEAD 미실행) → exit 2 (재검증 필요)
rm -f "$result"
rc=0; run_ci_pass_local || rc=$?
[ "$rc" = 2 ] || { echo "  ✗ ci-pass 로컬: 결과파일 부재 → exit $rc (기대 2)"; rm -rf "$tmp"; exit 1; }
# (b) 결과 == pass → exit 0
echo pass > "$result"
rc=0; run_ci_pass_local || rc=$?
[ "$rc" = 0 ] || { echo "  ✗ ci-pass 로컬: pass → exit $rc (기대 0)"; rm -rf "$tmp"; exit 1; }
# (c) 결과 == fail → exit 1
echo fail > "$result"
rc=0; run_ci_pass_local || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ ci-pass 로컬: fail → exit $rc (기대 1)"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] ci-pass rollup 폴백 스모크 (로컬 bin/ci 없는 레포)"
# 로컬 CI 없는 레포(repo-dir.sh 해석 root 에 bin/ci 부재) → GitHub statusCheckRollup
# 으로 판정 (ci-gate 의 그 외 레포 분기와 동일 계약, #51).
ci_pass="$PWD/scripts/closeout-ci-pass.sh"
tmp=$(mktemp -d); mkdir -p "$tmp/stub" "$tmp/proj/r"  # r/bin/ci 일부러 안 만든다
run_ci_pass() {  # $1=rollup JSON 배열 → gh stub 이 statusCheckRollup 으로 반환
  cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"pr view"*statusCheckRollup*) echo '{"statusCheckRollup":$1}' ;;
  *) echo '' ;;
esac
STUB
  chmod +x "$tmp/stub/gh"
  PATH="$tmp/stub:$PATH" ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" \
    bash "$ci_pass" o/r 5 >/dev/null 2>&1
}
# 전부 SUCCESS (check-run conclusion + 레거시 commit-status state 혼합) → exit 0
rc=0; run_ci_pass '[{"status":"COMPLETED","conclusion":"SUCCESS"},{"state":"SUCCESS"}]' || rc=$?
[ "$rc" = 0 ] || { echo "  ✗ ci-pass rollup: 전부 SUCCESS → exit $rc (기대 0)"; rm -rf "$tmp"; exit 1; }
# FAILURE 포함 → exit 1
rc=0; run_ci_pass '[{"status":"COMPLETED","conclusion":"SUCCESS"},{"status":"COMPLETED","conclusion":"FAILURE"}]' || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ ci-pass rollup: FAILURE 포함 → exit $rc (기대 1)"; rm -rf "$tmp"; exit 1; }
# 미완료(pending) 포함 → exit 1
rc=0; run_ci_pass '[{"status":"IN_PROGRESS"}]' || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ ci-pass rollup: 미완료 포함 → exit $rc (기대 1)"; rm -rf "$tmp"; exit 1; }
# 비-SUCCESS 종결 (열거 안 된 conclusion — STARTUP_FAILURE) 포함 → exit 1
# (SUCCESS 전용 allowlist 판정. denylist 면 여기를 통과시켜 CI 미통과를 pass 로 오인한다.)
rc=0; run_ci_pass '[{"status":"COMPLETED","conclusion":"SUCCESS"},{"status":"COMPLETED","conclusion":"STARTUP_FAILURE"}]' || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ ci-pass rollup: STARTUP_FAILURE 포함 → exit $rc (기대 1)"; rm -rf "$tmp"; exit 1; }
# 알 수 없는 종결값(미래/오타 conclusion) 포함 → exit 1 (allowlist 가 잡아야 한다)
rc=0; run_ci_pass '[{"status":"COMPLETED","conclusion":"UNKNOWN_STATE"}]' || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ ci-pass rollup: 알 수 없는 conclusion 포함 → exit $rc (기대 1)"; rm -rf "$tmp"; exit 1; }
# 빈 rollup(체크 0개) → exit 1
rc=0; run_ci_pass '[]' || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ ci-pass rollup: 빈 rollup → exit $rc (기대 1)"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] eligible 빈-스코프 스모크"
tmp=$(mktemp -d); mkdir "$tmp/stub"
cat > "$tmp/stub/gh" <<'EOF'
#!/bin/sh
case "$*" in *search/issues*) echo '{"items":[]}';; *) echo '';; esac
EOF
chmod +x "$tmp/stub/gh"
out=$(PATH="$tmp/stub:$PATH" bash scripts/closeout-eligible.sh 2>/dev/null); rc=$?
[ "$rc" = 0 ] && [ -z "$out" ] || { echo "  ✗ eligible 빈: rc=$rc out='$out'"; exit 1; }
rm -rf "$tmp"

echo "[closeout] eligible 재검증 후보 분기 스모크 (#70 — exit2=revalidate:true·exit1=탈락·exit0=false)"
# closeout-eligible.sh 가 ci-pass exit code 로 분기하는지 검증(로컬 CI 옵트인 레포).
# 캐시 부재(exit 2)+머지판정✅ → revalidate:true 로 출력, 캐시 fail(exit 1) → 미출력,
# 캐시 pass(exit 0) → revalidate:false. slug 은 ci-pass 와 같은 pwd -P 정규화 경로.
elig="$PWD/scripts/closeout-eligible.sh"
tmp=$(mktemp -d); mkdir -p "$tmp/stub" "$tmp/proj/r/bin" "$tmp/home"
printf '#!/bin/sh\nexit 0\n' > "$tmp/proj/r/bin/ci"   # 가짜 레포(로컬 CI 옵트인)
chmod +x "$tmp/proj/r/bin/ci"
cat > "$tmp/stub/gh" <<'STUB'
#!/bin/sh
case "$*" in
  *"api user"*) echo "tester" ;;
  *"search/issues"*) echo '[{"repo":"o/r","pr":5}]' ;;
  *"pr view"*headRefOid*) echo '{"headRefOid":"feed0070ab"}' ;;
  *"pr view"*headRefName*)
    echo '{"headRefName":"agent/issue-5","mergeable":"MERGEABLE","labels":[],"comments":[{"body":"머지 판정: ✅ 머지 가능"}],"closingIssuesReferences":[{"number":5}]}' ;;
  *) echo '' ;;
esac
STUB
chmod +x "$tmp/stub/gh"
realroot=$(cd "$tmp/proj/r" && pwd -P)
slug=$(printf '%s' "$realroot" | sed 's#[/ ]#_#g; s#^_##')
mkdir -p "$tmp/home/.claude/.local-ci/$slug"
result="$tmp/home/.claude/.local-ci/$slug/feed0070ab.result"
run_elig() {
  PATH="$tmp/stub:$PATH" HOME="$tmp/home" ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" \
    bash "$elig" 2>/dev/null
}
# (a) 캐시 부재(exit 2) + 머지판정✅ → 후보 출력 + revalidate:true
rm -f "$result"
out=$(run_elig)
printf '%s' "$out" | jq -e 'select(.pr==5 and .revalidate==true)' >/dev/null 2>&1 \
  || { echo "  ✗ eligible 재검증: 캐시 부재 → revalidate:true 미출력 out='$out'"; rm -rf "$tmp"; exit 1; }
# (b) 캐시 fail(exit 1) → 후보 탈락(출력 없음)
echo fail > "$result"
out=$(run_elig)
[ -z "$out" ] || { echo "  ✗ eligible 재검증: 캐시 fail → 탈락 안 됨 out='$out'"; rm -rf "$tmp"; exit 1; }
# (c) 캐시 pass(exit 0) → 후보 출력 + revalidate:false
echo pass > "$result"
out=$(run_elig)
printf '%s' "$out" | jq -e 'select(.pr==5 and .revalidate==false)' >/dev/null 2>&1 \
  || { echo "  ✗ eligible 재검증: 캐시 pass → revalidate:false 미출력 out='$out'"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] eligible sentinel 마커로 머신/사람 코멘트 판정 스모크 (#72)"
# 워커 머신 코멘트는 마지막 줄 <!-- bodat:worker --> 마커로 식별한다. 마커 단 코멘트는
# 접두사 어휘 무관('추가 보정' 같은 자기-노트 포함) unresolved 에서 제외되고, 마커
# 없는 사람 코멘트는 unresolved 로 집계돼 초록불 PR 을 후보에서 탈락시킨다(#72 회귀 가드).
elig="$PWD/scripts/closeout-eligible.sh"
tmp=$(mktemp -d); mkdir -p "$tmp/stub" "$tmp/proj/r/bin" "$tmp/home"
printf '#!/bin/sh\nexit 0\n' > "$tmp/proj/r/bin/ci"; chmod +x "$tmp/proj/r/bin/ci"
realroot=$(cd "$tmp/proj/r" && pwd -P)
slug=$(printf '%s' "$realroot" | sed 's#[/ ]#_#g; s#^_##')
mkdir -p "$tmp/home/.claude/.local-ci/$slug"
echo pass > "$tmp/home/.claude/.local-ci/$slug/feed0070ab.result"   # 캐시 pass → revalidate:false 경로
mkgh() {  # $1 = comments JSON 배열 → gh pr view ...headRefName 분기에 주입
  cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"search/issues"*) echo '[{"repo":"o/r","pr":5}]' ;;
  *"pr view"*headRefOid*) echo '{"headRefOid":"feed0070ab"}' ;;
  *"pr view"*headRefName*)
    echo '{"headRefName":"agent/issue-5","mergeable":"MERGEABLE","labels":[],"comments":$1,"closingIssuesReferences":[{"number":5}]}' ;;
  *) echo '' ;;
esac
STUB
  chmod +x "$tmp/stub/gh"
}
run_elig() { PATH="$tmp/stub:$PATH" HOME="$tmp/home" ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" bash "$elig" 2>/dev/null; }
# (a) 머신 코멘트만 (머지판정✅ + 마커 단 자기-노트 '추가 보정') → 후보 출력
mkgh '[{"body":"머지 판정: ✅ 머지 가능 <!-- bodat:worker -->"},{"body":"추가 보정 (e3cb586): revalidate 경로 보정 <!-- bodat:worker -->"}]'
out=$(run_elig)
printf '%s' "$out" | jq -e 'select(.pr==5)' >/dev/null 2>&1 \
  || { echo "  ✗ eligible 마커: 마커 단 머신 코멘트만인데 후보 탈락 out='$out'"; rm -rf "$tmp"; exit 1; }
# (b) 마커 없는 사람 코멘트 추가 → unresolved>0 로 탈락
mkgh '[{"body":"머지 판정: ✅ 머지 가능 <!-- bodat:worker -->"},{"body":"이 부분 다시 확인 부탁드립니다"}]'
out=$(run_elig)
[ -z "$out" ] || { echo "  ✗ eligible 마커: 마커 없는 사람 코멘트가 있는데 탈락 안 됨 out='$out'"; rm -rf "$tmp"; exit 1; }
# (c) 마커 없는 레거시 접두사 코멘트(마커 도입 이전 PR) → 동결 폴백으로 제외 → 후보 출력
mkgh '[{"body":"머지 판정: ✅ 머지 가능"},{"body":"검증자 리뷰: CLEAN"}]'
out=$(run_elig)
printf '%s' "$out" | jq -e 'select(.pr==5)' >/dev/null 2>&1 \
  || { echo "  ✗ eligible 마커: 레거시 접두사(마커 이전) 코멘트가 탈락됨 out='$out'"; rm -rf "$tmp"; exit 1; }
# (d) 영문 긍정 게이트: 영문 머지 판정(Merge verdict: ✅)+마커만 → 후보 출력(긍정 게이트 한·영)
mkgh '[{"body":"Merge verdict: ✅ ready to merge <!-- bodat:worker -->"}]'
out=$(run_elig)
printf '%s' "$out" | jq -e 'select(.pr==5)' >/dev/null 2>&1 \
  || { echo "  ✗ eligible 마커: 영문 머지 판정이 긍정 게이트 통과 못함 out='$out'"; rm -rf "$tmp"; exit 1; }
# (e) 마커가 줄 중간/본문에 있어도 머신으로 제외(contains 위치 무관 — 마지막줄 강제 아님이 계약)
mkgh '[{"body":"머지 판정: ✅ 머지 가능 <!-- bodat:worker -->"},{"body":"중간에 <!-- bodat:worker --> 박힌 자기-노트"}]'
out=$(run_elig)
printf '%s' "$out" | jq -e 'select(.pr==5)' >/dev/null 2>&1 \
  || { echo "  ✗ eligible 마커: 중간 마커 코멘트가 사람으로 오인돼 탈락 out='$out'"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] 머신 코멘트 sentinel 마커 주입 지시 검사 (#72)"
# 워커/closeout 머신 코멘트에 <!-- bodat:worker --> 마커를 박으라는 지시가 워커
# 템플릿(한/영)+closeout SKILL(한/영) 양쪽에 있어야 한다. 빠지면 접두사 allowlist 회귀.
for f in references/worker-template.md references/worker-template.en.md \
         skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  grep -qF '<!-- bodat:worker -->' "$f" || { echo "  ✗ $f 에 sentinel 마커 주입 지시 없음"; exit 1; }
done

echo "[closeout] reconcile 빈-결과 스모크"
tmp=$(mktemp -d); mkdir "$tmp/stub"
cat > "$tmp/stub/gh" <<'EOF'
#!/bin/sh
case "$*" in *search/issues*) echo '{"items":[]}';; *) echo '';; esac
EOF
chmod +x "$tmp/stub/gh"
out=$(PATH="$tmp/stub:$PATH" bash scripts/closeout-reconcile.sh 2>/dev/null); rc=$?
[ "$rc" = 0 ] && [ -z "$out" ] || { echo "  ✗ reconcile 빈: rc=$rc out='$out'"; exit 1; }
rm -rf "$tmp"

echo "[closeout] reconcile harvesting PR 분류 스모크 (#44)"
# OPEN PR 에 harvesting 라벨이 있으면 pr_open 이 아니라 harvesting 이벤트로 분류돼야
# 한다 (② Maintain 이 closeout 점유 PR 을 건드리지 않도록). OPEN 경로는 worktree
# 디렉토리를 만지지 않으므로 gh 세 형태만 스텁한다.
tmp=$(mktemp -d); mkdir "$tmp/stub"
cat > "$tmp/stub/gh" <<'EOF'
#!/bin/sh
case "$*" in
  *"api user"*) echo "tester" ;;
  *"search issues"*) echo '[{"repository":{"nameWithOwner":"o/r"},"number":44}]' ;;
  *"pr list"*) echo '[{"number":99,"state":"OPEN","statusCheckRollup":[],"labels":[{"name":"harvesting"}]}]' ;;
  *) echo '' ;;
esac
EOF
chmod +x "$tmp/stub/gh"
out=$(PATH="$tmp/stub:$PATH" ISSUE_RUNNER_PROJECTS_ROOT="$tmp" bash scripts/reconcile.sh 2>/dev/null)
ev=$(printf '%s' "$out" | jq -r 'select(.number==44) | .event' 2>/dev/null | head -1)
[ "$ev" = "harvesting" ] || { echo "  ✗ harvesting PR 분류 실패: event='$ev' (기대 harvesting)"; exit 1; }
rm -rf "$tmp"

echo "[closeout] references placeholder 검사"
# macOS 기본 bash 3.2 는 declare -A 미지원 — case 분기로 파일별 placeholder 매핑.
for f in skills/closeout/references/verifier-prompt.md \
         skills/closeout/references/deploy-check-issue.md \
         skills/closeout/references/spinoff-issue.md; do
  [ -f "$f" ] || { echo "  ✗ 누락: $f"; exit 1; }
  case "$f" in
    # <DIFF>·<ISSUE_BODY>: 검증자가 sandbox 네트워크 없이 판정하도록 메인 세션이
    # diff·이슈 본문을 동봉하는 지점 — 지우면 원문 fetch 회귀(#54).
    *verifier-prompt.md)    phs="<PR> <REPO> <BASE> <PLAN_REF> <DIFF> <ISSUE_BODY>" ;;
    *deploy-check-issue.md) phs="<PR> <SHA> <SUMMARY> <DEPLOY_CMD> <LIVE_CHECKS> <VERIFY_URL>" ;;
    *spinoff-issue.md)      phs="<BACKGROUND> <REASON> <PLAN> <TEST_PLAN> <RELATED>" ;;
  esac
  # shellcheck disable=SC2086
  for ph in $phs; do
    grep -qF "$ph" "$f" || { echo "  ✗ $f 에 $ph 없음"; exit 1; }
  done
done

echo "[closeout] smoke-prompt 한/영 placeholder 검사 (#69)"
# 5단계 Chrome 스모크 동봉형 프롬프트(verifier-prompt.md 미러) — 한/영 양쪽이
# 존재하고 두 placeholder 를 다 담아야 한다. <VERIFY_URL>=production 베이스 URL,
# <LIVE_CHECKS>=배포 이슈 본문의 검증 항목 — 5단계가 런타임에 치환하는 계약.
# 지우면 동봉형 프롬프트가 깨져 스모크가 빈 컨텍스트로 도는 회귀.
for f in skills/closeout/references/smoke-prompt.md \
         skills/closeout/references/smoke-prompt.en.md; do
  [ -f "$f" ] || { echo "  ✗ 누락: $f"; exit 1; }
  for ph in '<VERIFY_URL>' '<LIVE_CHECKS>'; do
    grep -qF "$ph" "$f" || { echo "  ✗ $f 에 $ph 없음"; exit 1; }
  done
done

echo "[closeout] SKILL 5단계 Chrome 스모크(smoke-prompt) 문서화 검사 (#69)"
# closeout ③ 5단계가 chrome-devtools MCP 로 검증 URL 에 스모크를 돌리고, MCP 부재/
# URL 도달불가 시 사람-보고 경로로 폴백하며 skip 코멘트를 남긴다는 지시가 한/영
# 양쪽에 있어야 한다. smoke-prompt 는 동봉형 프롬프트 파일명(언어 불변 토큰)이라
# 한 가드로 양 파일을 덮는다. 단어만 남고 저하(degrade) 지시가 빠지는 회귀를 막기
# 위해, smoke-prompt 를 담은 단락(빈 줄 구분)에 chrome-devtools 와 <VERIFY_URL> 이
# 함께 있는지 awk 로 확인한다(#70 패턴). 지우면 5단계가 수동 대기로 되돌아가는 회귀.
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  grep -qF 'smoke-prompt' "$f" || { echo "  ✗ $f 에 5단계 Chrome 스모크(smoke-prompt) 지시 없음"; exit 1; }
  awk 'BEGIN{RS="";ok=0} /smoke-prompt/ && /chrome-devtools/ && /<VERIFY_URL>/ {ok=1} END{exit ok?0:1}' "$f" \
    || { echo "  ✗ $f 의 smoke-prompt 단락에 chrome-devtools·<VERIFY_URL> 구동 지시 없음"; exit 1; }
done

echo "[closeout] ci-gate --repo 분기 스모크 (positive + fail-closed)"
# flag_repo 가 있으면 게이트가 cwd 가 아니라 그 레포 기준으로 SHA·캐시를 잡아야 한다 (#47).
gate="$PWD/hooks/ci-gate-before-pr-merge.sh"
tmp=$(mktemp -d)
mkdir -p "$tmp/stub" "$tmp/proj/r/bin" "$tmp/home"
printf '#!/bin/sh\nexit 0\n' > "$tmp/proj/r/bin/ci"   # 가짜 레포 체크아웃(로컬 CI 옵트인)
chmod +x "$tmp/proj/r/bin/ci"
cat > "$tmp/stub/gh" <<'STUB'
#!/bin/sh
case "$*" in
  *"pr view"*headRefOid*) echo '{"headRefOid":"deadbeef00"}' ;;
  *) echo '' ;;
esac
STUB
chmod +x "$tmp/stub/gh"
# 게이트는 repo-dir.sh 가 pwd -P 로 정규화한 경로(/private/var…)로 slug 를 잡는다 →
# 캐시 경로도 같은 정규화 경로로 맞춰야 매칭된다 (macOS /tmp→/private 심링크 주의).
realroot=$(cd "$tmp/proj/r" && pwd -P)
slug=$(printf '%s' "$realroot" | sed 's#[/ ]#_#g; s#^_##')
mkdir -p "$tmp/home/.claude/.local-ci/$slug"
run_gate() {
  printf '{"tool_input":{"command":"gh pr merge 5 --repo o/r --squash"}}' \
    | HOME="$tmp/home" ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" PATH="$tmp/stub:$PATH" \
      bash "$gate" >/dev/null 2>&1
}
echo pass > "$tmp/home/.claude/.local-ci/$slug/deadbeef00.result"
rc=0; run_gate || rc=$?
[ "$rc" = 0 ] || { echo "  ✗ --repo positive(캐시 pass): exit $rc (기대 0 — 게이트가 o/r 를 안 봄)"; rm -rf "$tmp"; exit 1; }
rm -f "$tmp/home/.claude/.local-ci/$slug/deadbeef00.result"
rc=0; run_gate || rc=$?
[ "$rc" = 2 ] || { echo "  ✗ --repo fail-closed(캐시 없음): exit $rc (기대 2)"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[gate] ci-gate rollup 폴백 스모크 (SUCCESS-only allowlist, #60)"
# 로컬 bin/ci 없는 레포 → 게이트가 GitHub statusCheckRollup 으로 판정.
# closeout-ci-pass 스모크와 대칭: 전부 SUCCESS→통과(exit 0), 그 외 종결값은
# allowlist 가 전부 차단(exit 2). denylist 면 STARTUP_FAILURE·미열거 conclusion 이
# 새어 비통과 PR 이 머지로 흘러간다.
gate="$PWD/hooks/ci-gate-before-pr-merge.sh"
tmp=$(mktemp -d); mkdir -p "$tmp/stub" "$tmp/proj/r"  # r/bin/ci 일부러 안 만든다(폴백 강제)
run_gate_rollup() {  # $1=rollup JSON 배열 → gh stub 이 statusCheckRollup 으로 반환
  cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"pr view"*statusCheckRollup*) echo '{"statusCheckRollup":$1}' ;;
  *"pr view"*number*) echo '{"number":5}' ;;
  *) echo '' ;;
esac
STUB
  chmod +x "$tmp/stub/gh"
  printf '{"tool_input":{"command":"gh pr merge 5 --repo o/r --squash"}}' \
    | ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" PATH="$tmp/stub:$PATH" \
      bash "$gate" >/dev/null 2>&1
}
# 전부 SUCCESS (check-run conclusion + 레거시 commit-status state 혼합) → 통과 보존(exit 0)
rc=0; run_gate_rollup '[{"status":"COMPLETED","conclusion":"SUCCESS"},{"state":"SUCCESS"}]' || rc=$?
[ "$rc" = 0 ] || { echo "  ✗ ci-gate rollup: 전부 SUCCESS → exit $rc (기대 0)"; rm -rf "$tmp"; exit 1; }
# denylist 회귀: FAILURE/CANCELLED/TIMED_OUT 여전히 차단(exit 2)
for c in FAILURE CANCELLED TIMED_OUT; do
  rc=0; run_gate_rollup "[{\"status\":\"COMPLETED\",\"conclusion\":\"$c\"}]" || rc=$?
  [ "$rc" = 2 ] || { echo "  ✗ ci-gate rollup: $c → exit $rc (기대 2)"; rm -rf "$tmp"; exit 1; }
done
# 미완료(pending) 포함 → 차단 보존(exit 2)
rc=0; run_gate_rollup '[{"status":"IN_PROGRESS"}]' || rc=$?
[ "$rc" = 2 ] || { echo "  ✗ ci-gate rollup: 미완료 → exit $rc (기대 2)"; rm -rf "$tmp"; exit 1; }
# 비-SUCCESS 종결 (열거 안 된 conclusion — STARTUP_FAILURE) 포함 → 차단(exit 2)
# (allowlist 핵심: denylist 면 여기를 통과시켜 CI 미통과를 머지로 흘린다.)
rc=0; run_gate_rollup '[{"status":"COMPLETED","conclusion":"SUCCESS"},{"status":"COMPLETED","conclusion":"STARTUP_FAILURE"}]' || rc=$?
[ "$rc" = 2 ] || { echo "  ✗ ci-gate rollup: STARTUP_FAILURE → exit $rc (기대 2)"; rm -rf "$tmp"; exit 1; }
# 알 수 없는 종결값(미래/오타 conclusion) 포함 → 차단(exit 2)
rc=0; run_gate_rollup '[{"status":"COMPLETED","conclusion":"UNKNOWN_STATE"}]' || rc=$?
[ "$rc" = 2 ] || { echo "  ✗ ci-gate rollup: 알 수 없는 conclusion → exit $rc (기대 2)"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] README 두 루프 분업 문서화 검사 (#45)"
# closeout 루프 문서화 — 부하 핵심 문자열 + issue-runner 머지 불변 보존.
for s in '/closeout' 'harvesting' 'MAX_CLOSEOUT' '머지는 항상 사람이 한다'; do
  grep -qF "$s" README.md || { echo "  ✗ README.md 에 '$s' 없음"; exit 1; }
done

echo "[closeout] SKILL 3단계 캐시 보강(run-local-ci.sh) 문서화 검사 (#58)"
# closeout ③ 3단계 doc push 직후 run-local-ci.sh 로 메인 slug 캐시를 채운다는
# 지시가 한/영 SKILL 양쪽에 있어야 한다 (워크트리 provenance — 머지 게이트 cache-miss
# 방지). 지우면 Plans/*.md 를 가진 PR 의 마감이 stage 3 직후 막히는 회귀.
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  grep -qF 'run-local-ci.sh' "$f" || { echo "  ✗ $f 에 run-local-ci.sh 캐시 보강 지시 없음"; exit 1; }
done

echo "[closeout] SKILL 2단계 rebase된 HEAD 재검증(revalidate) 문서화 검사 (#70)"
# closeout ③ 2단계 머지 게이트가 revalidate:true 후보를 머지 직전 run-local-ci.sh 로
# 재검증한다는 지시가 한/영 SKILL 양쪽에 있어야 한다. revalidate 는 closeout-eligible.sh
# 출력 JSON 필드명(언어 불변 토큰)이라 한 가드로 양 파일을 덮는다. run-local-ci.sh 는
# 3단계 캐시 보강도 쓰므로 단독으로는 2단계 재검증 경로 존재를 증명 못 한다 — revalidate
# 토큰이 그 경로의 식별자다. 지우면 rebase 로 HEAD 가 바뀐 PR 이 양쪽 사각지대에
# 끼는 회귀(#70 배경).
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  grep -qF 'revalidate' "$f" || { echo "  ✗ $f 에 rebase HEAD 재검증(revalidate) 지시 없음"; exit 1; }
  # revalidate 경로가 실제로 현재 HEAD 에 로컬 CI 를 돌린다는 핵심 지시를 확인:
  # revalidate 와 같은 단락(빈 줄로 구분)에 run-local-ci.sh 가 있어야 한다. 단어만
  # 남고 재실행 지시가 빠지는 회귀를 막는다(#70 codex NIT). awk 로 revalidate 를 담은
  # 단락만 떼어 그 안에서 run-local-ci.sh 를 찾는다.
  awk 'BEGIN{RS="";ok=0} /revalidate/ && /run-local-ci\.sh/ {ok=1} END{exit ok?0:1}' "$f" \
    || { echo "  ✗ $f 의 revalidate 단락에 run-local-ci.sh 재검증 지시 없음"; exit 1; }
done

echo "[closeout] cleanup-worktree.sh 동작 스모크 (#62)"
# 공유 worktree 정리 헬퍼 — 더티/미push/--merged/멱등 동작을 실제 git worktree 로 검증.
clean_wt="$PWD/scripts/cleanup-worktree.sh"
[ -x "$clean_wt" ] || { echo "  ✗ scripts/cleanup-worktree.sh 미존재/비실행"; exit 1; }
tmp=$(mktemp -d)
mk_repo() {  # $1=issue-num → o/r 레포 + agent/issue-<N> worktree 생성, 더티/upstream 인자 반영
  local inum="$1"
  rm -rf "$tmp/proj"; mkdir -p "$tmp/proj/r"
  git -C "$tmp/proj/r" init -q
  git -C "$tmp/proj/r" config user.email t@t; git -C "$tmp/proj/r" config user.name t
  git -C "$tmp/proj/r" commit -q --allow-empty -m init
  git -C "$tmp/proj/r" worktree add -q -b "agent/issue-$inum" \
    "$tmp/proj/r/.claude/worktrees/issue-$inum" >/dev/null 2>&1
}
run_clean() {  # $@ = cleanup-worktree.sh 인자 (repo issue-num [--merged])
  PATH="$PATH" ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" bash "$clean_wt" "$@"
}
# (a) clean + --merged → 제거됨(exit 0), worktree 디렉토리 사라짐
mk_repo 5
rc=0; out=$(run_clean o/r 5 --merged 2>&1) || rc=$?
[ "$rc" = 0 ] || { echo "  ✗ clean+--merged: exit $rc (기대 0) out='$out'"; rm -rf "$tmp"; exit 1; }
[ ! -d "$tmp/proj/r/.claude/worktrees/issue-5" ] || { echo "  ✗ clean+--merged: worktree 미제거"; rm -rf "$tmp"; exit 1; }
# (b) dirty + --merged → 보류(exit 1), warn JSON, worktree 잔존 (더티 가드는 --merged 여도 유지)
mk_repo 6
echo dirty > "$tmp/proj/r/.claude/worktrees/issue-6/x.txt"
rc=0; out=$(run_clean o/r 6 --merged 2>&1) || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ dirty+--merged: exit $rc (기대 1)"; rm -rf "$tmp"; exit 1; }
printf '%s' "$out" | jq -e 'select(.event=="warn" and .number==6)' >/dev/null 2>&1 \
  || { echo "  ✗ dirty+--merged: warn JSON 누락 out='$out'"; rm -rf "$tmp"; exit 1; }
[ -d "$tmp/proj/r/.claude/worktrees/issue-6" ] || { echo "  ✗ dirty+--merged: worktree 오제거"; rm -rf "$tmp"; exit 1; }
# (c) clean + 기본(플래그 없음) + upstream 없음 → 미push 가드로 보류(exit 1), warn JSON
mk_repo 7
rc=0; out=$(run_clean o/r 7 2>&1) || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ clean+기본+no-upstream: exit $rc (기대 1)"; rm -rf "$tmp"; exit 1; }
printf '%s' "$out" | jq -e 'select(.event=="warn" and .number==7)' >/dev/null 2>&1 \
  || { echo "  ✗ clean+기본+no-upstream: warn JSON 누락 out='$out'"; rm -rf "$tmp"; exit 1; }
[ -d "$tmp/proj/r/.claude/worktrees/issue-7" ] || { echo "  ✗ clean+기본+no-upstream: worktree 오제거"; rm -rf "$tmp"; exit 1; }
# (d) 멱등: worktree 없음 → no-op(exit 0), 출력 없음
rm -rf "$tmp/proj"; mkdir -p "$tmp/proj/r"
git -C "$tmp/proj/r" init -q
rc=0; out=$(run_clean o/r 99 --merged 2>&1) || rc=$?
[ "$rc" = 0 ] && [ -z "$out" ] || { echo "  ✗ 멱등(없음): exit $rc out='$out' (기대 0/빈)"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] reconcile dirty worktree warn 회귀 스모크 (#62 — 동작 불변)"
# reconcile 가 헬퍼를 부르도록 리팩터된 뒤에도 MERGED PR + dirty worktree 는
# 정확히 한 줄 warn(원래 메시지 형식)을 내고 merged 이벤트를 안 내야 한다.
tmp=$(mktemp -d); mkdir -p "$tmp/proj/r" "$tmp/stub"
git -C "$tmp/proj/r" init -q
git -C "$tmp/proj/r" config user.email t@t; git -C "$tmp/proj/r" config user.name t
git -C "$tmp/proj/r" commit -q --allow-empty -m init
git -C "$tmp/proj/r" worktree add -q -b "agent/issue-8" \
  "$tmp/proj/r/.claude/worktrees/issue-8" >/dev/null 2>&1
echo dirty > "$tmp/proj/r/.claude/worktrees/issue-8/x.txt"
cat > "$tmp/stub/gh" <<'EOF'
#!/bin/sh
case "$*" in
  *"api user"*) echo "tester" ;;
  *"search issues"*) echo '[{"repository":{"nameWithOwner":"o/r"},"number":8}]' ;;
  *"pr list"*) echo '[{"number":80,"state":"MERGED","statusCheckRollup":[],"labels":[]}]' ;;
  *) echo '' ;;
esac
EOF
chmod +x "$tmp/stub/gh"
out=$(PATH="$tmp/stub:$PATH" ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" bash scripts/reconcile.sh 2>/dev/null)
warn_n=$(printf '%s\n' "$out" | jq -rs '[.[] | select(.event=="warn")] | length' 2>/dev/null)
merged_n=$(printf '%s\n' "$out" | jq -rs '[.[] | select(.event=="merged")] | length' 2>/dev/null)
[ "$warn_n" = 1 ] && [ "$merged_n" = 0 ] || { echo "  ✗ reconcile dirty: warn=$warn_n merged=$merged_n (기대 1/0) out='$out'"; rm -rf "$tmp"; exit 1; }
printf '%s' "$out" | jq -e 'select(.event=="warn") | .msg | test("dirty")' >/dev/null 2>&1 \
  || { echo "  ✗ reconcile dirty: warn 메시지 형식 변형 out='$out'"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] closeout-reconcile MERGED → cleanup --merged 호출 검사 (#62)"
# MERGED 분기가 PR head 에서 이슈번호를 파싱해 cleanup-worktree.sh ... --merged 를
# 부르는지 검사한다. 호출을 가로채는 stub cleanup-worktree.sh 로 인자를 캡처.
grep -qE 'cleanup-worktree\.sh.*--merged' scripts/closeout-reconcile.sh \
  || { echo "  ✗ closeout-reconcile.sh 에 cleanup-worktree.sh --merged 호출 없음"; exit 1; }
grep -qF 'headRefName' scripts/closeout-reconcile.sh \
  || { echo "  ✗ closeout-reconcile.sh 가 PR head(headRefName)에서 이슈번호 파싱 안 함"; exit 1; }
# 런타임 검증: closeout-reconcile.sh 를 임시 scripts 디렉토리로 복사하고
# cleanup-worktree.sh 를 인자 캡처 스텁으로 갈아끼워, MERGED 분기가 (a) 매칭
# 브랜치에서 cleanup --merged 를 부르고 (b) cleanup 실패에도 merged_cleanup 을
# 내며 (c) 비매칭 브랜치에선 cleanup 을 안 부르는지 확인한다.
crun() {  # $1=headRefName → out 은 stdout, capture 파일은 $tmp/capture
  tmp=$(mktemp -d); mkdir "$tmp/sc"
  cp scripts/closeout-reconcile.sh "$tmp/sc/closeout-reconcile.sh"
  cat > "$tmp/sc/cleanup-worktree.sh" <<CAP
#!/bin/sh
printf '%s\n' "\$*" >> "$tmp/capture"
exit 1
CAP
  chmod +x "$tmp/sc/cleanup-worktree.sh"
  cat > "$tmp/sc/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"search/issues"*) echo '[{"repo":"o/r","num":80}]' ;;
  *"pr view"*headRefName*) echo '$1' ;;
  *"pr view"*state*) echo 'MERGED' ;;
  *) echo '' ;;
esac
STUB
  chmod +x "$tmp/sc/gh"
  out=$(PATH="$tmp/sc:$PATH" bash "$tmp/sc/closeout-reconcile.sh" 2>/dev/null)
}
# (a)+(b): 매칭 브랜치 → cleanup --merged 호출(캡처) + cleanup 실패해도 merged_cleanup 출력
crun "agent/issue-7"
grep -qE '^o/r 7 --merged$' "$tmp/capture" 2>/dev/null \
  || { echo "  ✗ closeout-reconcile 런타임: cleanup 호출 인자 불일치 (capture='$(cat "$tmp/capture" 2>/dev/null)')"; rm -rf "$tmp"; exit 1; }
printf '%s' "$out" | jq -e 'select(.event=="merged_cleanup")' >/dev/null 2>&1 \
  || { echo "  ✗ closeout-reconcile 런타임: cleanup 실패 시 merged_cleanup 미출력 out='$out'"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"
# (c): 비매칭 브랜치(agent/issue- 접두 없음) → cleanup 호출 안 함, merged_cleanup 은 출력
crun "some-other-branch"
[ ! -f "$tmp/capture" ] \
  || { echo "  ✗ closeout-reconcile 런타임: 비매칭 브랜치에서 cleanup 오호출 (capture='$(cat "$tmp/capture")')"; rm -rf "$tmp"; exit 1; }
printf '%s' "$out" | jq -e 'select(.event=="merged_cleanup")' >/dev/null 2>&1 \
  || { echo "  ✗ closeout-reconcile 런타임: 비매칭 브랜치 merged_cleanup 미출력 out='$out'"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] SKILL worktree 정리(cleanup-worktree.sh) 문서화 검사 (#62)"
# closeout 이 머지 직후 스스로 worktree 를 정리한다는 지시가 한/영 양쪽에 있어야 한다
# (issue-runner reconcile 의존 제거 — 지우면 closeout-only 세션서 worktree 적체 회귀).
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  grep -qF 'cleanup-worktree.sh' "$f" || { echo "  ✗ $f 에 cleanup-worktree.sh 정리 지시 없음"; exit 1; }
done

echo "[worker-template] 참조 이슈 본문 체크박스 reconcile 지시 존재 검사 (#66)"
# 워커가 PR 최종 단계에서 참조 이슈 본문의 체크박스를 reconcile(완료=[x],
# 미완=[ ] 유지) 하라는 지시가 한/영 워커 템플릿 양쪽에 있어야 한다. 본문 마크
# 동기화는 `gh issue edit --body` 로 한다 — 이 호출은 템플릿 다른 곳에 안 나오는
# 언어 불변 토큰이라 한 가드로 양 파일을 덮는다. 지우면 PR 머지 후 이슈가
# 체크박스 전부 빈 채로 닫히는 회귀(#66 배경).
for f in references/worker-template.md references/worker-template.en.md; do
  grep -qF 'gh issue edit' "$f" || { echo "  ✗ $f 에 참조 이슈 체크박스 reconcile(gh issue edit) 지시 없음"; exit 1; }
done

echo "CI pass"
