  || { echo "  ✗ SKILL.md 에 CI 대기 재개 갈래의 worktree 제거·claim 해제 금지 명문화 없음"; exit 1; }
grep -qF -- 'CI 대기 중' SKILL.en.md || { echo "  ✗ SKILL.en.md working 항목에 'CI 대기 중' 갈래 없음"; exit 1; }
grep -qF -- 'SendMessage' SKILL.en.md || { echo "  ✗ SKILL.en.md 에 SendMessage 재개 지시 없음"; exit 1; }
grep -qF -- 'Do not remove the worktree or release the claim' SKILL.en.md \
  || { echo "  ✗ SKILL.en.md 에 CI 대기 재개 갈래의 worktree 제거·claim 해제 금지 명문화 없음"; exit 1; }
# 재개 경로는 실패 모드가 크다(claim·worktree 무한 정체) — 근거 없이 지시만 남으면
# 다음 디스패처가 못 믿고 사망 처리로 샌다(#189 리뷰 P1). 근거(계약문 인용·운영 실측)와
# 재개 실패 시 폴백(worktree·브랜치 재사용 대체 디스패치)이 같은 자리에 있어야 한다.
grep -qF -- 'continue a previously spawned agent with its context intact' SKILL.md \
  || { echo "  ✗ SKILL.md 에 SendMessage 재개 근거(Agent 툴 계약문 인용) 없음"; exit 1; }
grep -qF -- 'the same task-id may notify more than once' SKILL.md \
  || { echo "  ✗ SKILL.md 에 SendMessage 재개 근거(완료 알림 note 인용) 없음"; exit 1; }
grep -qF -- '기존 worktree·브랜치를 그대로 재사용해 대체 워커를 디스패치' SKILL.md \
  || { echo "  ✗ SKILL.md 에 재개 실패 시 폴백(worktree 재사용 대체 디스패치) 없음"; exit 1; }
grep -qF -- 'continue a previously spawned agent with its context intact' SKILL.en.md \
  || { echo "  ✗ SKILL.en.md 에 SendMessage 재개 근거(Agent 툴 계약문 인용) 없음"; exit 1; }
grep -qF -- 'the same task-id may notify more than once' SKILL.en.md \
  || { echo "  ✗ SKILL.en.md 에 SendMessage 재개 근거(완료 알림 note 인용) 없음"; exit 1; }
grep -qF -- 'dispatch a replacement worker' SKILL.en.md \
  || { echo "  ✗ SKILL.en.md 에 재개 실패 시 폴백(worktree 재사용 대체 디스패치) 없음"; exit 1; }
# 재개 갈래는 아래로 흐르면 안 된다 — 방금 깨운 워커는 '살아있음'이라 그 아래 timebox
# 문단(초과 시 TaskStop+worktree 제거+claim 해제)에 그대로 걸려 **막 재개한 워커를 죽인다**
# (#189 리뷰 P1). 문서는 순서대로 읽는 LLM 이 소비하므로 ⑴ 재개 성공 시 이번 틱 종료와
# ⑵ timebox 문단의 재개분 면제를 **양쪽 다** 명문화해야 한다 — 하나만 남으면 그 하나를
# 놓친 디스패처가 청소 경로로 샌다.
grep -qF -- '재개에 성공했으면 이 이슈는 이번 틱에서 여기까지다' SKILL.md \
  || { echo "  ✗ SKILL.md 에 재개 성공 시 이번 틱 종료(아래 timebox 청소로 흐르지 마라) 명문화 없음"; exit 1; }
grep -qF -- '재개한 이슈는 면제다' SKILL.md \
  || { echo "  ✗ SKILL.md timebox 문단에 '이번 틱 재개분 면제' 명문화 없음"; exit 1; }
grep -qF -- 'this issue is finished for this tick' SKILL.en.md \
  || { echo "  ✗ SKILL.en.md 에 재개 성공 시 이번 틱 종료 명문화 없음"; exit 1; }
grep -qF -- 'do not run the timebox cleanup at its end' SKILL.en.md \
  || { echo "  ✗ SKILL.en.md 에 재개 성공 시 timebox 청소 금지 명문화 없음"; exit 1; }
grep -qF -- 'tick is exempt' SKILL.en.md \
  || { echo "  ✗ SKILL.en.md timebox 문단에 '이번 틱 재개분 면제' 명문화 없음"; exit 1; }

echo "[#185] 큐 중단·유령 티켓 회수·HEAD 폐기 = 미실행(같은 SHA 재큐잉) 판별 검사 — 워커 템플릿 한/영"
# 정책 재심(2026-09-11, 이슈 #185 코멘트) — 러너를 detach 하지 않는다(범위 밖 유지).
# 결과 파일(<sha>.result)이 안 생겼을 때 queue.log 의 그 SHA 줄이 중단(INT/TERM)·
# 유령 티켓 회수·폐기 중 하나면 CI 실패가 아니라 미실행이다 — 로그를 뒤지지 말고
# 같은 SHA 로 run-local-ci.sh 를 다시 건다. 세 상태 + 미실행 판정 문구 + 재큐잉 지시가
# 한/영 템플릿 양쪽에 있어야 한다.
for f in references/worker-template.md references/worker-template.en.md; do
  for tok in '유령 티켓 회수' '폐기' '중단(INT/TERM)'; do
    grep -qF -- "$tok" "$f" || { echo "  ✗ $f 에 미실행 판별 상태 토큰 없음: $tok"; exit 1; }
  done
done
grep -qF -- 'CI 실패가 아니라 미실행이다' references/worker-template.md \
  || { echo "  ✗ references/worker-template.md 에 '실패가 아니라 미실행' 판정 문구 없음"; exit 1; }
grep -qF -- 'not a CI failure' references/worker-template.en.md \
  || { echo "  ✗ references/worker-template.en.md 에 'not a CI failure' 판정 문구 없음"; exit 1; }
grep -qF -- '같은 SHA(지금 HEAD)로' references/worker-template.md \
  || { echo "  ✗ references/worker-template.md 에 같은 SHA 재큐잉 지시 없음"; exit 1; }
grep -qF -- 're-queue the same SHA (current HEAD)' references/worker-template.en.md \
  || { echo "  ✗ references/worker-template.en.md 에 same-SHA 재큐잉 지시 없음"; exit 1; }

echo "[#185] 사람 결정(2026-09-11) 재개 4항목 — 툴 타임아웃 시 살아있는 실행부터 찾기 검사 — 워커 템플릿 한/영"
# 재심 정정 코멘트 — 툴 타임아웃은 큐의 잡을 죽이지 않는다, 끊기는 것은 기다리던
# 툴 호출뿐이다. 회수는 `ci-queue.sh wait <SHA> --timeout 540` 의 **종료 코드**로
# 판정한다: 0/1=판정 있음(재큐 금지) · 124=대기·실행 중(다음 툴콜에서 재진입) ·
# 2=큐에도 결과도 없음(그때만 같은 SHA 1회 재큐). `ps` 로 bin/ci 프로세스를 뒤지는
# 판정은 **금지**다(2026-09-11 사람 결정) — 내 SHA 가 큐에서 기다리는 중이면 내
# bin/ci 는 아직 없고 ps 에 잡히는 것은 남의 워커 CI 라, 그걸 기다린 뒤 "결과 없음
# = 미실행" 으로 흘러 멀쩡한 티켓을 중복 재큐한다. 겹침 금지 불릿(위 [#185] 블록)이
# 같은 명령을 이미 금지하고 있어, ps 를 회수 수단으로 실으면 한 문서가 한 명령을
# 금지이자 필수로 가르치게 된다.
grep -qF -- '툴 타임아웃 ≠ 작업 중단' references/worker-template.md \
  || { echo "  ✗ references/worker-template.md 에 '툴 타임아웃 ≠ 작업 중단' 명시 문구 없음"; exit 1; }
grep -qF -- 'Tool timeout ≠ work stopped' references/worker-template.en.md \
  || { echo "  ✗ references/worker-template.en.md 에 'Tool timeout ≠ work stopped' 명시 문구 없음"; exit 1; }
grep -qF -- 'TaskList' references/worker-template.md \
  || { echo "  ✗ references/worker-template.md 에 TaskList 확인 지시 없음"; exit 1; }
grep -qF -- 'ci-queue.sh wait' references/worker-template.md \
  || { echo "  ✗ references/worker-template.md 에 ci-queue.sh wait 회수 지시 없음"; exit 1; }
grep -qF -- 'ci-queue.sh wait' references/worker-template.en.md \
  || { echo "  ✗ references/worker-template.en.md 에 ci-queue.sh wait 회수 지시 없음"; exit 1; }
# --timeout 540 은 생략 불가 — 기본 CI_QUEUE_WAIT_TIMEOUT 이 7200s 라 wait 자신이
# 툴 600초 상한에 죽고, 워커는 다시 프로세스 고고학으로 돌아간다.
grep -qF -- '--timeout 540' references/worker-template.md \
  || { echo "  ✗ references/worker-template.md 에 wait --timeout 540 명시 없음"; exit 1; }
grep -qF -- '--timeout 540' references/worker-template.en.md \
  || { echo "  ✗ references/worker-template.en.md 에 wait --timeout 540 명시 없음"; exit 1; }
# 세 갈래(0/1 · 124 · 2)가 전부 문서에 있어야 한다 — 하나라도 빠지면 워커가 그 구간에서
# 다시 방법을 지어낸다(#185 가 고치려는 형상).
grep -qF -- '재큐 금지' references/worker-template.md \
  || { echo "  ✗ references/worker-template.md 에 '판정 있으면 재큐 금지' 지시 없음"; exit 1; }
grep -qF -- 'Do not re-queue' references/worker-template.en.md \
  || { echo "  ✗ references/worker-template.en.md 에 '판정 있으면 재큐 금지' 미러 없음"; exit 1; }
grep -qF -- '다음 툴콜에서 같은 `wait` 를 다시 걸어라' references/worker-template.md \
  || { echo "  ✗ references/worker-template.md 에 124 재진입 지시 없음"; exit 1; }
grep -qF -- 're-issue the same `wait` in your next tool call' references/worker-template.en.md \
  || { echo "  ✗ references/worker-template.en.md 에 124 재진입 미러 없음"; exit 1; }
# ps 회수 금지 — 대기 중인 티켓은 프로세스가 아니라서 ps 가 남의 CI 를 집는다.
# 되살아나면 겹침 금지 불릿과 정면으로 충돌한다(한 명령이 금지이자 필수가 된다).
if grep -nF -- "ps -Ao pid,command | grep '[b]in/ci'" references/worker-template.md references/worker-template.en.md; then
  echo "  ✗ 워커 템플릿에 ps 기반 CI 회수가 되살아남 — 회수는 ci-queue.sh wait 의 종료 코드로"
  exit 1
fi

echo "[worker-template] WIP 커밋 규율 문면 검사 (#187)"
# 커밋 트리거가 '완료된 단위' 하나뿐이면 TDD 사이클 중간에 죽은 워커는 커밋이 0이라
# push 할 것이 없고, 미커밋 작업이 worktree 에 갇혀 그 이슈가 정체한다(cleanup-worktree.sh
# 더티 가드가 제거를 보류 → 사람 개입). 아래 일곱 축이 한/영 양쪽에 살아 있어야 한다:
# 규율 제목 · 트리거 (a) · 트리거 (b) · `WIP:` 접두 · 초록 요건의 예외 · 처분 · 그 근거.
for tok in '**WIP 커밋 규율' \
           '긴 단계에 들어가기 전' \
           '마지막 커밋 이후 편집이 상당히 쌓였을 때' \
           'WIP: <한 줄>' \
           '초록 요건의 예외' \
           '최종 PR 에 그대로 남긴다' \
           'squash 머지'; do
  grep -qF -- "$tok" references/worker-template.md \
    || { echo "  ✗ references/worker-template.md 에 WIP 커밋 규율 문구 '$tok' 없음"; exit 1; }
done
for tok in '**WIP commit discipline' \
           'Before entering a long stage' \
           'significant edits have piled up since your last commit' \
           'WIP: <one line>' \
           'exception to the green requirement' \
           'left in the final PR as-is' \
           'squash merge'; do
  grep -qF -- "$tok" references/worker-template.en.md \
    || { echo "  ✗ references/worker-template.en.md 에 WIP 커밋 규율 문구 '$tok' 없음"; exit 1; }
done

echo "[loop-issues] 우선순위=에픽 단위 · 의존 정의 문면 검사 (#259)"
# 이 규약은 문서와 라벨 설명에만 산다(스크립트 로직 변경 없음) — 지워져도 아무 테스트가
# 안 깨지므로 아래 토큰이 유일한 방지선이다. `Epic #N` 줄 형식의 SSOT 는 문서가 아니라
# `scripts/loop-status.sh` 의 `epic_of`(`^[[:space:]]*epic[[:space:]]+#(?<n>[0-9]+)` —
# 줄 시작 앵커, 이슈당 첫 매치 하나, 대소문자 무시)이고 문서는 그것을 옮긴 것이다.
# 축: 에픽 줄 · P1 동시 상한 · 에픽 본체 무 P · 의존의 정의 · 깊이 상한 · 분해≠직렬화.
for tok in 'Epic #N' \
           '동시에 2개까지' \
           '에픽 본체에는 P 를 붙이지 않는다' \
           '컴파일·실행 시점' \
           '2 를 넘으면' \
           '의존 있는 조각'; do
  grep -qF -- "$tok" skills/loop-issues/SKILL.md \
    || { echo "  ✗ skills/loop-issues/SKILL.md 에 '$tok' 문구 없음"; exit 1; }
done
for tok in 'Epic #N' \
           'At most two' \
           'never gets a P' \
           'compile/run time' \
           'more than 2' \
           'pieces that actually depend'; do
  grep -qF -- "$tok" skills/loop-issues/SKILL.en.md \
    || { echo "  ✗ skills/loop-issues/SKILL.en.md 에 '$tok' 미러 없음"; exit 1; }
done
# 트리아지 FIXABLE 사유 — 규약을 어긴 이슈를 무엇으로 부를지가 빠지면 트리아지가 못 잡는다.
for tok in 'Epic #N` 누락' '에픽 내 P 혼재' '체인 깊이 초과'; do
  grep -qF -- "$tok" skills/loop-issues/SKILL.md \
    || { echo "  ✗ skills/loop-issues/SKILL.md 트리아지 FIXABLE 에 '$tok' 없음"; exit 1; }
done
for tok in 'missing `Epic #N`' 'mixed P inside' 'chain depth exceeded'; do
  grep -qF -- "$tok" skills/loop-issues/SKILL.en.md \
    || { echo "  ✗ skills/loop-issues/SKILL.en.md 트리아지 FIXABLE 에 '$tok' 미러 없음"; exit 1; }
done

echo "[setup-labels] P 라벨 설명은 에픽 단위 정의 (#259)"
# 옛 설명("최우선/보통/낮음")으로 되돌아가면 라벨 목록만 보는 사람이 leaf 마다 임의로
# 매기던 상태로 복귀한다 — 그게 이 이슈의 원인이었다. 설명 문자열만 보며 색·구조는 안 본다.
grep -qE '"P0".*--description "장애·차단"' scripts/setup-labels.sh \
  || { echo "  ✗ scripts/setup-labels.sh: P0 설명이 '장애·차단' 이 아님"; exit 1; }
# P1 은 설명이 길어 다음 줄로 이어지므로 라벨 줄 + 뒤 2줄 구간에서 찾는다.
grep -A2 -E '"P1"' scripts/setup-labels.sh | grep -qF '에픽 P 상속' \
  || { echo "  ✗ scripts/setup-labels.sh: P1 설명에 '에픽 P 상속' 없음"; exit 1; }
grep -qE '"P2".*--description "기본"' scripts/setup-labels.sh \
  || { echo "  ✗ scripts/setup-labels.sh: P2 설명이 '기본' 이 아님"; exit 1; }

echo "[README] 라벨 표 — P 행 에픽 단위 정의 + Epic #N 행 (한/영)"
# 표 행만 집도록 **줄머리 파이프**로 앵커한다 — 두 README 본문 산문(loop-status 절)에도
# 'Epic #N' 이 이미 있어서, 앵커 없이 grep 하면 이 가드가 수정 전에도 참이 되어 자기가
# 막으려던 회귀를 못 잡는다(백틱은 셸 전개를 피하려 정규식 '.' 로 둔다).
for f in README.ko.md README.md; do
  grep -qE '^\|[[:space:]]*.Epic #N.[[:space:]]*\|' "$f" \
    || { echo "  ✗ $f 라벨 표에 Epic #N 행 없음 (줄머리 표 행이어야 한다)"; exit 1; }
done
grep -E '^\|[[:space:]]*.P0. / .P1. / .P2.' README.ko.md | grep -qF '에픽' \
  || { echo "  ✗ README.ko.md 라벨 표 P 행에 에픽 단위 정의 없음"; exit 1; }
grep -E '^\|[[:space:]]*.P0. / .P1. / .P2.' README.md | grep -qF 'epic' \
  || { echo "  ✗ README.md 라벨 표 P 행에 에픽 단위 정의 없음"; exit 1; }

echo "CI pass"
