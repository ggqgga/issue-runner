#!/usr/bin/env bash
# 로컬 CI 러너 — hooks/local-ci.sh 계약 (GitHub Actions 미사용. 설치는 README §설치 4단계).
# 검사는 한 줄도 여기 두지 않는다: 단계는 `ci/steps/NN-<이름>.sh`, 공유 헬퍼는 `ci/lib.sh`,
# 흩어져 있던 문서 형태 가드는 `ci/guards/*.sh`(단계 30 이 부른다).
# 구조와 **가드 은퇴 원칙**은 ci/README.md — 새 `#NNN` 가드는 만료 조건 없이는 넣지 않는다.
set -euo pipefail
cd "$(dirname "$0")/.."

# 이름순 실행. nullglob 은 켜지 않는다 — ci/steps 가 비면 리터럴 패턴을 실행하려다
# 죽는 편이 "검사 0건인데 초록" 보다 낫다(fail-closed).
for step in ci/steps/[0-9][0-9]-*.sh; do
  bash "$step"   # set -e — 첫 비0 에서 그 자리 정지, 종료 코드를 그대로 물려준다
done
