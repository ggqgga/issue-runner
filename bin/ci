[ "$rc" = 0 ] && [ -z "$out" ] || { echo "  ✗ reconcile 빈: rc=$rc out='$out'"; exit 1; }
rm -rf "$tmp"

echo "[closeout] reconcile harvesting PR 분류 스모크 (#44)"
# OPEN PR 에 harvesting 라벨이 있으면 pr_open 이 아니라 harvesting 이벤트로 분류돼야
# 한다 (② Maintain 이 closeout 점유 PR 을 건드리지 않도록). OPEN 경로는 worktree
# 디렉토리를 만지지 않으므로 gh 세 형태만 스텁한다.
tmp=$(mktemp -d); mkdir "$tmp/stub"
cat > "$tmp/stub/gh" <<'EOF'
#!/bin/sh
case "$*" in
  *"api user"*) echo "tester" ;;
  *"search issues"*) echo '[{"repository":{"nameWithOwner":"o/r"},"number":44}]' ;;
  *"pr list"*) echo '[{"number":99,"state":"OPEN","statusCheckRollup":[],"labels":[{"name":"harvesting"}]}]' ;;
  *) echo '' ;;
esac
EOF
chmod +x "$tmp/stub/gh"
out=$(PATH="$tmp/stub:$PATH" ISSUE_RUNNER_PROJECTS_ROOT="$tmp" bash scripts/reconcile.sh 2>/dev/null)
ev=$(printf '%s' "$out" | jq -r 'select(.number==44) | .event' 2>/dev/null | head -1)
[ "$ev" = "harvesting" ] || { echo "  ✗ harvesting PR 분류 실패: event='$ev' (기대 harvesting)"; exit 1; }
rm -rf "$tmp"

echo "[closeout] references placeholder 검사"
# macOS 기본 bash 3.2 는 declare -A 미지원 — case 분기로 파일별 placeholder 매핑.
for f in skills/closeout/references/verifier-prompt.md \
         skills/closeout/references/verifier-prompt-fallback.md \
         skills/closeout/references/deploy-check-issue.md \
         skills/closeout/references/spinoff-issue.md; do
  [ -f "$f" ] || { echo "  ✗ 누락: $f"; exit 1; }
  case "$f" in
    # <ISSUE_BODY>: 검증자가 sandbox 네트워크 없이 이슈 수용 기준을 판정하도록 메인
    # 세션이 이슈 본문을 동봉하는 지점 — 지우면 원문 fetch 회귀(#54). diff 는 동봉하지
    # 않는다 — #134 내장 리뷰어가 `--base` 범위를 이 프롬프트 지시로 워크트리에서
    # 직접 읽는다(#207: 동봉 전제 문구와 SKILL 의 "동봉 안 함" 이 정면 충돌해 fail-open).
    *verifier-prompt-fallback.md)
      # 폴백(general-purpose)은 Agent 툴에 --cd 대응 인자가 없어 워크트리에 스코프
      # 안 된다 — 그래서 네이티브 템플릿과 달리 <DIFF> 를 실제로 동봉해야 한다(#207
      # attempt8). <BASE> 는 없다 — 폴백은 --base 를 넘기지 않고 동봉 diff 로만 판정한다.
      phs="<PR> <REPO> <PLAN_REF> <ISSUE_BODY> <DIFF>" ;;
    *verifier-prompt.md)    phs="<PR> <REPO> <BASE> <PLAN_REF> <ISSUE_BODY>" ;;
    *deploy-check-issue.md) phs="<PR> <SHA> <SUMMARY> <DEPLOY_CMD> <LIVE_CHECKS> <VERIFY_URL>" ;;
    # <EPIC_LINE>: 파생이 부모의 에픽을 본문 **첫 줄**(`Epic #N`)로 물려받는 자리 (#261).
    # 지우면 파생이 에픽 밖 고아가 되고 loop-status 에픽 절의 leaf 집계에서 사라진다.
    *spinoff-issue.md)      phs="<EPIC_LINE> <BACKGROUND> <REASON> <PLAN> <TEST_PLAN> <RELATED>" ;;
  esac
  # shellcheck disable=SC2086
  for ph in $phs; do
    grep -qF "$ph" "$f" || { echo "  ✗ $f 에 $ph 없음"; exit 1; }
  done
done
# 네이티브↔폴백 파일 간 전제 교차오염 방지 검사는 아래 "③-1 네이티브↔폴백 프롬프트
# 동기화 검사"(#207 attempt8) 에서 한다.

echo "[#261] spinoff-inherit 헬퍼 — 실행비트·Epic 정규식 SSOT 동기화·격자 테스트"
# closeout 6단계가 `$SCRIPTS/spinoff-inherit.sh` 로 직접 exec 하므로 실행 비트를 여기서 문다.
# 비트가 빠지면 조용히 exit 126 → `eval` 이 빈 문자열을 먹어 `$priority` 가 **빈 값**이 되고,
# `gh issue create --label ""` 로 발행이 통째로 실패하거나 무라벨 이슈가 남는다(PR#173 말미의
# "새 헬퍼는 실행 비트가 빠지면 값이 항상 빈 값이 되어 조용히 degrade" 와 같은 함정).
[ -x scripts/spinoff-inherit.sh ] || { echo "  ✗ spinoff-inherit.sh 실행 비트 없음"; exit 1; }
# `<EPIC_LINE>` 은 머리 주석의 *설명*이 아니라 본문 **첫 줄 자리**여야 한다 — HTML 주석이
# 끝난 뒤 첫 비지 않은 줄이 정확히 `<EPIC_LINE>` 이어야, 채워진 본문의 첫 줄이 `Epic #N` 이
# 되고 6단계 '발행 직후 확인' 의 "첫 줄이 Epic #N 인가" 가 참이 될 수 있다. 위 placeholder
# 검사는 **파일 어딘가**에 문자열이 있으면 통과하므로, 슬롯이 지워지고 주석 언급만 남은
# 회귀를 못 본다(실측으로 확인한 사각지대 — 그래서 이 줄 앵커 검사가 따로 필요하다).
tpl_slot=$(sed -n '/-->/,$p' skills/closeout/references/spinoff-issue.md \
  | sed '1s/.*-->//' | grep -v '^[[:space:]]*$' | head -1)
[ "$tpl_slot" = '<EPIC_LINE>' ] \
  || { echo "  ✗ spinoff-issue.md: 머리 주석 뒤 첫 줄이 <EPIC_LINE> 슬롯이 아니다 (실제=[$tpl_slot])"; exit 1; }
# `Epic #N` **전용 줄** 정규식의 SSOT 는 `loop-status.sh` 의 `epic_of`(#260) 다. 파생의 에픽
# 판정(spinoff-inherit)과 에픽 절의 leaf 판정(loop-status)이 갈라지면 두 경로가 서로 다른
# 세계를 재게 된다 — #216 교훈("같은 X 를 쓴다"는 단언은 갈래마다 실제로 참인지 확인하라).
# 두 파일에 **문자 그대로 같은 문자열**이 있는지 문다(한쪽만 고치면 여기서 빨개진다).
epic_re_ssot='^[[:space:]]*epic[[:space:]]+#(?<n>[0-9]+)'
for f in scripts/loop-status.sh scripts/spinoff-inherit.sh; do
  grep -qF -- "$epic_re_ssot" "$f" \
    || { echo "  ✗ $f 에 Epic 전용 줄 정규식 SSOT 없음(두 판정이 갈라졌다): $epic_re_ssot"; exit 1; }
done
bash scripts/tests/spinoff-inherit.test.sh

echo "[#261] closeout 6단계 발행 명령이 spinoff-inherit 에 묶여 있는지 검사 (한/영)"
# 산문 "epic 이 있으면 sub-issue 로 연결" 은 샜다 — 명령이 있는 단계는 안 새고 산문뿐인
# 단계가 샌다(실증 2026-08-13: 6단계가 규약 라벨만 달고 agent-ready 를 빠뜨려 17건이 루프
# 밖에 남음). 그래서 상속을 명령 블록에 박고 여기서 그 블록의 구성 요소를 전수로 문다.
# 스코프는 6단계 헤더 ~ `## ⑤ Drain` 헤더 사이로 좁힌다(#223 규율 — "파일 어딘가"면 블록이
# 다른 절로 밀려도 초록이라 가드가 무의미해진다). 헤더는 번역되므로 볼드 접두로 앵커한다.
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  case "$f" in
    *.en.md) s6_anchor='^\*\*Step 6 —' ;;
    *)       s6_anchor='^\*\*6단계 —' ;;
  esac
  s6_line=$(grep -nE "$s6_anchor" "$f" | head -1 | cut -d: -f1)
  drain_line=$(grep -n '^## ⑤ Drain' "$f" | head -1 | cut -d: -f1)
  [ -n "$s6_line" ]    || { echo "  ✗ $f: 6단계 헤더 앵커 없음"; exit 1; }
  [ -n "$drain_line" ] || { echo "  ✗ $f: ⑤ Drain 헤더 앵커 없음"; exit 1; }
  seg=$(sed -n "${s6_line},${drain_line}p" "$f")
  # 발행 명령이 가져야 할 것 — ⑴ 헬퍼 eval ⑵ `--label agent-ready`(기존 계열 가드 유지)
  # ⑶ 세 라벨이 **한 줄 통째로**. ⑶ 을 토큰별로 따로 세지 않는 이유: 6단계 산문 어딘가에
  # 같은 토큰이 있는 것만으로 통과한다(ko 에는 "우선순위(`--label \"\$priority\"`)도 생략
  # 불가" 문장이 실제로 있다) — 그러면 명령 블록에서 라벨이 빠진 회귀를 못 본다. 한 줄
  # 통째로 물면 `--label "$priority"` 만 지우는 뮤테이션에서 한/영 각각 EXIT=1 이다(실측).
  for tok in 'eval "$($SCRIPTS/spinoff-inherit.sh' \
             '--label agent-ready' \
             '--label agent-ready --label spinoff --label "$priority"'; do
    printf '%s\n' "$seg" | grep -qF -- "$tok" \
      || { echo "  ✗ $f: 6단계 구간의 발행 명령에 '$tok' 없음"; exit 1; }
  done
  # `<EPIC_LINE>` 은 **두 번** 나와야 한다 — ⑴ 본문 채우기 지시 ⑵ '발행 직후 확인' 의
  # Epic 줄 존재 확인. 확인 쪽 문구가 되돌아가 1회로 줄면 여기서 빨개진다(#243 2회차와
  # 같은 회수 가드 — 라벨만 확인하고 Epic 줄을 안 보면 고아가 조용히 쌓인다).
  el_count=$(printf '%s\n' "$seg" | grep -c -- '<EPIC_LINE>')
  [ "$el_count" -ge 2 ] \
    || { echo "  ✗ $f: 6단계 구간의 <EPIC_LINE> 등장 ${el_count}회 (기대 2회 이상 — 채우기 + 발행 직후 확인)"; exit 1; }
  # 마커 꼴은 6단계 PR 코멘트와 ④ Report 가 **같아야** 한다 — 파일 전체에서 2회 이상.
  mk_count=$(grep -c -F -- '(Epic #<N|없음> · <P>)' "$f")
  [ "$mk_count" -ge 2 ] \
    || { echo "  ✗ $f: 파생 마커 꼴 '(Epic #<N|없음> · <P>)' 등장 ${mk_count}회 (기대 2회 이상 — 6단계 PR 코멘트 + ④ Report)"; exit 1; }
  # 양방향 가드 — 손으로 P 를 고르던 옛 형태가 **파일 어디에도** 되살아나면 안 된다.
  # 3단계의 "6단계 발행 명령 형태를 그대로 쓴다" 교차참조가 옛 꼴을 인용한 채 남아
  # 두 절이 서로 다른 명령을 가르치는 형상을 실제로 이 PR 에서 발견했다(#191·#298 가족).
  if grep -nF -- '--label spinoff --label <P1|P2>' "$f"; then
    echo "  ✗ $f: 손으로 고르는 옛 꼴 '--label <P1|P2>' 가 되살아남 — spinoff-inherit 의 \"\$priority\" 를 써라"
    exit 1
  fi
done

echo "[closeout] ③-1 1단계 worktree 확보 fetch·reset 검사 (#207)"
# 1단계 계획 부합 호출의 프롬프트(verifier-prompt.md)가 "이 워크트리는 PR 브랜치의
# HEAD 로 체크아웃돼 있어 최신이다" 라고 전제한다 — 그 전제가 참이려면 1단계
# 자신이 worktree 를 fetch·reset 해야 한다(revalidate 절이 이미 같은 이유로 이
# 두 명령을 건다 — #207 은 1단계에 이 형제가 빠져 있었다는 결함). 언어 불변 앵커
# (1단계/Step 1 문단 ~ 2단계/Step 2 문단 시작 전)로 1단계 문단만 잘라 그 안에
# 두 명령이 다 있는지 본다 — 다른 절(revalidate 등)의 fetch·reset 을 오검출하지
# 않기 위해서다.
check_step1_worktree_sync() {
  f="$1"; start_pat="$2"; end_pat="$3"
  start_ln=$(grep -nE "$start_pat" "$f" | head -1 | cut -d: -f1)
  end_ln=$(grep -nE "$end_pat" "$f" | head -1 | cut -d: -f1)
  if [ -z "$start_ln" ] || [ -z "$end_ln" ]; then
    echo "  ✗ $f 에 1단계/2단계 앵커 없음"; return 1
  fi
  section=$(sed -n "${start_ln},$((end_ln - 1))p" "$f")
  if ! printf '%s\n' "$section" | grep -qF 'fetch origin'; then
    echo "  ✗ $f 1단계 절에 'fetch origin' 없음 — worktree 가 옛 HEAD 일 수 있다(#207)"; return 1
  fi
  if ! printf '%s\n' "$section" | grep -qE 'reset --hard origin/agent/issue'; then
    echo "  ✗ $f 1단계 절에 'reset --hard origin/agent/issue-<N>' 없음(#207)"; return 1
  fi
  return 0
}
fail=0
check_step1_worktree_sync skills/closeout/SKILL.md    '^\*\*1단계 —' '^\*\*2단계 —' || fail=1
check_step1_worktree_sync skills/closeout/SKILL.en.md '^\*\*Step 1 —' '^\*\*Step 2 —' || fail=1
[ "$fail" = 0 ] || exit 1

echo "[closeout] ③-1 네이티브↔폴백 프롬프트 동기화 검사 (#207 attempt8)"
# 이 이슈의 뿌리는 SKILL.md 가 폴백(general-purpose)이 diff 를 동봉한다고 적어놓고
# 실제로는 네이티브 전용 템플릿(<DIFF> 없음·"이 워크트리는 최신" 전제)을 그대로
# 재사용해 그 주장이 거짓이었던 것이다. 한쪽만 고쳐도(문서가 새 파일명을 안 부르거나,
# 새 파일이 실제로 diff 를 안 담으면) 여기서 빨개져야 한다.
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  grep -qF 'verifier-prompt-fallback.md' "$f" \
    || { echo "  ✗ $f 이 폴백 전용 템플릿(verifier-prompt-fallback.md)을 이름으로 지목하지 않는다 — 네이티브 템플릿과 같은 파일을 쓴다고 오독될 수 있다(#207)"; exit 1; }
done
[ -f skills/closeout/references/verifier-prompt-fallback.md ] \
  || { echo "  ✗ skills/closeout/references/verifier-prompt-fallback.md 없음"; exit 1; }
grep -qF '<DIFF>' skills/closeout/references/verifier-prompt-fallback.md \
  || { echo "  ✗ verifier-prompt-fallback.md 에 <DIFF> placeholder 없음 — 폴백은 --cd 로 스코프되지 않아 diff 를 실제로 동봉해야 한다(#207)"; exit 1; }
grep -qF '<DIFF>' skills/closeout/references/verifier-prompt.md \
  && { echo "  ✗ verifier-prompt.md(네이티브)에 <DIFF> 가 있음 — 동봉 전제는 verifier-prompt-fallback.md 전용이어야 한다(#207 원 결함 재발)"; exit 1; }
grep -qF '이 워크트리는' skills/closeout/references/verifier-prompt-fallback.md \
  && { echo "  ✗ verifier-prompt-fallback.md 에 네이티브 전용 워크트리 전제 문구가 있음 — general-purpose 는 --cd 로 스코프되지 않아 거짓이다(#207)"; exit 1; }

echo "[closeout] ③-1 응답 계약(구조 줄) 단일 정의 검사 (#207)"
# 이 이슈의 뿌리는 SKILL 과 템플릿이 같은 계약을 서로 다르게 적은 것이었다. 응답 계약의
# 형식 문자열도 두 자리에 적히면 같은 방식으로 갈라진다(프롬프트가 요구하는 형식 ≠ 파서가
# 읽는 형식 = fail-open 재발). 그래서 형식은 codex-review-gate.sh 의 STATUS_* 상수 **한 자리**
# 에서만 정의하고, 계약문·파서는 그 상수를 참조해야 하며, 문서·템플릿은 리터럴을 적지 않는다.
gate=scripts/codex-review-gate.sh
for v in STATUS_KEY STATUS_REVIEWED STATUS_NO_BASIS; do
  if ! grep -qE "^$v=" "$gate"; then
    echo "  ✗ $gate 에 $v 정의 없음 — 응답 계약 형식의 단일 정의 자리"; exit 1
  fi
done
key=$(sed -n "s/^STATUS_KEY='\\(.*\\)'\$/\\1/p" "$gate")
[ -n "$key" ] || { echo "  ✗ $gate 의 STATUS_KEY 값을 못 읽었다"; exit 1; }
n=$(grep -c "$key" "$gate")
if [ "$n" != 1 ]; then
  echo "  ✗ $gate 에 계약 키('$key') 리터럴이 ${n}곳 — 정의 1곳만 허용(나머지는 \$STATUS_KEY 참조)"; exit 1
fi
# 프롬프트가 요구하는 형식 · 파서가 읽는 형식이 둘 다 그 상수에서 만들어지는가
if ! grep -q '\${STATUS_KEY}: \${STATUS_REVIEWED}' "$gate" || ! grep -q '\${STATUS_KEY}: \${STATUS_NO_BASIS}' "$gate"; then
  echo "  ✗ $gate 의 프롬프트 계약문이 STATUS_* 상수로 만들어지지 않았다"; exit 1
fi
if ! grep -qF 'contract_re="^${STATUS_KEY}:[[:space:]]+(${STATUS_REVIEWED}|${STATUS_NO_BASIS})$"' "$gate"; then
  echo "  ✗ $gate 의 판정 파서가 STATUS_* 상수로 만들어지지 않았거나 줄 전체(^…\$) 앵커가 아니다 — 같은 줄 선행 텍스트를 받으면 '못 봤다'가 CLEAN 으로 샌다(#283)"; exit 1
fi
# 같은 줄 선행 텍스트를 어형으로 가르려던 옛 허용 목록이 되살아나면 빨강 — 그 창이 두 회차
# 연속 fail-open 을 냈다(부정문 인라인 → CLEAN). 판정은 앵커 하나로만 선다.
if grep -qE '^ *(PREFIX_SENTENCE_RE|PREFIX_MARKER_RE)=' "$gate"; then
  echo "  ✗ $gate 에 계약 줄 접두 허용 목록이 되살아났다 — 값 앞 같은 줄 텍스트는 어형 불문 거절이다(#283 재심 ①)"; exit 1
fi
# 렌더 경계는 CLI 저작의 증거 한 술어로만 선다(ⓐ 형식 ⓑ 접미 ⓒ 유일). 술어가 사라지거나
# 유일성 검사가 빠지면 모델이 지어낸 헤더+불릿이 다시 경계로 읽힌다(#283 재심 ②).
grep -qF 'function cli_rendered(' "$gate" \
  || { echo "  ✗ $gate 에 cli_rendered() 술어가 없다 — 무엇이 CLI 렌더인가의 단일 정의 자리(#283)"; exit 1; }
grep -qF 'if (qual != 1) { cut = 0; tail = NR }' "$gate" \
  || { echo "  ✗ $gate 의 경계 판정에 자격 헤더 유일성(ⓒ) 검사가 없다 — 자격 헤더가 둘 이상이면 모호이므로 자르지 않아야 한다(#283)"; exit 1; }
# 판정 창의 경계(#283) — codex 가 렌더하는 발견 섹션 헤더도 형식 문자열이다. 여기도 정의 1곳으로
# 묶고 파서가 그 상수를 실제로 참조하는지 문다: 헤더 리터럴이 awk 안에 따로 적히면 codex 가
# 헤더 문구를 바꿨을 때 한쪽만 고쳐져 게이트가 조용히 옛 동작(발견 있는 리뷰 전부 미산출)으로 돈다.
# **값까지** 문다 — 빈 값(`RENDER_HEADER_ONE=''`)이면 awk 의 `s == h1` 이 첫 빈 줄에 걸려 구역이
# 총평 첫 문단에서 잘린다(방향은 fail-closed 지만 게이트가 조용히 쓸모없어진다).
for v in RENDER_HEADER_ONE RENDER_HEADER_MANY; do
  grep -qE "^$v='[^']+'\$" "$gate" || { echo "  ✗ $gate 의 $v 가 없거나 값이 비었다 — 판정 창 경계의 단일 정의 자리(#283)"; exit 1; }
done
grep -qF 'awk -v h1="$RENDER_HEADER_ONE" -v hn="$RENDER_HEADER_MANY"' "$gate" \
  || { echo "  ✗ $gate 의 판정 창이 RENDER_HEADER_* 상수를 참조하지 않는다 — 헤더 리터럴이 두 자리로 갈라진다(#283)"; exit 1; }
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md skills/closeout/references/verifier-prompt.md \
         skills/closeout/references/verifier-prompt-fallback.md; do
  if grep -q "$key" "$f"; then
    echo "  ✗ $f 에 계약 형식('$key')이 하드코딩됨 — 정의 자리는 $gate 뿐(#207)"; exit 1
  fi
done

echo "[closeout] smoke-prompt 한/영 placeholder 검사 (#69)"
# 5단계 Chrome 스모크 동봉형 프롬프트(verifier-prompt.md 미러) — 한/영 양쪽이
# 존재하고 두 placeholder 를 다 담아야 한다. <VERIFY_URL>=production 베이스 URL,
# <LIVE_CHECKS>=배포 이슈 본문의 검증 항목 — 5단계가 런타임에 치환하는 계약.
# 지우면 동봉형 프롬프트가 깨져 스모크가 빈 컨텍스트로 도는 회귀.
for f in skills/closeout/references/smoke-prompt.md \
         skills/closeout/references/smoke-prompt.en.md; do
  [ -f "$f" ] || { echo "  ✗ 누락: $f"; exit 1; }
  for ph in '<VERIFY_URL>' '<LIVE_CHECKS>'; do
    grep -qF "$ph" "$f" || { echo "  ✗ $f 에 $ph 없음"; exit 1; }
  done
done

echo "[closeout] SKILL 5단계 Chrome 스모크(smoke-prompt) 문서화 검사 (#69)"
# closeout ③ 5단계가 chrome-devtools MCP 로 검증 URL 에 스모크를 돌리고, MCP 부재/
# URL 도달불가 시 사람-보고 경로로 폴백하며 skip 코멘트를 남긴다는 지시가 한/영
# 양쪽에 있어야 한다. smoke-prompt 는 동봉형 프롬프트 파일명(언어 불변 토큰)이라
# 한 가드로 양 파일을 덮는다. 단어만 남고 저하(degrade) 지시가 빠지는 회귀를 막기
# 위해, smoke-prompt 를 담은 단락(빈 줄 구분)에 chrome-devtools 와 <VERIFY_URL> 이
# 함께 있는지 awk 로 확인한다(#70 패턴). 지우면 5단계가 수동 대기로 되돌아가는 회귀.
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  grep -qF 'smoke-prompt' "$f" || { echo "  ✗ $f 에 5단계 Chrome 스모크(smoke-prompt) 지시 없음"; exit 1; }
  awk 'BEGIN{RS="";ok=0} /smoke-prompt/ && /chrome-devtools/ && /<VERIFY_URL>/ {ok=1} END{exit ok?0:1}' "$f" \
    || { echo "  ✗ $f 의 smoke-prompt 단락에 chrome-devtools·<VERIFY_URL> 구동 지시 없음"; exit 1; }
done

echo "[closeout] 4단계 발행 명령이 코드펜스 안에서 deploy-wait 만 갖는지 검사 (#214 · #243)"
# 이슈 #214: 4단계 발행 명령이 산문 문단 한가운데 인라인으로 있어 실행자가 라벨을
# 조용히 빠뜨렸다(배포 티켓 8/8 누락 실측). 6단계처럼 코드펜스 블록으로 떼어내고, 그 블록
# 안에 라벨이 있는지 여기서 문다 — 다음에 또 산문으로 되돌리면 이 검사가 빨개진다.
# #243(플랜 2단계): 그 블록은 이제 `--label deploy-wait` **만** 가져야 한다. `needs-human` 은
# 배포 대기 이슈에서 하는 일이 없어(디스패치 게이트는 agent-ready 를 요구 · loop-status
# 버킷은 deploy-wait 가 이김 · deploy-bodat 수집은 제목 정규식) 뜻만 흐렸다 — 되살아나면
# 여기서 빨개진다(양방향 가드: 없어도 빨강, 다시 생겨도 빨강).
# 스코프를 4단계~**5단계** 헤더 사이로 좁힌다(사전 리뷰 WARN + #223) — "파일 어딘가"만 보면, 이
# 코드펜스가 다른 절(예시·anti-pattern 설명)로 옮겨져도 통과해 버려 가드가 무의미해진다. 상한이
# 6단계면 5단계가 통째로 구간에 들어가 코드펜스를 5단계로 옮겨도 초록이므로 5단계 헤더로 내린다.
# 헤더는 언어별로 번역되므로 볼드 접두 앵커(`**4단계 —`/`**Step 4 —`)로 정확히 그 줄만 집는다.
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  case "$f" in
    *.en.md) s4_anchor='^\*\*Step 4 —'; s5_anchor='^\*\*Step 5 —' ;;
    *)       s4_anchor='^\*\*4단계 —';   s5_anchor='^\*\*5단계 —' ;;
  esac
  s4_line=$(grep -nE "$s4_anchor" "$f" | head -1 | cut -d: -f1)
  s5_line=$(grep -nE "$s5_anchor" "$f" | head -1 | cut -d: -f1)
  [ -n "$s4_line" ] || { echo "  ✗ $f: 4단계 헤더 앵커 없음"; exit 1; }
  [ -n "$s5_line" ] || { echo "  ✗ $f: 5단계 헤더 앵커 없음"; exit 1; }
  in_block=0
  block=""
  found=0
  nh=0
  lineno=0
  block_start=0
  while IFS= read -r line; do
    lineno=$((lineno + 1))
    # 코드펜스 줄은 들여쓰기(bullet 하위 2칸)를 달고 있을 수 있어 앞 공백을 뗀 뒤 비교한다.
    trimmed="${line#"${line%%[! ]*}"}"
    if [ "$trimmed" = '```' ]; then
      if [ "$in_block" = 1 ]; then
        if [ "$block_start" -gt "$s4_line" ] && [ "$lineno" -lt "$s5_line" ]; then
          case "$block" in
            *"gh issue create"*"--label deploy-wait"*)
              found=1
              case "$block" in
                *"--label needs-human"*) nh=1 ;;
              esac ;;
          esac
        fi
        in_block=0
        block=""
      else
        in_block=1
        block_start=$lineno
      fi
      continue
    fi
    if [ "$in_block" = 1 ]; then
      block="$block$line
"
    fi
  done < "$f"
  [ "$found" = 1 ] \
    || { echo "  ✗ $f: 4단계~5단계 헤더 사이 코드펜스 안에 --label deploy-wait 형태로 없음"; exit 1; }
  [ "$nh" = 0 ] \
    || { echo "  ✗ $f: 4단계 발행 명령에 --label needs-human 이 있다 (#243 — deploy-wait 만 남긴다)"; exit 1; }
done

echo "[closeout] 4단계 라벨 부재 폴백의 복구 지시에 deploy-wait 부착 단계가 있는지 검사 (#243 2회차)"
# 검증자 지적(PR #272 2회차): 라벨 부착이 양쪽 다 실패했을 때의 폴백 복구 지시가
# `setup-labels.sh <repo>` 재실행만 요구했다. 그 스크립트는 라벨 *정의* 만 만들 뿐 기존
# 이슈에 부착하지 않으므로, 사람이 시킨 대로 해도 그 티켓은 계속 무라벨이라 deploy-cycle
# 이 레인 표식으로 못 찾는다 — "사람이 조치해도 안 풀리는" BLOCKED 였다. 복구 지시는
# `gh issue edit <번호> --repo <repo> --add-label deploy-wait` 부착 단계까지 포함해야 한다.
# "발행 직후 확인" 불릿에 이미 같은 명령이 1회 있으므로(그건 정상 경로 확인용), 폴백
# 복구 지시에도 등장해 4단계~**5단계** 구간 전체 등장 횟수가 최소 2회여야 한다 — 폴백 쪽
# 문구가 되돌아가 1회로 줄면 여기서 빨개진다. 상한은 #223 으로 6단계 → 5단계로 내렸다
# (두 등장이 모두 4단계 안이라 좁혀도 2회가 유지된다 — 한/영 각각 실측).
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  case "$f" in
    *.en.md) s4_anchor='^\*\*Step 4 —'; s5_anchor='^\*\*Step 5 —' ;;
    *)       s4_anchor='^\*\*4단계 —';   s5_anchor='^\*\*5단계 —' ;;
  esac
  s4_line=$(grep -nE "$s4_anchor" "$f" | head -1 | cut -d: -f1)
  s5_line=$(grep -nE "$s5_anchor" "$f" | head -1 | cut -d: -f1)
  [ -n "$s4_line" ] || { echo "  ✗ $f: 4단계 헤더 앵커 없음"; exit 1; }
  [ -n "$s5_line" ] || { echo "  ✗ $f: 5단계 헤더 앵커 없음"; exit 1; }
  count=$(sed -n "${s4_line},${s5_line}p" "$f" | grep -c -- '--add-label deploy-wait')
  [ "$count" -ge 2 ] \
    || { echo "  ✗ $f: 4단계 구간의 --add-label deploy-wait 등장이 ${count}회뿐 — 라벨 부재 폴백의 복구 지시에도 부착 단계가 있어야 한다 (#243)"; exit 1; }
done

echo "[closeout] ci-gate --repo 분기 스모크 (positive + fail-closed)"
# flag_repo 가 있으면 게이트가 cwd 가 아니라 그 레포 기준으로 SHA·캐시를 잡아야 한다 (#47).
gate="$PWD/hooks/ci-gate-before-pr-merge.sh"
tmp=$(mktemp -d)
mkdir -p "$tmp/stub" "$tmp/proj/r/bin" "$tmp/home"
printf '#!/bin/sh\nexit 0\n' > "$tmp/proj/r/bin/ci"   # 가짜 레포 체크아웃(로컬 CI 옵트인)
chmod +x "$tmp/proj/r/bin/ci"
cat > "$tmp/stub/gh" <<'STUB'
#!/bin/sh
case "$*" in
  *"pr view"*headRefOid*) echo '{"headRefOid":"deadbeef00"}' ;;
  *) echo '' ;;
esac
STUB
chmod +x "$tmp/stub/gh"
# 게이트는 repo-dir.sh 가 pwd -P 로 정규화한 경로(/private/var…)로 slug 를 잡는다 →
# 캐시 경로도 같은 정규화 경로로 맞춰야 매칭된다 (macOS /tmp→/private 심링크 주의).
realroot=$(cd "$tmp/proj/r" && pwd -P)
slug=$(printf '%s' "$realroot" | sed 's#[/ ]#_#g; s#^_##')
mkdir -p "$tmp/home/.claude/.local-ci/$slug"
run_gate() {
  printf '{"tool_input":{"command":"gh pr merge 5 --repo o/r --squash"}}' \
    | HOME="$tmp/home" ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" PATH="$tmp/stub:$PATH" \
      bash "$gate" >/dev/null 2>&1
}
echo pass > "$tmp/home/.claude/.local-ci/$slug/deadbeef00.result"
rc=0; run_gate || rc=$?
[ "$rc" = 0 ] || { echo "  ✗ --repo positive(캐시 pass): exit $rc (기대 0 — 게이트가 o/r 를 안 봄)"; rm -rf "$tmp"; exit 1; }
rm -f "$tmp/home/.claude/.local-ci/$slug/deadbeef00.result"
rc=0; run_gate || rc=$?
[ "$rc" = 2 ] || { echo "  ✗ --repo fail-closed(캐시 없음): exit $rc (기대 2)"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[gate] ci-gate rollup 폴백 스모크 (SUCCESS-only allowlist, #60)"
# 로컬 bin/ci 없는 레포 → 게이트가 GitHub statusCheckRollup 으로 판정.
# closeout-ci-pass 스모크와 대칭: 전부 SUCCESS→통과(exit 0), 그 외 종결값은
# allowlist 가 전부 차단(exit 2). denylist 면 STARTUP_FAILURE·미열거 conclusion 이
# 새어 비통과 PR 이 머지로 흘러간다.
gate="$PWD/hooks/ci-gate-before-pr-merge.sh"
tmp=$(mktemp -d); mkdir -p "$tmp/stub" "$tmp/proj/r"  # r/bin/ci 일부러 안 만든다(폴백 강제)
run_gate_rollup() {  # $1=rollup JSON 배열 → gh stub 이 statusCheckRollup 으로 반환
  cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"pr view"*statusCheckRollup*) echo '{"statusCheckRollup":$1}' ;;
  *"pr view"*number*) echo '{"number":5}' ;;
  *) echo '' ;;
esac
STUB
  chmod +x "$tmp/stub/gh"
  printf '{"tool_input":{"command":"gh pr merge 5 --repo o/r --squash"}}' \
    | ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" PATH="$tmp/stub:$PATH" \
      bash "$gate" >/dev/null 2>&1
}
# 전부 SUCCESS (check-run conclusion + 레거시 commit-status state 혼합) → 통과 보존(exit 0)
rc=0; run_gate_rollup '[{"status":"COMPLETED","conclusion":"SUCCESS"},{"state":"SUCCESS"}]' || rc=$?
[ "$rc" = 0 ] || { echo "  ✗ ci-gate rollup: 전부 SUCCESS → exit $rc (기대 0)"; rm -rf "$tmp"; exit 1; }
# denylist 회귀: FAILURE/CANCELLED/TIMED_OUT 여전히 차단(exit 2)
for c in FAILURE CANCELLED TIMED_OUT; do
  rc=0; run_gate_rollup "[{\"status\":\"COMPLETED\",\"conclusion\":\"$c\"}]" || rc=$?
  [ "$rc" = 2 ] || { echo "  ✗ ci-gate rollup: $c → exit $rc (기대 2)"; rm -rf "$tmp"; exit 1; }
done
# 미완료(pending) 포함 → 차단 보존(exit 2)
rc=0; run_gate_rollup '[{"status":"IN_PROGRESS"}]' || rc=$?
[ "$rc" = 2 ] || { echo "  ✗ ci-gate rollup: 미완료 → exit $rc (기대 2)"; rm -rf "$tmp"; exit 1; }
# 비-SUCCESS 종결 (열거 안 된 conclusion — STARTUP_FAILURE) 포함 → 차단(exit 2)
# (allowlist 핵심: denylist 면 여기를 통과시켜 CI 미통과를 머지로 흘린다.)
rc=0; run_gate_rollup '[{"status":"COMPLETED","conclusion":"SUCCESS"},{"status":"COMPLETED","conclusion":"STARTUP_FAILURE"}]' || rc=$?
[ "$rc" = 2 ] || { echo "  ✗ ci-gate rollup: STARTUP_FAILURE → exit $rc (기대 2)"; rm -rf "$tmp"; exit 1; }
# 알 수 없는 종결값(미래/오타 conclusion) 포함 → 차단(exit 2)
rc=0; run_gate_rollup '[{"status":"COMPLETED","conclusion":"UNKNOWN_STATE"}]' || rc=$?
[ "$rc" = 2 ] || { echo "  ✗ ci-gate rollup: 알 수 없는 conclusion → exit $rc (기대 2)"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] README 두 루프 분업 문서화 검사 (#45)"
# closeout 루프 문서화 — 언어중립 토큰은 영/한 두 README 모두, 머지 불변은 언어별 보존.
# (README.md=영문 주 페이지, README.ko.md=한글 미러)
for s in '/closeout' 'harvesting' 'MAX_CLOSEOUT'; do
  grep -qF "$s" README.md    || { echo "  ✗ README.md 에 '$s' 없음"; exit 1; }
  grep -qF "$s" README.ko.md || { echo "  ✗ README.ko.md 에 '$s' 없음"; exit 1; }
done
grep -qiF 'never merges'      README.md    || { echo "  ✗ README.md 에 머지 불변(never merges) 없음"; exit 1; }
grep -qF '머지는 항상 사람이 한다' README.ko.md || { echo "  ✗ README.ko.md 에 머지 불변('머지는 항상 사람이 한다') 없음"; exit 1; }

echo "[closeout] SKILL 3단계 캐시 보강(run-local-ci.sh) 문서화 검사 (#58)"
# closeout ③ 3단계 doc push 직후 run-local-ci.sh 로 메인 slug 캐시를 채운다는
# 지시가 한/영 SKILL 양쪽에 있어야 한다 (워크트리 provenance — 머지 게이트 cache-miss
# 방지). 지우면 Plans/*.md 를 가진 PR 의 마감이 stage 3 직후 막히는 회귀.
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  grep -qF 'run-local-ci.sh' "$f" || { echo "  ✗ $f 에 run-local-ci.sh 캐시 보강 지시 없음"; exit 1; }
done

echo "[closeout] SKILL 2단계 rebase된 HEAD 재검증(revalidate) 문서화 검사 (#70)"
# closeout ③ 2단계 머지 게이트가 revalidate:true 후보를 머지 직전 run-local-ci.sh 로
# 재검증한다는 지시가 한/영 SKILL 양쪽에 있어야 한다. revalidate 는 closeout-eligible.sh
# 출력 JSON 필드명(언어 불변 토큰)이라 한 가드로 양 파일을 덮는다. run-local-ci.sh 는
# 3단계 캐시 보강도 쓰므로 단독으로는 2단계 재검증 경로 존재를 증명 못 한다 — revalidate
# 토큰이 그 경로의 식별자다. 지우면 rebase 로 HEAD 가 바뀐 PR 이 양쪽 사각지대에
# 끼는 회귀(#70 배경).
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  grep -qF 'revalidate' "$f" || { echo "  ✗ $f 에 rebase HEAD 재검증(revalidate) 지시 없음"; exit 1; }
  # revalidate 경로가 실제로 현재 HEAD 에 로컬 CI 를 돌린다는 핵심 지시를 확인:
  # revalidate 와 같은 단락(빈 줄로 구분)에 run-local-ci.sh 가 있어야 한다. 단어만
  # 남고 재실행 지시가 빠지는 회귀를 막는다(#70 codex NIT). awk 로 revalidate 를 담은
  # 단락만 떼어 그 안에서 run-local-ci.sh 를 찾는다.
  awk 'BEGIN{RS="";ok=0} /revalidate/ && /run-local-ci\.sh/ {ok=1} END{exit ok?0:1}' "$f" \
    || { echo "  ✗ $f 의 revalidate 단락에 run-local-ci.sh 재검증 지시 없음"; exit 1; }
done

echo "[closeout] cleanup-worktree.sh 동작 스모크 (#62)"
# 공유 worktree 정리 헬퍼 — 더티/미push/--merged/멱등 동작을 실제 git worktree 로 검증.
clean_wt="$PWD/scripts/cleanup-worktree.sh"
[ -x "$clean_wt" ] || { echo "  ✗ scripts/cleanup-worktree.sh 미존재/비실행"; exit 1; }
tmp=$(mktemp -d)
mk_repo() {  # $1=issue-num → o/r 레포 + agent/issue-<N> worktree 생성, 더티/upstream 인자 반영
  local inum="$1"
  rm -rf "$tmp/proj"; mkdir -p "$tmp/proj/r"
  git -C "$tmp/proj/r" init -q
  git -C "$tmp/proj/r" config user.email t@t; git -C "$tmp/proj/r" config user.name t
  git -C "$tmp/proj/r" commit -q --allow-empty -m init
  git -C "$tmp/proj/r" worktree add -q -b "agent/issue-$inum" \
    "$tmp/proj/r/.claude/worktrees/issue-$inum" >/dev/null 2>&1
}
run_clean() {  # $@ = cleanup-worktree.sh 인자 (repo issue-num [--merged])
  PATH="$PATH" ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" bash "$clean_wt" "$@"
}
# (a) clean + --merged → 제거됨(exit 0), worktree 디렉토리 사라짐
mk_repo 5
rc=0; out=$(run_clean o/r 5 --merged 2>&1) || rc=$?
[ "$rc" = 0 ] || { echo "  ✗ clean+--merged: exit $rc (기대 0) out='$out'"; rm -rf "$tmp"; exit 1; }
[ ! -d "$tmp/proj/r/.claude/worktrees/issue-5" ] || { echo "  ✗ clean+--merged: worktree 미제거"; rm -rf "$tmp"; exit 1; }
# (b) dirty + --merged → 보류(exit 1), warn JSON, worktree 잔존 (더티 가드는 --merged 여도 유지)
mk_repo 6
echo dirty > "$tmp/proj/r/.claude/worktrees/issue-6/x.txt"
rc=0; out=$(run_clean o/r 6 --merged 2>&1) || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ dirty+--merged: exit $rc (기대 1)"; rm -rf "$tmp"; exit 1; }
printf '%s' "$out" | jq -e 'select(.event=="warn" and .number==6)' >/dev/null 2>&1 \
  || { echo "  ✗ dirty+--merged: warn JSON 누락 out='$out'"; rm -rf "$tmp"; exit 1; }
[ -d "$tmp/proj/r/.claude/worktrees/issue-6" ] || { echo "  ✗ dirty+--merged: worktree 오제거"; rm -rf "$tmp"; exit 1; }
# (c) clean + 기본(플래그 없음) + upstream 없음 → 미push 가드로 보류(exit 1), warn JSON
mk_repo 7
rc=0; out=$(run_clean o/r 7 2>&1) || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ clean+기본+no-upstream: exit $rc (기대 1)"; rm -rf "$tmp"; exit 1; }
printf '%s' "$out" | jq -e 'select(.event=="warn" and .number==7)' >/dev/null 2>&1 \
  || { echo "  ✗ clean+기본+no-upstream: warn JSON 누락 out='$out'"; rm -rf "$tmp"; exit 1; }
[ -d "$tmp/proj/r/.claude/worktrees/issue-7" ] || { echo "  ✗ clean+기본+no-upstream: worktree 오제거"; rm -rf "$tmp"; exit 1; }
# (d) 멱등: worktree 없음 → no-op(exit 0), 출력 없음
rm -rf "$tmp/proj"; mkdir -p "$tmp/proj/r"
git -C "$tmp/proj/r" init -q
rc=0; out=$(run_clean o/r 99 --merged 2>&1) || rc=$?
[ "$rc" = 0 ] && [ -z "$out" ] || { echo "  ✗ 멱등(없음): exit $rc out='$out' (기대 0/빈)"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] reconcile dirty worktree warn 회귀 스모크 (#62 — 동작 불변)"
# reconcile 가 헬퍼를 부르도록 리팩터된 뒤에도 MERGED PR + dirty worktree 는
# 정확히 한 줄 warn(원래 메시지 형식)을 내고 merged 이벤트를 안 내야 한다.
tmp=$(mktemp -d); mkdir -p "$tmp/proj/r" "$tmp/stub"
git -C "$tmp/proj/r" init -q
git -C "$tmp/proj/r" config user.email t@t; git -C "$tmp/proj/r" config user.name t
git -C "$tmp/proj/r" commit -q --allow-empty -m init
git -C "$tmp/proj/r" worktree add -q -b "agent/issue-8" \
  "$tmp/proj/r/.claude/worktrees/issue-8" >/dev/null 2>&1
echo dirty > "$tmp/proj/r/.claude/worktrees/issue-8/x.txt"
# #131 이후로 이 픽스처는 **claim 시각**을 줘야 한다 — 타임라인을 못 얻으면 reconcile 은
# 재claim 필터를 못 걸어 정리를 통째로 건너뛰기(fail-closed) 때문이다. mergedAt 이 claim
# 이후 = 이번 claim 의 머지 → MERGED 분기 진입 → dirty worktree 라 warn 한 줄(동작 불변).
cat > "$tmp/stub/gh" <<'EOF'
#!/bin/sh
case "$*" in
  *"api user"*) echo "tester" ;;
  *timeline*) echo "2000-01-01T00:00:00Z" ;;
  *"search issues"*) echo '[{"repository":{"nameWithOwner":"o/r"},"number":8}]' ;;
  *"pr list"*) echo '[{"number":80,"state":"MERGED","mergedAt":"2000-01-02T00:00:00Z","statusCheckRollup":[],"labels":[]}]' ;;
  *) echo '' ;;
esac
EOF
chmod +x "$tmp/stub/gh"
out=$(PATH="$tmp/stub:$PATH" ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" bash scripts/reconcile.sh 2>/dev/null)
warn_n=$(printf '%s\n' "$out" | jq -rs '[.[] | select(.event=="warn")] | length' 2>/dev/null)
merged_n=$(printf '%s\n' "$out" | jq -rs '[.[] | select(.event=="merged")] | length' 2>/dev/null)
[ "$warn_n" = 1 ] && [ "$merged_n" = 0 ] || { echo "  ✗ reconcile dirty: warn=$warn_n merged=$merged_n (기대 1/0) out='$out'"; rm -rf "$tmp"; exit 1; }
printf '%s' "$out" | jq -e 'select(.event=="warn") | .msg | test("dirty")' >/dev/null 2>&1 \
  || { echo "  ✗ reconcile dirty: warn 메시지 형식 변형 out='$out'"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] closeout-reconcile MERGED → cleanup --merged 호출 검사 (#62)"
# MERGED 분기가 PR head 에서 이슈번호를 파싱해 cleanup-worktree.sh ... --merged 를
# 부르는지 검사한다. 호출을 가로채는 stub cleanup-worktree.sh 로 인자를 캡처.
grep -qE 'cleanup-worktree\.sh.*--merged' scripts/closeout-reconcile.sh \
  || { echo "  ✗ closeout-reconcile.sh 에 cleanup-worktree.sh --merged 호출 없음"; exit 1; }
grep -qF 'headRefName' scripts/closeout-reconcile.sh \
  || { echo "  ✗ closeout-reconcile.sh 가 PR head(headRefName)에서 이슈번호 파싱 안 함"; exit 1; }
# 런타임 검증: closeout-reconcile.sh 를 임시 scripts 디렉토리로 복사하고
# cleanup-worktree.sh 를 인자 캡처 스텁으로 갈아끼워, MERGED 분기가 (a) 매칭
# 브랜치에서 cleanup --merged 를 부르고 (b) cleanup 실패에도 merged_cleanup 을
# 내며 (c) 비매칭 브랜치에선 cleanup 을 안 부르는지 확인한다.
crun() {  # $1=headRefName → out 은 stdout, capture 파일은 $tmp/capture
  tmp=$(mktemp -d); mkdir "$tmp/sc"
  cp scripts/closeout-reconcile.sh "$tmp/sc/closeout-reconcile.sh"
  cat > "$tmp/sc/cleanup-worktree.sh" <<CAP
#!/bin/sh
printf '%s\n' "\$*" >> "$tmp/capture"
exit 1
CAP
  chmod +x "$tmp/sc/cleanup-worktree.sh"
  cat > "$tmp/sc/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"search/issues"*) echo '[{"repo":"o/r","num":80}]' ;;
  *"pr view"*headRefName*) echo '$1' ;;
  *"pr view"*state*) echo 'MERGED' ;;
  *) echo '' ;;
esac
STUB
  chmod +x "$tmp/sc/gh"
  out=$(PATH="$tmp/sc:$PATH" bash "$tmp/sc/closeout-reconcile.sh" 2>/dev/null)
}
# (a)+(b): 매칭 브랜치 → cleanup --merged 호출(캡처) + cleanup 실패해도 merged_cleanup 출력
crun "agent/issue-7"
grep -qE '^o/r 7 --merged$' "$tmp/capture" 2>/dev/null \
  || { echo "  ✗ closeout-reconcile 런타임: cleanup 호출 인자 불일치 (capture='$(cat "$tmp/capture" 2>/dev/null)')"; rm -rf "$tmp"; exit 1; }
printf '%s' "$out" | jq -e 'select(.event=="merged_cleanup")' >/dev/null 2>&1 \
  || { echo "  ✗ closeout-reconcile 런타임: cleanup 실패 시 merged_cleanup 미출력 out='$out'"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"
# (c): 비매칭 브랜치(agent/issue- 접두 없음) → cleanup 호출 안 함, merged_cleanup 은 출력
crun "some-other-branch"
[ ! -f "$tmp/capture" ] \
  || { echo "  ✗ closeout-reconcile 런타임: 비매칭 브랜치에서 cleanup 오호출 (capture='$(cat "$tmp/capture")')"; rm -rf "$tmp"; exit 1; }
printf '%s' "$out" | jq -e 'select(.event=="merged_cleanup")' >/dev/null 2>&1 \
  || { echo "  ✗ closeout-reconcile 런타임: 비매칭 브랜치 merged_cleanup 미출력 out='$out'"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] SKILL worktree 정리(cleanup-worktree.sh) 문서화 검사 (#62)"
# closeout 이 머지 직후 스스로 worktree 를 정리한다는 지시가 한/영 양쪽에 있어야 한다
# (issue-runner reconcile 의존 제거 — 지우면 closeout-only 세션서 worktree 적체 회귀).
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  grep -qF 'cleanup-worktree.sh' "$f" || { echo "  ✗ $f 에 cleanup-worktree.sh 정리 지시 없음"; exit 1; }
done

echo "[worker-template] 참조 이슈 본문 체크박스 reconcile 지시 존재 검사 (#66)"
# 워커가 PR 최종 단계에서 참조 이슈 본문의 체크박스를 reconcile(완료=[x],
# 미완=[ ] 유지) 하라는 지시가 한/영 워커 템플릿 양쪽에 있어야 한다. 본문 마크
# 동기화는 `gh issue edit --body` 로 한다 — 이 호출은 템플릿 다른 곳에 안 나오는
# 언어 불변 토큰이라 한 가드로 양 파일을 덮는다. 지우면 PR 머지 후 이슈가
# 체크박스 전부 빈 채로 닫히는 회귀(#66 배경).
for f in references/worker-template.md references/worker-template.en.md; do
  grep -qF 'gh issue edit' "$f" || { echo "  ✗ $f 에 참조 이슈 체크박스 reconcile(gh issue edit) 지시 없음"; exit 1; }
done

echo "[lessons] 경로 repo-dir.sh 명문화 검사 (#80 변경 1 — 문자 그대로 <repo-name> 잔존 0)"
# 기록(Reconcile)·읽기(Dispatch) 양쪽 lessons 경로가 repo-dir.sh 해석으로 명문화돼야
# 한다. repos.conf 매핑 머신에서 문자 그대로의 ~/Projects/<repo-name> 는 실제 위치와
# 어긋난다(랩탑↔미니 사례) — 리터럴 잔존 0 + lessons.md 경로 단락에 repo-dir.sh 명시.
for f in SKILL.md SKILL.en.md; do
  if grep -qF 'Projects/<repo-name>' "$f"; then
    echo "  ✗ $f 에 문자 그대로 'Projects/<repo-name>' 표기 잔존 (repo-dir.sh 해석 경로로 교체 필요)"; exit 1
  fi
  if grep -qE '~[^ `]*\.loop/lessons\.md' "$f"; then
    echo "  ✗ $f 에 lessons.md 홈-상대 리터럴 경로(~/…) 잔존 (repo-dir.sh 해석으로 통일 필요)"; exit 1
  fi
  awk 'BEGIN{RS="";ok=0} /lessons\.md/ && /repo-dir\.sh/ {ok=1} END{exit ok?0:1}' "$f" \
    || { echo "  ✗ $f: lessons.md 경로가 repo-dir.sh 해석으로 명문화된 단락 없음"; exit 1; }
done

echo "[lessons] 트리거 신호 보강 검사 (#80 변경 3 / #82 — commit statuses 실패 이력·검증자 BLOCKER·NONE 규칙)"
# local-ci 체제 레포(GitHub Actions 없음)에선 gh run list 가 항상 빈값이라 기존
# 트리거만으론 교훈이 안 잡힌다. 실 메커니즘은 각 커밋 SHA 를
# `gh api repos/<repo>/commits/<sha>/statuses` 로 실패 이력을 조회하는 것 —
# 가드는 이 실 메커니즘(commits/<sha>/statuses)을 앵커로 고정한다. 반례로 폐기된
# statusCheckRollup 문자열을 앵커로 삼으면, 실 메커니즘이 리팩터로 사라지고
# "statusCheckRollup 은 못 쓴다"는 반례 설명만 남아도 초록불이 되는 회귀(#82) —
# statusCheckRollup 은 "왜 안 쓰는지" 반례로 본문에 남되 앵커로는 쓰지 않는다.
# 검증자 리뷰 코멘트 BLOCKER 를 함께 신호로 요구하고, 신호 0이면 NONE 규칙은 유지.
for f in SKILL.md SKILL.en.md; do
  grep -qF 'commits/<sha>/statuses' "$f" \
    || { echo "  ✗ $f lessons 트리거에 실 메커니즘(commit statuses 실패 이력 조회) 신호 없음"; exit 1; }
  awk 'BEGIN{RS="";ok=0} /commits\/<sha>\/statuses/ && /BLOCKER/ && /NONE/ {ok=1} END{exit ok?0:1}' "$f" \
    || { echo "  ✗ $f lessons 트리거 단락에 commit statuses 신호·검증자 BLOCKER·NONE 규칙이 함께 있지 않음"; exit 1; }
done

echo "[lessons] README lessons 이관 유실 트러블슈팅 증상 검사 (#80 변경 2)"
# lessons 는 gitignore 로컬 파일이라 머신 이관 시 빠뜨리면 자가학습이 조용히 리셋된다.
# 이 증상이 영/한 두 README 트러블슈팅에 살아있어야 한다 — 'lessons.md' 단어는
# 본문 여러 곳에 있어 느슨하므로(회귀 못 잡음), 트러블슈팅 전용 증상 문구를 정확히 잡는다:
# 영문 "no prior lessons" · 한글 "과거 교훈: 없음".
grep -qiF 'no prior lessons' README.md \
  || { echo "  ✗ README.md 트러블슈팅에 'no prior lessons' 증상 항목 없음"; exit 1; }
grep -qF '과거 교훈: 없음' README.ko.md \
  || { echo "  ✗ README.ko.md 트러블슈팅에 '과거 교훈: 없음' 증상 항목 없음"; exit 1; }

echo "[closeout] lessons 기록 배선 검사 (#80 변경 4 — 거짓 BLOCKER 반전·코드무관 스모크 실패)"
# closeout 파이프라인에 반복 실증된 두 지점만 최소 배선: (a) 1단계 검증자 BLOCKER 가
# 사람/후속 확인으로 거짓 판정으로 뒤집힌 경우, (b) 5단계 스모크 실패가 코드무관
# (인프라/플레이크)으로 판명된 경우 — 각각 대상 레포 검증자 사례집에 1줄 append.
# 파일명은 `lessons-verifier.md`(검증 판정 계열) — 워커용 `lessons.md` 와 분리돼 있다.
# 정규식이 `lessons(-verifier)?\.md` 로 둘 다 받는 이유: 아직 분리 안 한 레포는 폴백으로
# `lessons.md` 를 쓰므로 그 서술도 유효하다. 접미 없는 `lessons.md` 만 박아 두면 분리
# 이후 서술이 통째로 거짓이 되고, 반대로 `-verifier` 만 강제하면 폴백 서술이 막힌다.
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  grep -qE 'lessons(-verifier)?\.md' "$f" || { echo "  ✗ $f 에 closeout lessons 기록 배선 없음"; exit 1; }
  awk 'BEGIN{RS="";ok=0} /lessons(-verifier)?\.md/ && /BLOCKER/ {ok=1} END{exit ok?0:1}' "$f" \
    || { echo "  ✗ $f: 거짓 BLOCKER 반전 시 lessons 기록 지시(같은 단락) 없음"; exit 1; }
  awk 'BEGIN{RS="";ok=0} /lessons(-verifier)?\.md/ && (/스모크/ || /smoke/) {ok=1} END{exit ok?0:1}' "$f" \
    || { echo "  ✗ $f: 코드무관 스모크 실패 시 lessons 기록 지시(같은 단락) 없음"; exit 1; }
done

echo "[표면교정] 3단계 흡수·6단계 비발행·verify ⓪ 이 같은 한 줄 기준을 쓰는지 검사"
# 표면 교정(주석·용어·수치·테스트 이름)을 이슈로 내보내면 한 줄 고치자고 디스패치→구현→
# 검증→마감 한 바퀴가 돌고, 그 PR 이 또 새 주석 지적을 낳아 사슬이 길어진다(실측).
# 그래서 세 지점이 **같은 경계**를 써야 한다 — 경계가 갈리면 같은 발견이 어느 루프에
# 걸리느냐로 처리가 달라진다. 기준 문장은 "통과/실패가 바뀌는 테스트가 없는가" 다.
# 한/영이 갈리지 않게 두 미러를 함께 본다(영문은 pass/fail 표현).
for f in skills/closeout/SKILL.md skills/verify-runner/SKILL.md; do
  grep -qF '통과/실패가 바뀌는 테스트가 하나도 없는가' "$f" \
    || { echo "  ✗ $f: 표면 교정 판정 기준 한 줄 없음"; exit 1; }
  grep -qF '테스트 이름' "$f" \
    || { echo "  ✗ $f: 표면 교정 허용 목록에 '테스트 이름' 없음(옛 '주석만' 경계로 되돌아감)"; exit 1; }
done
grep -qF '3단계가 이미 흡수한 표면 교정은 여기서 발행하지 않는다' skills/closeout/SKILL.md \
  || { echo "  ✗ closeout SKILL.md 6단계에 표면 교정 비발행 지시 없음"; exit 1; }
grep -qiF 'flip the pass/fail of any test' skills/closeout/SKILL.en.md \
  || { echo "  ✗ closeout SKILL.en.md: 표면 교정 기준 미러 없음"; exit 1; }
grep -qiF 'Do not issue what step 3 already absorbed' skills/closeout/SKILL.en.md \
  || { echo "  ✗ closeout SKILL.en.md: 6단계 비발행 미러 없음"; exit 1; }

echo "[배포검증] 항목 0 = '(승격만)' 티켓 + 스모크 생략 — 형태 고정 + 묶기 금지 검사"
# 배포검증 이슈 186건(2026-08-12~13) 중 64건이 '밟을 항목 없음' 이었는데 전부 이슈가 됐고
# 그중 39건은 Chrome 스모크까지 돌았다(항목 0 을 대조 → `✅ 스모크 0/0` = 거짓 초록).
# 반대로 항목 있는 120건의 스모크 통과는 16건(13%)뿐이라 나머지는 사람이 닫았다.
# 그래서 (a) `<LIVE_CHECKS>` 형태를 `없음` 단독 또는 `- [ ]` 목록으로 고정하고
# (b) `없음` 이면 5단계 스모크를 건너뛴다. 형태 고정이 빠지면 분기가 산문 해석으로
# 되돌아가 조용히 무력화된다(실측: 186건 중 체크박스 사용 0건).
# (c) 묶기 금지 — 장수 이슈는 닫히는 시점을 잃는다(사용자 결정).
#
# ★(b) 의 "이슈 미발행" 축은 #116 이 되돌렸다(#120)★ — 이제 머지하면 항목 0 이어도
# `(승격만)` 티켓을 **발행한다**(미발행이면 승격할 게 있는지조차 모르게 된다). 되돌린 건
# 발행 여부뿐이고 **스모크 생략 축은 그대로**다(거짓 초록 차단이 그 축의 목적). 그래서
# 아래 가드도 그 둘을 나눠 문다 — 규칙을 또 뒤집으면 여기가 같이 걸려야 한다.
grep -qF '`<LIVE_CHECKS>` 는 두 형태 중 하나여야 한다' skills/closeout/SKILL.md \
  || { echo "  ✗ closeout SKILL.md: <LIVE_CHECKS> 형태 고정 지시 없음"; exit 1; }
grep -qF '(승격만)' skills/closeout/SKILL.md \
  || { echo "  ✗ closeout SKILL.md 4단계: 항목 없음 → '(승격만)' 티켓 분기 없음 (#116 규칙)"; exit 1; }
grep -qF '밟을 항목이 없으면 스모크하지 않는다' skills/closeout/SKILL.md \
  || { echo "  ✗ closeout SKILL.md 5단계: 항목 0 스모크 생략 지시 없음"; exit 1; }
grep -qF '묶지 않는다' skills/closeout/SKILL.md \
  || { echo "  ✗ closeout SKILL.md: 배포 이슈 묶기 금지 지시 없음(장수 이슈 방지)"; exit 1; }
grep -qF 'must take one of two shapes' skills/closeout/SKILL.en.md \
  || { echo "  ✗ closeout SKILL.en.md: <LIVE_CHECKS> 형태 고정 미러 없음"; exit 1; }
grep -qF '(승격만)' skills/closeout/SKILL.en.md \
  || { echo "  ✗ closeout SKILL.en.md: 항목 없음 → '(승격만)' 티켓 미러 없음 (#116 규칙)"; exit 1; }
grep -qF 'Do not batch' skills/closeout/SKILL.en.md \
  || { echo "  ✗ closeout SKILL.en.md: 묶기 금지 미러 없음"; exit 1; }
# 템플릿이 체크박스 형태를 안내하는지 — 여기가 흔들리면 발행되는 이슈가 다시 산문이 된다.
grep -qF -e '- [ ]` 체크박스 목록만' skills/closeout/references/deploy-check-issue.md \
  || { echo "  ✗ deploy-check-issue.md: 체크박스 형태 안내 없음"; exit 1; }

echo "[closeout] 5단계 종결 조건 — 실장비 항목이 남아 있으면 안 닫는 예외 검사 (#278)"
# 4단계는 실테스트(사다리 칸 ③ TEST 워커)를 deploy-cycle ⑦ 소유로 선언하는데, 5단계 green
# 갈래는 같은 `<LIVE_CHECKS>` 를 크롬으로 밟고 배포 이슈를 닫는다 — 그대로 두면 실장비 항목이
# 든 티켓이 TEST 워커를 한 번도 안 거치고 종결된다(#278 검증 BLOCKER). 그래서 5단계 구간
# (`**5단계 —`/`**Step 5 —` ~ `**6단계 —`/`**Step 6 —`) 안에 셋이 다 있어야 한다:
#   (a) 예외의 코멘트 마커 `종결 보류: 실장비 항목` — 마커가 곧 그 예외가 적혀 있다는 증거.
#   (b) 4단계와 **같은** 판별 술어(`TEST 워커 프로필 #18` / `TEST-worker profile #18`). 같은
#       문자열이 4단계 구간에도 있어야 한다 — 두 곳이 갈라지면 "실장비 항목" 을 세는
#       두 번째 계산기가 생기고, 그건 사람 눈에 안 보인다.
#   (c) green 갈래의 상호참조(`실장비 예외` / `real-hardware exception`) — 예외만 적고
#       green 갈래를 안 고치면 green 만 읽는 실행자가 그대로 닫는다(이번 BLOCKER 의 형태).
# 스코프를 구간으로 좁히는 이유는 #223 과 같다 — "파일 어딘가" 면 문구가 6단계로 밀려도 초록.
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  case "$f" in
    *.en.md) s4_anchor='^\*\*Step 4 —'; s5_anchor='^\*\*Step 5 —'; s6_anchor='^\*\*Step 6 —'
             predicate='TEST-worker profile #18'; xref='real-hardware exception' ;;
    *)       s4_anchor='^\*\*4단계 —';   s5_anchor='^\*\*5단계 —';   s6_anchor='^\*\*6단계 —'
             predicate='TEST 워커 프로필 #18'; xref='실장비 예외' ;;
  esac
  s4_line=$(grep -nE "$s4_anchor" "$f" | head -1 | cut -d: -f1)
  s5_line=$(grep -nE "$s5_anchor" "$f" | head -1 | cut -d: -f1)
  s6_line=$(grep -nE "$s6_anchor" "$f" | head -1 | cut -d: -f1)
  [ -n "$s4_line" ] || { echo "  ✗ $f: 4단계 헤더 앵커 없음"; exit 1; }
  [ -n "$s5_line" ] || { echo "  ✗ $f: 5단계 헤더 앵커 없음"; exit 1; }
  [ -n "$s6_line" ] || { echo "  ✗ $f: 6단계 헤더 앵커 없음"; exit 1; }
  s4_body=$(sed -n "${s4_line},${s5_line}p" "$f")
  s5_body=$(sed -n "${s5_line},${s6_line}p" "$f")
  printf '%s\n' "$s5_body" | grep -qF '종결 보류: 실장비 항목' \
    || { echo "  ✗ $f: 5단계에 실장비 잔존 시 종결 보류 예외(마커 '종결 보류: 실장비 항목')가 없다 (#278)"; exit 1; }
  printf '%s\n' "$s5_body" | grep -qF "$predicate" \
    || { echo "  ✗ $f: 5단계 실장비 예외가 4단계 판별 술어('$predicate')를 안 쓴다 (#278)"; exit 1; }
  printf '%s\n' "$s4_body" | grep -qF "$predicate" \
    || { echo "  ✗ $f: 4단계에 판별 술어('$predicate')가 없다 — 5단계와 술어가 갈라졌다 (#278)"; exit 1; }
  printf '%s\n' "$s5_body" | grep -qF "$xref" \
    || { echo "  ✗ $f: 5단계 green 갈래에 실장비 예외 상호참조('$xref')가 없다 — green 만 읽으면 그대로 닫는다 (#278)"; exit 1; }
done

echo "[closeout] <LIVE_CHECKS> 실장비 표식 — 형태 강제 + 4·5단계·템플릿·실행 프롬프트 동일 표식 검사 (#309)"
# #298 은 5단계 green 갈래에 "실장비 항목이 `- [ ]` 로 남아 있으면 닫지 않는다" 예외를 넣어
# **닫는 자리**를 막았다. 그런데 그 예외가 걸리려면 5단계가 **어느 줄이 실장비인지** 알아야
# 하는데, 당시 근거는 4단계의 산문 한 줄("한 줄 = … (실장비면 TEST 워커 프로필 #18 드라이런)")
# 뿐이었다 — 그건 *실장비란 무엇인가* 의 성격 규정이지 *그 줄을 이렇게 적어라* 는 형태 강제가
# 아니다. 그래서 칸 ①② 를 시도했다 실패해 옮겨진 줄이 "TEST 워커 프로필 #18" 이라는 말 없이 적히면
# (`- [ ] worker001 에서 프록시 회전 후 IG 세션 유지 확인`) 5단계가 그 줄을 일반 항목으로
# 세어 크롬 pass → green → close 로 흘러, TEST 워커를 한 번도 안 거친 티켓이 종결된다(#309).
# 처방: 실장비 줄에 `없음`·`- [ ]` 와 **같은 등급**의 접두 표식 `[칸 ③]` 을 형태로 강제하고,
# 생산(4단계)·소비(5단계)·템플릿 **셋이 같은 표식**을 쓰는지 여기서 문다 — 셋 중 하나가
# 갈라지면 실장비를 세는 계산기가 둘이 되고, 그 갈라짐은 사람 눈에 안 보인다.
# 스코프를 구간으로 좁히는 이유는 #278·#223 과 같다 — "파일 어딘가" 면 문구가 6단계로 밀려도 초록.
live_marker='[칸 ③]'
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  case "$f" in
    *.en.md) m4_anchor='^\*\*Step 4 —'; m5_anchor='^\*\*Step 5 —'; m6_anchor='^\*\*Step 6 —'
             mandate='A real-hardware line REQUIRES the `[칸 ③]` prefix marker'
             verdict='`[칸 ③]` prefix marker** is a real-hardware item'
             noissue='**Do not file a follow-up issue** — it is not a defect, only a different lane, and'
             failexcl='- **fail (any item fails)** — **only lines Chrome actually stepped reach here.** Lines'
             deadclause='fixed string `TEST 워커 프로필 #18` counts as real hardware' ;;
    *)       m4_anchor='^\*\*4단계 —';   m5_anchor='^\*\*5단계 —';   m6_anchor='^\*\*6단계 —'
             mandate='실장비 줄은 접두 표식 `[칸 ③]` 필수'
             verdict='**접두 표식 `[칸 ③]` 이 붙은 줄**'
             noissue='**후속 이슈를 발행하지 마라** — 결함이'
             failexcl='- **fail (한 건이라도 실패)** — **크롬이 밟은 줄만 여기 온다.**'
             deadclause='고정 문자열 `TEST 워커 프로필 #18` 이 적혀 있으면 실장비로 본다' ;;
  esac
  m4_line=$(grep -nE "$m4_anchor" "$f" | head -1 | cut -d: -f1)
  m5_line=$(grep -nE "$m5_anchor" "$f" | head -1 | cut -d: -f1)
  m6_line=$(grep -nE "$m6_anchor" "$f" | head -1 | cut -d: -f1)
  [ -n "$m4_line" ] || { echo "  ✗ $f: 4단계 헤더 앵커 없음"; exit 1; }
  [ -n "$m5_line" ] || { echo "  ✗ $f: 5단계 헤더 앵커 없음"; exit 1; }
  [ -n "$m6_line" ] || { echo "  ✗ $f: 6단계 헤더 앵커 없음"; exit 1; }
  m4_body=$(sed -n "${m4_line},${m5_line}p" "$f")
  m5_body=$(sed -n "${m5_line},${m6_line}p" "$f")
  # ⓐ 생산 쪽 — 4단계 형태 규율에 표식이 **강제**로 적혀 있어야 한다. 성격 규정("실장비면
  #    TEST 워커 …")만 남으면 #309 의 출발점으로 되돌아간다.
  printf '%s\n' "$m4_body" | grep -qF "$mandate" \
    || { echo "  ✗ $f: 4단계 <LIVE_CHECKS> 형태 규율에 실장비 접두 표식 강제 문면('$mandate')이 없다 — 성격 규정은 형태 강제가 아니다 (#309)"; exit 1; }
  # ⓑ 소비 쪽 — **판별문 자체**가 같은 표식을 써야 한다. "5단계 어딘가에 표식이 있는가" 로
  #    물으면 다른 문단(전환기 조항 등)에 표식이 한 번 더 늘어난 뒤 판별문만 산문 술어로
  #    되돌려도 초록이 된다 — 그래서 판별문 고유 문구에 결합한다.
  printf '%s\n' "$m5_body" | grep -qF "$verdict" \
    || { echo "  ✗ $f: 5단계 실장비 판별문이 표식('$live_marker')에 결합돼 있지 않다('$verdict' 부재) — 판별이 문장 해석으로 돌아갔다 (#309)"; exit 1; }
  # ⓓ 표식 없는 줄의 라우팅 — **fail-closed**. attempt 1 은 이 자리를 고정 문자열
  #    `TEST 워커 프로필 #18` 소급 조항으로 메웠는데, 열린 재고 10건·`- [ ]` 27줄 전수
  #    실측에서 그 문자열은 **0줄**을 물었다(조항이 태어날 때부터 죽어 있었다). 그 결과
  #    재고의 실장비 줄이 ⑦ 레인이 아니라 fail 갈래로 떨어져 **결함이 아닌 것에
  #    `needs-human` 후속 이슈가 나고 사유가 '스모크 실패' 로 잘못 기록**됐다(#309 BLOCKER).
  #    그래서 ⑴ 미밟음 줄은 후속 이슈를 내지 않는다는 문면과 ⑵ fail 갈래가 그 줄을
  #    제외한다는 문면이 **둘 다** 있어야 한다 — 한쪽만 있으면 같은 줄을 두 갈래가 집는다.
  #    ⑶ 죽은 고정 문자열 조항이 되살아나면 빨강(같은 사고의 재발 지문).
  printf '%s\n' "$m5_body" | grep -qF -- "$noissue" \
    || { echo "  ✗ $f: 5단계에 '미밟음 줄은 후속 이슈를 내지 않는다' 문면('$noissue')이 없다 — 결함 아닌 줄이 '스모크 실패' 로 기록된다 (#309)"; exit 1; }
  printf '%s\n' "$m5_body" | grep -qF -- "$failexcl" \
    || { echo "  ✗ $f: 5단계 fail 갈래가 미밟음 보류 줄을 제외하지 않는다('$failexcl' 부재) — 보류와 fail 이 같은 줄을 집는다 (#309)"; exit 1; }
  if printf '%s\n' "$m5_body" | grep -qF -- "$deadclause"; then
    echo "  ✗ $f: 5단계에 죽은 소급 조항('$deadclause')이 되살아났다 — 재고 27줄 전수 실측 0건 (#309)"; exit 1
  fi
done
# ⓒ 템플릿 — 실제로 발행되는 이슈 본문의 형태가 여기서 나온다. 여기가 표식을 안 가르치면
#    4단계 규율이 아무리 강제여도 발행물엔 표식이 안 붙는다. 스코프는 **형태 안내 주석 구간**
#    (`## 라이브/하드웨어 검증 항목` ~ `<LIVE_CHECKS>`) — 파일 전체로 물면 아래 `## 완료 처리`
#    문장에 남은 표식 덕에 정작 안내가 지워져도 초록이다.
tmpl='skills/closeout/references/deploy-check-issue.md'
t_head=$(grep -nF '## 라이브/하드웨어 검증 항목' "$tmpl" | head -1 | cut -d: -f1)
t_ph=$(grep -nF '<LIVE_CHECKS>' "$tmpl" | head -1 | cut -d: -f1)
[ -n "$t_head" ] && [ -n "$t_ph" ] && [ "$t_head" -lt "$t_ph" ] \
  || { echo "  ✗ $tmpl: '## 라이브/하드웨어 검증 항목' ~ '<LIVE_CHECKS>' 구간을 못 찾음"; exit 1; }
sed -n "${t_head},${t_ph}p" "$tmpl" | grep -qF '`- [ ] [칸 ③] <동작>` 형태로 적는다' \
  || { echo "  ✗ $tmpl: 형태 안내 주석에 실장비 접두 표식 형태('- [ ] [칸 ③] <동작>')가 없다 — 발행되는 이슈에 표식이 안 붙는다 (#309)"; exit 1; }
# ⓔ **실행 프롬프트** — 위 ⓐⓑⓒ 는 생산(4단계)·소비(5단계)·템플릿 셋을 묶었지만, 5단계가
#    실제로 **밟는 주체에게 건네는 문서**는 `references/smoke-prompt*.md` 다: 5단계는
#    `<LIVE_CHECKS>` 를 그 프롬프트에 통째로 치환하고(placeholder 는 파일 끝), 그 프롬프트의
#    출력 계약이 항목별 판정 어휘와 `<전체수>` 의 정의를 쥐고 있다. 그래서 표식·분모 규칙이
#    SKILL 에만 있으면 **같은 에이전트가 모순된 두 계약을 받는다** — SKILL 은 "표식 줄은
#    밟지 말고 분모에서 빼라" 인데 프롬프트는 "전 항목에 한 줄씩 판정, 끝에 <전체수>" 다.
#    결말이 둘 다 나쁘다: 표식 줄을 크롬이 시도해 **거짓 fail** 이 되면 fail 갈래가
#    `needs-human` 후속 이슈를 내고(attempt 1 이 샌 자리), `skip` 으로 찍히면 **분모에 남아
#    거짓 초록**이 되며 그 `skip` 은 저하 마커 `스모크 skip:` 과 **어휘가 겹친다**(#309 BLOCKER).
#    처방(ⓐ 갈래): 같은 표식·분모 규칙을 두 프롬프트에 넣고, 항목별 어휘를
#    `pass`·`fail`·`보류` 로 고정해 `skip` 을 전체-저하 전용으로 돌려준다.
#    ⓑ(치환 전 필터)를 택하지 않은 이유도 여기서 문다 — 필터는 표식 줄만 지울 수 있고
#    "크롬이 시도조차 못 한 줄" 은 **밟아 봐야 알기에** 프롬프트 안에서만 갈린다. 두 갈래를
#    섞으면 실장비를 세는 계산기가 둘이 된다. 그래서 5단계에 "그대로 치환·미리 거르지 마라"
#    문면이 있는지도 함께 문다(없으면 ⓑ 하이브리드가 슬며시 돌아온다).
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  case "$f" in
    *.en.md) nofilter='substitute that section untouched — do not pre-filter the marked lines out' ;;
    *)       nofilter='그 절을 손대지 말고 그대로 치환한다 — 표식 줄을 미리 걸러 내지 마라' ;;
  esac
  grep -qF -- "$nofilter" "$f" \
    || { echo "  ✗ $f: 5단계에 '<LIVE_CHECKS> 를 그대로 치환한다(미리 거르지 마라)' 문면('$nofilter')이 없다 — 프롬프트와 치환부가 실장비를 각자 세게 된다 (#309)"; exit 1; }
done
for f in skills/closeout/references/smoke-prompt.md \
         skills/closeout/references/smoke-prompt.en.md; do
  [ -f "$f" ] || { echo "  ✗ 누락: $f"; exit 1; }
  case "$f" in
    *.en.md) p_marker='A line carrying the `[칸 ③]` prefix marker'
             p_denom='`보류` lines go into neither'
             p_vocab='vocabulary is `pass`·`fail`·`보류`'
             p_stale='with `pass`/`fail`/`skip` and a rationale' ;;
    *)       p_marker='접두 표식 `[칸 ③]` 이 붙은 줄'
             p_denom='`보류` 줄은 분자에도 분모에도 넣지 않는다'
             p_vocab='`pass`·`fail`·`보류` **셋뿐이다.**'
             p_stale='`pass`/`fail`/`skip` 과 근거를 적고' ;;
  esac
  # ⑴ 판별 — 프롬프트가 4·5단계와 **같은 표식**으로 실장비 줄을 가려내는가.
  grep -qF -- "$p_marker" "$f" \
    || { echo "  ✗ $f: 실행 프롬프트에 실장비 표식('$live_marker') 판별 문면('$p_marker')이 없다 — 5단계 규칙이 밟는 주체에 도달하지 않는다 (#309)"; exit 1; }
  # ⑵ 분모 — `<전체수>` 정의가 보류 줄을 빼는가. 이게 없으면 보류 줄이 분모에 남아 거짓 초록.
  grep -qF -- "$p_denom" "$f" \
    || { echo "  ✗ $f: 출력 계약의 <전체수> 정의가 보류 줄을 분모에서 빼지 않는다('$p_denom' 부재) — 밟지 않은 줄이 통과로 세어진다 (#309)"; exit 1; }
  # ⑶ 어휘 — 항목별 판정에서 `skip` 을 몰아내야 저하 마커 `스모크 skip:` 과 안 겹친다.
  grep -qF -- "$p_vocab" "$f" \
    || { echo "  ✗ $f: 항목별 판정 어휘를 pass·fail·보류 셋으로 고정하는 문면('$p_vocab')이 없다 — 항목 skip 이 저하 마커 '스모크 skip:' 과 겹친다 (#309)"; exit 1; }
  # ⑷ 재발 지문 — 옛 출력 계약(전 항목 pass/fail/skip)이 되살아나면 빨강. ⑴~⑶ 만으로는
  #    새 문면을 덧붙이고 옛 계약을 그대로 남기는 회귀를 못 잡는다(두 계약 공존 = BLOCKER 원형).
  if grep -qF -- "$p_stale" "$f"; then
    echo "  ✗ $f: 옛 출력 계약('$p_stale')이 남아 있다 — 표식·보류 규칙과 모순된 두 계약을 같은 에이전트가 받는다 (#309)"; exit 1
  fi
  # ⑸ 보류 내역 — 5단계가 코멘트로 옮길 내역 줄을 프롬프트가 **같은 문자열**로 낸다.
  #    (5단계는 뒤에 분류 접미사를 더하므로 공통 접두로 문다.)
  grep -qF -- '보류 내역: 표식 <a>건 · 표식 없는 미밟음 <b>건' "$f" \
    || { echo "  ✗ $f: 보류 내역 출력('보류 내역: 표식 <a>건 · 표식 없는 미밟음 <b>건')이 없다 — 5단계가 <a>·<b> 를 받을 경로가 없다 (#309)"; exit 1; }
done

echo "[closeout] verifier-prompt lessons 주입 placeholder 검사 (#80 변경 4)"
# 1단계 검증자가 과거 오판 패턴(인용 오판·base 맹점 등)을 반복하지 않도록 lessons 를
# 프롬프트에 주입한다 — 프롬프트가 유일한 전달 경로라는 기존 계약 유지.
# (<LESSONS_OR_ 는 접미사가 언어별로 다를 수 있어 워커 템플릿과 동일하게 접두만 본다.)
grep -qF '<LESSONS_OR_' skills/closeout/references/verifier-prompt.md \
  || { echo "  ✗ verifier-prompt.md 에 <LESSONS_OR_ placeholder 없음"; exit 1; }
grep -qF '<LESSONS_OR_' skills/closeout/references/verifier-prompt-fallback.md \
  || { echo "  ✗ verifier-prompt-fallback.md 에 <LESSONS_OR_ placeholder 없음"; exit 1; }
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  awk 'BEGIN{RS="";ok=0} /<LESSONS_OR_/ && /lessons(-verifier)?\.md/ {ok=1} END{exit ok?0:1}' "$f" \
    || { echo "  ✗ $f: 1단계 검증자에 lessons 주입(<LESSONS_OR_ ← lessons-verifier.md) 지시 없음"; exit 1; }
done

