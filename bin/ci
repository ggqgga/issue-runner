bash scripts/tests/loop-status.test.sh

echo "[test] timebox-check.sh 진행 증거 판정·queue.log 마지막 줄·유예 상한 (#200)"
# 디스패처가 `"$SCRIPTS/timebox-check.sh"` 로 직접 exec 하므로 실행 비트도 여기서 문다
# (비트가 빠지면 조용히 exit 126 → 판정 줄이 빈 값이 되고 그 이슈의 timebox 가 무판정으로 샌다).
[ -x scripts/timebox-check.sh ] || { echo "  ✗ timebox-check.sh 실행 비트 없음"; exit 1; }
bash scripts/tests/timebox-check.test.sh

echo "[test] lessons-trim.sh lessons-verifier.md 캡 수렴 정리 — 항목 정의·오래된 순 삭제·멱등·append 잠금 (#208)"
# closeout 1·6단계가 append 직후 `$SCRIPTS/lessons-trim.sh append <파일> 20 "<줄>"`
# 한 자리로 부르는 계약이므로 실행 비트도 여기서 문다(비트가 빠지면 exit 126 → 캡
# 정리가 조용히 no-op 으로 degrade, PR#173 교훈과 동일 함정).
[ -x scripts/lessons-trim.sh ] || { echo "  ✗ lessons-trim.sh 실행 비트 없음"; exit 1; }
bash scripts/tests/lessons-trim.test.sh

echo "[#227] lessons-trim.sh 호출은 \$SCRIPTS/ 절대경로 — closeout 은 대상 레포 cwd 에서 돈다"
# closeout 은 대상 레포의 worktree 를 cwd 로 돌 수 있는데, 상대경로 \`scripts/lessons-trim.sh\`
# 는 그 레포엔 없는 파일이다(스크립트는 ~/.claude/skills/issue-runner/scripts/ 에 산다).
# 같은 문서의 다른 모든 헬퍼 호출이 \$SCRIPTS/ 를 쓰는 것과 어긋나면 캡 집행이 평상시
# 안 돈다(#227 검증자 실증 — references/worker-template.md 의 같은 형상을 #185 가
# 절대경로로 고친 전례와 동일). 백틱으로 감싼 상대경로 호출 문구가 있으면 즉시 회귀다.
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  if grep -qF '`scripts/lessons-trim.sh' "$f"; then
    echo "  ✗ $f 가 lessons-trim.sh 를 상대경로로 호출 — \$SCRIPTS/lessons-trim.sh 로 고쳐라(#227)"
    exit 1
  fi
  grep -qF '$SCRIPTS/lessons-trim.sh' "$f" \
    || { echo "  ✗ $f 에 \$SCRIPTS/lessons-trim.sh 호출 없음"; exit 1; }
done

echo "[#88] 완결 유실 재파생 배선 검사 — 한/영 SKILL 동기"
# STALE_FINISH_MIN 상수 + finish-classify.sh 분기 + 4b 인라인 대리 판정 배선이
# 한/영 SKILL 양쪽에 있어야 한다(완결 유실 갭 자가 재파생 — 규칙4 분리).
for f in SKILL.md SKILL.en.md; do
  grep -qF 'STALE_FINISH_MIN' "$f" \
    || { echo "  ✗ $f 에 STALE_FINISH_MIN 상수 없음"; exit 1; }
  grep -qF 'finish-classify.sh' "$f" \
    || { echo "  ✗ $f 에 finish-classify.sh 분기 배선 없음"; exit 1; }
done

echo "[#200] timebox 진행 증거 판정 배선 검사 — 한/영 SKILL 동기"
# 상수(STALL_MIN·MAX_TIMEBOX_GRACE) + 판정자 호출이 한/영 양쪽에 있어야 한다. 스크립트만
# 고치고 프롬프트에 옛 규칙("경과가 넘으면 중단")이 남으면 **디스패처는 옛 규칙을 따른다** —
# 이 루프에서 실제로 판정하는 것은 프롬프트다.
for f in SKILL.md SKILL.en.md; do
  for token in 'STALL_MIN' 'MAX_TIMEBOX_GRACE' 'timebox-check.sh'; do
    grep -qF "$token" "$f" \
      || { echo "  ✗ $f 에 $token 배선 없음"; exit 1; }
  done
done
# 값 드리프트 검사 — 스크립트 기본값과 프롬프트가 말하는 값이 갈리면 디스패처는 문서의 값을
# 믿는데 실제 판정은 스크립트 값으로 난다. 존재만 grep 하면 이 어긋남을 못 잡는다.
for pair in 'STALL_MIN:25' 'MAX_TIMEBOX_GRACE:3' 'ISSUE_TIMEBOX_HOURS:1'; do
  name="${pair%%:*}"
  want=$(sed -n "s/^[A-Z_]*=\"\${$name:-\([0-9][0-9]*\)}\".*/\1/p" scripts/timebox-check.sh | head -1)
  [ -n "$want" ] || { echo "  ✗ scripts/timebox-check.sh 에서 $name 기본값을 읽지 못함"; exit 1; }
  for f in SKILL.md SKILL.en.md; do
    grep -qF "\`$name = $want\`" "$f" \
      || { echo "  ✗ $f 의 $name 값이 스크립트 기본값($want)과 다르다"; exit 1; }
  done
done

echo "[#109] repo-flag.sh repos.conf 플래그 파싱 스모크"
# 3번째 이후 필드가 플래그. 주석 줄 무시, 경로 자리 `-` 는 기본 경로 폴백(repo-dir.sh).
tmp=$(mktemp -d)
cat > "$tmp/repos.conf" <<'EOF'
# acme/commented /x link-secrets
acme/plain /path/to/plain
acme/flagged /path/to/flagged link-secrets
acme/multi /path/to/multi other-flag link-secrets
acme/dashpath - link-secrets
EOF
rflag() { ISSUE_RUNNER_REPOS_CONF="$tmp/repos.conf" bash scripts/repo-flag.sh "$1" link-secrets; }
rflag acme/flagged || { echo "  ✗ repo-flag: 플래그 있는 줄을 못 읽음"; rm -rf "$tmp"; exit 1; }
rflag acme/multi   || { echo "  ✗ repo-flag: 플래그 2개 중 뒤쪽을 못 읽음"; rm -rf "$tmp"; exit 1; }
if rflag acme/plain;     then echo "  ✗ repo-flag: 플래그 없는 줄이 통과"; rm -rf "$tmp"; exit 1; fi
if rflag acme/commented; then echo "  ✗ repo-flag: 주석 줄이 통과"; rm -rf "$tmp"; exit 1; fi
if rflag acme/absent;    then echo "  ✗ repo-flag: conf 에 없는 레포가 통과"; rm -rf "$tmp"; exit 1; fi
# conf 자체가 없으면 전부 off (기본 안전값)
if ISSUE_RUNNER_REPOS_CONF="$tmp/nope.conf" bash scripts/repo-flag.sh acme/flagged link-secrets; then
  echo "  ✗ repo-flag: conf 부재인데 통과"; rm -rf "$tmp"; exit 1
fi
# 경로 자리 `-` → 기본 경로 해석으로 폴백
out=$(ISSUE_RUNNER_REPOS_CONF="$tmp/repos.conf" ISSUE_RUNNER_PROJECTS_ROOT=/tmp \
  bash scripts/repo-dir.sh acme/dashpath)
[ "$out" = "/tmp/dashpath" ] || { echo "  ✗ repo-dir: '-' 경로 폴백 실패: $out"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[#109] make-worktree.sh 시크릿 심링크 opt-in 스모크 (기본 off·플래그 on·회수)"
# 기본은 워크트리에 라이브 시크릿을 안 깐다. repos.conf link-secrets 를 켠 레포에서만
# 심링크하고, 껐는데 이전에 깔린 심링크가 남아 있으면 회수한다.
mkwt="$PWD/scripts/make-worktree.sh"
tmp=$(mktemp -d); mkdir -p "$tmp/stub" "$tmp/proj"
printf '#!/bin/sh\ncase "$*" in *defaultBranchRef*) echo main ;; *) echo "" ;; esac\n' > "$tmp/stub/gh"
chmod +x "$tmp/stub/gh"
git init -q --bare "$tmp/origin.git"
git init -q -b main "$tmp/proj/r"
git -C "$tmp/proj/r" config user.email t@t; git -C "$tmp/proj/r" config user.name t
git -C "$tmp/proj/r" commit -q --allow-empty -m init
git -C "$tmp/proj/r" remote add origin "$tmp/origin.git"
git -C "$tmp/proj/r" push -q -u origin main
printf 'SECRET=live\n' > "$tmp/proj/r/.env"          # 메인 체크아웃의 라이브 시크릿
printf 'o/r - link-secrets\n' > "$tmp/on.conf"
printf 'o/r -\n'              > "$tmp/off.conf"
run_mkwt() {  # $1=conf $2=issue-num
  ISSUE_RUNNER_REPOS_CONF="$1" ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" PATH="$tmp/stub:$PATH" \
    bash "$mkwt" o/r "$2" 2>/dev/null
}
# (a) 플래그 off → 심링크 미생성
w=$(run_mkwt "$tmp/off.conf" 5)
[ -d "$w" ] || { echo "  ✗ make-worktree off: worktree 미생성"; rm -rf "$tmp"; exit 1; }
[ ! -e "$w/.env" ] || { echo "  ✗ make-worktree off: .env 가 워크트리에 깔림(유출 벡터 잔존)"; rm -rf "$tmp"; exit 1; }
# (b) 플래그 on → 심링크 생성 + 메인 파일을 가리킴
w=$(run_mkwt "$tmp/on.conf" 6)
[ -L "$w/.env" ] || { echo "  ✗ make-worktree on: .env 심링크 미생성"; rm -rf "$tmp"; exit 1; }
grep -q 'SECRET=live' "$w/.env" || { echo "  ✗ make-worktree on: 심링크가 메인 .env 를 안 가리킴"; rm -rf "$tmp"; exit 1; }
# (c) 같은 worktree 를 플래그 off 로 재실행 → 기존 심링크 회수
w=$(run_mkwt "$tmp/off.conf" 6)
[ ! -e "$w/.env" ] || { echo "  ✗ make-worktree 회수: 기존 .env 심링크가 안 지워짐"; rm -rf "$tmp"; exit 1; }
# (d) 워커가 만든 실제 파일은 회수 대상 아님(심링크만 지운다)
printf 'worker-local\n' > "$w/.env"
w=$(run_mkwt "$tmp/off.conf" 6)
[ -f "$w/.env" ] && ! [ -L "$w/.env" ] \
  || { echo "  ✗ make-worktree 회수: 심링크 아닌 실제 파일을 지웠다"; rm -rf "$tmp"; exit 1; }
# (e) 우리 대상이 아닌 심링크는 회수 대상 아님 — "우리가 만든 것만 지운다"가 계약.
printf 'other\n' > "$tmp/other.env"
rm -f "$w/.env"; ln -s "$tmp/other.env" "$w/.env"
w=$(run_mkwt "$tmp/off.conf" 6)
[ -L "$w/.env" ] && [ "$(readlink "$w/.env")" = "$tmp/other.env" ] \
  || { echo "  ✗ make-worktree 회수: 우리 것 아닌 심링크를 지웠다"; rm -rf "$tmp"; exit 1; }
# (f) 플래그 on 이어도 다른 대상의 심링크를 조용히 갈아끼우지 않는다.
w=$(run_mkwt "$tmp/on.conf" 6)
[ "$(readlink "$w/.env")" = "$tmp/other.env" ] \
  || { echo "  ✗ make-worktree on: 기존 심링크 대상을 덮어썼다"; rm -rf "$tmp"; exit 1; }
# (g) 깨진 심링크가 있어도 플래그 on 이 크래시하지 않는다 (`[ ! -e ]` 가 참이라
#     대상 확인 없이 ln -s 를 부르면 "File exists" 로 죽는 경로).
rm -f "$w/.env"; ln -s "$tmp/does-not-exist" "$w/.env"
rc=0; w=$(run_mkwt "$tmp/on.conf" 6) || rc=$?
[ "$rc" = 0 ] || { echo "  ✗ make-worktree on: 깨진 심링크에서 exit $rc (크래시)"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[#108] claim-issue.sh 원자적 잠금 스모크 (경합 1명만 통과·스테일 잠금 진행·fail-closed)"
# 잠금 = create-only ref(POST /git/refs). 상태 있는 gh 스텁(잠금 파일 카운터)으로
# 첫 호출만 201, 이후 422 를 내게 해 "정확히 하나만 claim" 을 검증한다.
claim="$PWD/scripts/claim-issue.sh"
tmp=$(mktemp -d); mkdir -p "$tmp/stub"
# 상태 있는 스텁: $tmp/lock = 잠금 ref 존재, $tmp/claimed = agent:claimed 부착됨.
# 사전 재확인(--json labels,state)은 **항상** OPEN·라벨 없음을 돌려준다 — 두 경쟁자가
# 원자화 이전처럼 나란히 게이트를 통과하는 상황을 고정 재현하기 위함(그래야 이 스모크가
# 잠금만 검증한다). 그 뒤의 조회(--json labels)는 실제 상태를 따른다.
cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"--json labels,state"*) echo '{"state":"OPEN","labels":[]}' ;;
  *"--json labels"*)
    if [ -f "$tmp/claimed" ]; then echo '{"labels":[{"name":"agent:claimed"}]}'
    else echo '{"labels":[]}'; fi ;;
  *"git/ref/heads/agent/issue-5"*) exit 1 ;;      # 원격 브랜치 없음 → 앵커 base
  *".default_branch"*) echo "main" ;;
  *"git/ref/heads/main"*) echo "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef" ;;   # 40자 hex — claim-issue.sh 가 앵커 sha 형태를 검증한다
  # 잠금 ref 와 takeover ref 는 **별개의 create-only 자원**이다 — 한 파일로 흉내내면
  # takeover 가 1차 잠금의 422 를 물려받아 스테일 인수 경로를 검증할 수 없다.
  #
  # 단 **D/F(디렉토리/파일) 충돌은 반드시 재현한다**: git ref 네임스페이스는 파일시스템
  # 처럼 동작해 앵커 ref 가 있으면 그 하위의 takeover 자식 ref 는 거부된다(실측: 422
  # \`Reference update failed\` — \`already exists\` 가 아니다). takeover 는 정의상 1차 잠금이
  # 있을 때만 시도되므로, 자식 경로를 쓰면 인수가 **항상** 실패한다. 이 규칙이 없으면
  # 스텁이 불가능한 동작을 성공으로 흉내내 그 회귀를 통째로 놓친다(실증: 그렇게 통과한
  # 스모크가 codex 재검증까지 CLEAN 을 받았다).
  # 패턴은 **앵커 무관**이어야 한다 — 자식형만 슬래시-takeover 를 포함하고 형제형(하이픈)은
  # 포함하지 않으므로, 앵커가 \`base\` 든 40자 sha 든 규칙이 그대로 성립한다. 리터럴 앵커에
  # 묶으면 앵커 형태가 바뀌는 순간 규칙이 조용히 무력화된다(전건 초록불 채로).
  *"git/refs"*"/takeover"*)
    echo '{"message":"Reference update failed","status":"422"}'; exit 1 ;;
  *"git/refs"*takeover*)
    if [ -f "$tmp/takeover" ]; then
      echo '{"message":"Reference already exists","status":"422"}'; exit 1
    fi
    : > "$tmp/takeover"; echo '{"ref":"refs/issue-runner/claim/5/base-takeover"}' ;;
  *"git/refs"*)
    if [ -f "$tmp/lock" ]; then
      echo '{"message":"Reference already exists","status":"422"}'; exit 1
    fi
    : > "$tmp/lock"; echo '{"ref":"refs/issue-runner/claim/5/base"}' ;;
  *"issue edit"*) : > "$tmp/claimed" ;;
  *) echo "" ;;
esac
STUB
chmod +x "$tmp/stub/gh"
run_claim() { PATH="$tmp/stub:$PATH" CLAIM_STALE_WAIT=0 bash "$claim" o/r 5 2>/dev/null; }
# (a) 경합: 사전 재확인은 둘 다 통과하지만 잠금은 하나만 잡는다. 패배자의 재조회는
#     승자가 붙인 agent:claimed 를 본다 → 정확히 1회만 "claimed:".
rm -f "$tmp/lock" "$tmp/claimed" "$tmp/takeover"
wins=0
rc=0; out=$(run_claim) || rc=$?
case "$out" in *"claimed: o/r#5"*) wins=$((wins + 1)) ;; esac
rc=0; out=$(run_claim) || rc=$?
case "$out" in *"claimed: o/r#5"*) wins=$((wins + 1)) ;; esac
[ "$wins" = 1 ] || { echo "  ✗ claim 경합: 통과 $wins 회 (기대 1 — 이중 claim)"; rm -rf "$tmp"; exit 1; }
[ "$rc" = 1 ] || { echo "  ✗ claim 경합: 패배자 exit $rc (기대 1)"; rm -rf "$tmp"; exit 1; }
# (b) 스테일 잠금: 잠금 ref 는 있는데(이전 attempt) 재조회에 agent:claimed 가 없다 →
#     죽은 attempt 의 잔여 잠금으로 보고 진행해야 한다(재디스패치가 영구히 막히면 안 됨).
rm -f "$tmp/claimed" "$tmp/takeover"; : > "$tmp/lock"  # 잠금만 남음(커밋 0 으로 죽은 attempt)
rc=0; out=$(run_claim) || rc=$?
case "$out" in
  *"claimed: o/r#5"*) : ;;
  *) echo "  ✗ claim 스테일 잠금: 재디스패치가 막혔다 (exit $rc out='$out')"; rm -rf "$tmp"; exit 1 ;;
esac
# (b2) 스테일 잠금에 **신규 세션 둘이 동시에** 들어오는 경우 — 1차 잠금은 이미 남이 만든
#      것이라 이들 사이의 중재력이 없다. takeover ref 가 중재하지 않으면 둘 다 라벨 없음을
#      보고 둘 다 claim 한다(원자성 재파괴). 정확히 1회만 통과해야 한다.
#
#      스모크는 두 호출을 순차로 돌리므로, 승자가 붙인 라벨을 패배자의 **1차 재조회**가
#      보면 takeover 에 닿기 전에 "경합 패배"로 닫혀 이 경로를 검증하지 못한다(동시 실행이
#      아닌 데서 오는 인공물). 그래서 재조회 응답을 호출별 카운터로 제어해 "둘 다 대기창
#      내내 라벨 없음" 을 고정한다 — 그러면 takeover 만이 유일한 중재자가 된다.
mkdir -p "$tmp/stub2"
cat > "$tmp/stub2/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"--json labels,state"*) echo '{"state":"OPEN","labels":[]}' ;;
  *"--json labels"*)
    n=0; [ -f "\$STUB_COUNTER" ] && n=\$(cat "\$STUB_COUNTER")
    n=\$((n + 1)); echo "\$n" > "\$STUB_COUNTER"
    # 앞의 STUB_EMPTY_UNTIL 회는 라벨 없음(= 잠금 후 재조회), 그 뒤는 부착됨(= post-check).
    if [ "\$n" -le "\$STUB_EMPTY_UNTIL" ]; then echo '{"labels":[]}'
    else echo '{"labels":[{"name":"agent:claimed"}]}'; fi ;;
  *"git/ref/heads/agent/issue-5"*) exit 1 ;;
  *".default_branch"*) echo "main" ;;
  *"git/ref/heads/main"*) echo "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef" ;;   # 40자 hex — claim-issue.sh 가 앵커 sha 형태를 검증한다
  # D/F 충돌 재현(메인 스텁과 동일 계약) — 자식 경로면 인수가 항상 실패해야 한다.
  *"git/refs"*"/takeover"*)
    echo '{"message":"Reference update failed","status":"422"}'; exit 1 ;;
  *"git/refs"*takeover*)
    if [ -f "$tmp/takeover" ]; then
      echo '{"message":"Reference already exists","status":"422"}'; exit 1
    fi
    : > "$tmp/takeover"; echo '{"ref":"x-takeover"}' ;;
  *"git/refs"*) echo '{"message":"Reference already exists","status":"422"}'; exit 1 ;;
  *"issue edit"*) : > "$tmp/claimed2" ;;
  *) echo "" ;;
esac
STUB
chmod +x "$tmp/stub2/gh"
rm -f "$tmp/takeover" "$tmp/claimed2" "$tmp/c1" "$tmp/c2"
wins=0
# 세션 A: 재조회 1회는 라벨 없음 → takeover 획득 → edit → post-check(2회차)는 부착 확인
outA=$(PATH="$tmp/stub2:$PATH" CLAIM_STALE_WAIT=0 STUB_COUNTER="$tmp/c1" STUB_EMPTY_UNTIL=1 \
  bash "$claim" o/r 5 2>&1) || true
case "$outA" in *"claimed: o/r#5"*) wins=$((wins + 1)) ;; esac
# 세션 B: 재조회(1회차)에 라벨 없음 → takeover 만이 중재 → 422 → 패배.
#   B 도 A 와 같은 EMPTY_UNTIL=1 을 쓴다 — 중재가 없으면 B 가 edit 까지 가고 그때의
#   post-check(2회차)는 부착을 보게 되므로, 이중 claim 이 `wins=2` 로 그대로 드러난다
#   (실환경 등가). B 를 항상-빈으로 두면 변이가 post-check 실패로 가려진다.
outB=$(PATH="$tmp/stub2:$PATH" CLAIM_STALE_WAIT=0 STUB_COUNTER="$tmp/c2" STUB_EMPTY_UNTIL=1 \
  bash "$claim" o/r 5 2>&1) || true
case "$outB" in *"claimed: o/r#5"*) wins=$((wins + 1)) ;; esac
[ "$wins" = 1 ] \
  || { echo "  ✗ claim 스테일 잠금 동시 2회: 통과 $wins 회 (기대 1 — 인수 중재 없이 이중 claim)"; rm -rf "$tmp"; exit 1; }
case "$outB" in
  *"인수 경합 패배"*) : ;;
  *) echo "  ✗ claim 스테일 잠금 동시 2회: 패배 사유가 인수 경합이 아니다 (outB='$outB')"; rm -rf "$tmp"; exit 1 ;;
esac
# (b3) takeover 까지 스테일(인수한 워커도 커밋 0 으로 사망) → fail-closed 로 닫는다.
#      인수의 인수를 허용하면 무한 후퇴 끝에 이중 claim 이 되므로 의도된 절충이다.
rm -f "$tmp/claimed"; : > "$tmp/lock"; : > "$tmp/takeover"
rc=0; out=$(run_claim) || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ claim takeover 스테일: exit $rc (기대 1 — fail-closed)"; rm -rf "$tmp"; exit 1; }
case "$out" in *"claimed:"*) echo "  ✗ claim takeover 스테일: claim 됨"; rm -rf "$tmp"; exit 1 ;; esac
[ ! -f "$tmp/claimed" ] || { echo "  ✗ claim takeover 스테일: 라벨 부착까지 진행됨"; rm -rf "$tmp"; exit 1; }
# fail-closed 케이스들의 판정 기준 — exit code·"claimed:" 부재만으로는 약하다.
# claim 을 진행했는데 그 뒤(post-check)에서 죽어도 같은 관측이 나오기 때문. 그래서
# "라벨 부착(gh issue edit)이 **아예 일어나지 않았다**"를 직접 단정한다. 아래 스텁들은
# issue edit 을 $tmp/claimed sentinel 로 기록하고, post-check 는 그 뒤라 통과시킨다.
assert_no_edit() {  # $1=케이스명 $2=rc $3=stdout
  [ "$2" = 1 ] || { echo "  ✗ claim $1: exit $2 (기대 1)"; rm -rf "$tmp"; exit 1; }
  case "$3" in *"claimed:"*) echo "  ✗ claim $1: claim 됨"; rm -rf "$tmp"; exit 1 ;; esac
  [ ! -f "$tmp/claimed" ] || { echo "  ✗ claim $1: 라벨 부착까지 진행됨(fail-open)"; rm -rf "$tmp"; exit 1; }
}
# (c) fail-closed: 잠금 생성이 422 아닌 이유로 실패하면 claim 하지 않는다.
cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"--json labels,state"*) echo '{"state":"OPEN","labels":[]}' ;;
  *"--json labels"*)
    if [ -f "$tmp/claimed" ]; then echo '{"labels":[{"name":"agent:claimed"}]}'
    else echo '{"labels":[]}'; fi ;;
  *"git/ref/heads/agent/issue-5"*) exit 1 ;;
  *".default_branch"*) echo "main" ;;
  *"git/ref/heads/main"*) echo "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef" ;;   # 40자 hex — claim-issue.sh 가 앵커 sha 형태를 검증한다
  *"git/refs"*) echo '{"message":"Bad credentials","status":"401"}'; exit 1 ;;
  *"issue edit"*) : > "$tmp/claimed" ;;
  *) echo "" ;;
esac
STUB
chmod +x "$tmp/stub/gh"
rm -f "$tmp/claimed"
rc=0; out=$(run_claim) || rc=$?
assert_no_edit "fail-closed(잠금 401)" "$rc" "$out"
# (d) 앵커 sha 조회 실패(기본 브랜치 미확인) → 잠금 없이 claim 금지
cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"--json labels,state"*) echo '{"state":"OPEN","labels":[]}' ;;
  *"--json labels"*)
    if [ -f "$tmp/claimed" ]; then echo '{"labels":[{"name":"agent:claimed"}]}'
    else echo '{"labels":[]}'; fi ;;
  *"git/ref/heads/agent/issue-5"*) exit 1 ;;
  *".default_branch"*) exit 1 ;;
  *"issue edit"*) : > "$tmp/claimed" ;;
  *) echo "" ;;
esac
STUB
chmod +x "$tmp/stub/gh"
rm -f "$tmp/claimed"
rc=0; out=$(run_claim) || rc=$?
assert_no_edit "기본 브랜치 조회 실패" "$rc" "$out"
# (d2) 기본 브랜치는 알아냈지만 그 head sha 를 못 읽는 경우 — (d) 는 기본 브랜치 가드에서
#      먼저 걸려 이 경로(앵커 sha 가드)를 지나가지 않으므로 따로 덮는다.
cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"--json labels,state"*) echo '{"state":"OPEN","labels":[]}' ;;
  *"--json labels"*)
    if [ -f "$tmp/claimed" ]; then echo '{"labels":[{"name":"agent:claimed"}]}'
    else echo '{"labels":[]}'; fi ;;
  *"git/ref/heads/agent/issue-5"*) exit 1 ;;
  *".default_branch"*) echo "main" ;;
  *"git/ref/heads/main"*) exit 1 ;;
  *"issue edit"*) : > "$tmp/claimed" ;;
  *) echo "" ;;
esac
STUB
chmod +x "$tmp/stub/gh"
rm -f "$tmp/claimed"
rc=0; out=$(run_claim) || rc=$?
assert_no_edit "앵커 sha 조회 실패" "$rc" "$out"
# (e) 잠금 후 재조회 자체가 실패 → 소유자 확인 불가 → claim 금지(fail-closed).
#     ("라벨 없음" 으로 대체하면 스테일 잠금으로 오인해 살아있는 소유자를 덮친다.)
#     재조회는 edit **전**이라 sentinel 이 없을 때만 실패시킨다 — post-check(edit 후)는
#     통과시켜야, 이 케이스가 "재조회에서 닫혔는지"를 post-check 사망과 구분해 잡는다.
cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"--json labels,state"*) echo '{"state":"OPEN","labels":[]}' ;;
  *"--json labels"*)
    if [ -f "$tmp/claimed" ]; then echo '{"labels":[{"name":"agent:claimed"}]}'; else exit 1; fi ;;
  *"git/ref/heads/agent/issue-5"*) exit 1 ;;
  *".default_branch"*) echo "main" ;;
  *"git/ref/heads/main"*) echo "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef" ;;   # 40자 hex — claim-issue.sh 가 앵커 sha 형태를 검증한다
  *"git/refs"*) echo '{"message":"Reference already exists","status":"422"}'; exit 1 ;;
  *"issue edit"*) : > "$tmp/claimed" ;;
  *) echo "" ;;
esac
STUB
chmod +x "$tmp/stub/gh"
rm -f "$tmp/claimed"
rc=0; out=$(run_claim) || rc=$?
assert_no_edit "잠금 후 재조회 실패" "$rc" "$out"
# (f) live-holder 지연 경합: 잠금은 남이 잡았고 라벨은 **늦게** 뜬다. 재조회가 1회면
#     "라벨 없음 = 스테일" 로 오판해 살아있는 소유자를 덮친다 → 대기창 안에서 반복
#     조회하다 라벨이 뜨면 패배로 접어야 한다. 스텁은 첫 조회에만 라벨을 숨긴다.
rm -f "$tmp/rechecks"
cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"--json labels,state"*) echo '{"state":"OPEN","labels":[]}' ;;
  *"--json labels"*)
    n=0; [ -f "$tmp/rechecks" ] && n=\$(cat "$tmp/rechecks")
    n=\$((n + 1)); echo "\$n" > "$tmp/rechecks"
    if [ "\$n" -le 1 ]; then echo '{"labels":[]}'
    else echo '{"labels":[{"name":"agent:claimed"}]}'; fi ;;
  *"git/ref/heads/agent/issue-5"*) exit 1 ;;
  *".default_branch"*) echo "main" ;;
  *"git/ref/heads/main"*) echo "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef" ;;   # 40자 hex — claim-issue.sh 가 앵커 sha 형태를 검증한다
  *"git/refs"*) echo '{"message":"Reference already exists","status":"422"}'; exit 1 ;;
  *"issue edit"*) : > "$tmp/claimed" ;;
  *) echo "" ;;
esac
STUB
chmod +x "$tmp/stub/gh"
rc=0
out=$(PATH="$tmp/stub:$PATH" CLAIM_STALE_WAIT=2 CLAIM_POLL_STEP=1 bash "$claim" o/r 5 2>/dev/null) || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ claim live-holder 지연: exit $rc (기대 1 — 살아있는 소유자를 덮쳤다)"; rm -rf "$tmp"; exit 1; }
case "$out" in *"claimed:"*) echo "  ✗ claim live-holder 지연: 늦게 뜬 라벨을 못 보고 claim 됨"; rm -rf "$tmp"; exit 1 ;; esac
[ "$(cat "$tmp/rechecks")" -ge 2 ] \
  || { echo "  ✗ claim live-holder 지연: 재조회가 1회뿐(대기창 폴링 미동작)"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[#108] SKILL 원자적 claim 잠금 문서화 검사 — 한/영 동기"
# 디스패치 4a 가 라벨이 아니라 create-only ref 로 중재한다는 지시가 한/영 양쪽에.
for f in SKILL.md SKILL.en.md; do
  awk 'BEGIN{RS="";ok=0} /claim-issue\.sh/ && /refs\/issue-runner\/claim/ {ok=1} END{exit ok?0:1}' "$f" \
    || { echo "  ✗ $f: claim-issue.sh 단락에 잠금 ref(refs/issue-runner/claim) 설명 없음"; exit 1; }
done

echo "[#109] 시크릿 opt-in(link-secrets) 문서화 검사 — README 한/영 + SKILL 한/영"
for f in README.md README.ko.md SKILL.md SKILL.en.md; do
  grep -qF 'link-secrets' "$f" || { echo "  ✗ $f 에 link-secrets 문서 없음"; exit 1; }
done

echo "[#132] 워커 PR 전 사전 리뷰(9-b) 문서화 검사 — README 한/영 + SKILL 한/영 + 템플릿 한/영"
for f in README.md README.ko.md SKILL.md SKILL.en.md references/worker-template.md references/worker-template.en.md; do
  grep -qF '9-b' "$f" || { echo "  ✗ $f 에 9-b 사전 리뷰 언급 없음"; exit 1; }
done
for f in references/worker-template.md references/worker-template.en.md; do
  grep -qE '^9-b\. ' "$f" || { echo "  ✗ $f 에 9-b 단계 없음"; exit 1; }
  for tok in 'subagent_type: "general-purpose"' 'origin/<DEFAULT_BRANCH>...HEAD' 'BLOCKER/WARN/NIT' 'CLEAN' '`Explore`'; do
    grep -qF "$tok" "$f" || { echo "  ✗ $f 9-b 계약 토큰 없음: $tok"; exit 1; }
  done
done
[ "$(grep -c '## 사전 리뷰' references/worker-template.md)" -ge 2 ] || { echo "  ✗ KO 템플릿 '## 사전 리뷰' 절 계약 2회 미만(9-b 기록 + 10단계 본문)"; exit 1; }
[ "$(grep -c '## Pre-review' references/worker-template.en.md)" -ge 2 ] || { echo "  ✗ EN 템플릿 '## Pre-review' 절 계약 2회 미만"; exit 1; }
grep -qF '## 사전 리뷰' SKILL.md || { echo "  ✗ SKILL.md 에 '## 사전 리뷰' 절 이름 없음"; exit 1; }
grep -qF '## Pre-review' SKILL.en.md || { echo "  ✗ SKILL.en.md 에 '## Pre-review' 절 이름 없음"; exit 1; }
grep -qF '예외 3' references/worker-template.md || { echo "  ✗ KO 템플릿 금지 목록 예외 3 없음"; exit 1; }
grep -qF 'Exception 3' references/worker-template.en.md || { echo "  ✗ EN 템플릿 Exception 3 없음"; exit 1; }
grep -qE '\*\*10분\*\*' references/worker-template.md || { echo "  ✗ KO 템플릿 fail-open 10분 표기 없음"; exit 1; }
grep -qE '\*\*10 minutes\*\*' references/worker-template.en.md || { echo "  ✗ EN 템플릿 fail-open 10 minutes 표기 없음"; exit 1; }

echo "[#147] 검증 사다리 배선 검사 — 네 문서가 사다리를 가리키고, 스킬·템플릿에 '이월' 이 없다"
# 실측 필요는 멈출 이유가 아니라 다음 할 일이다(Plans/live-verification-ladder.md). 사다리 참조가
# 빠지면 워커·검증·마감이 다시 "라이브 항목은 [ ]" 로 도망가고, "이월" 이라는 단어는 그 도망의
# 이름이라 스킬·템플릿 전체에서 금지한다.
[ -f references/live-verification-ladder.md ] || { echo "  ✗ references/live-verification-ladder.md 없음"; exit 1; }
for f in references/worker-template.md references/worker-template.en.md skills/verify-runner/SKILL.md skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  grep -qF "live-verification-ladder.md" "$f" || { echo "  ✗ $f: 검증 사다리 참조 없음"; exit 1; }
done
for f in SKILL.md SKILL.en.md skills/verify-runner/SKILL.md skills/closeout/SKILL.md skills/closeout/SKILL.en.md references/worker-template.md references/worker-template.en.md references/live-verification-ladder.md; do
  if grep -n "이월" "$f"; then echo "  ✗ $f: '이월' 등장 — 사다리를 올라 시도하고 출력을 인용하라"; exit 1; fi
done
for f in SKILL.md SKILL.en.md skills/verify-runner/SKILL.md skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  if grep -nE 'transition\.sh (verify-held|closeout-blocked|runner-held) [^\n]*' "$f" | grep -v -- '--reason' | grep -q .; then
    echo "  ✗ $f: --reason 없는 verify-held/closeout-blocked/runner-held 호출"; exit 1; fi
  # policy·conflict 사유엔 질문 한 줄(--note)이 없으면 사람 몫이 아니다(#155).
  if grep -nE 'transition\.sh [a-z-]+ <repo>[^\n]*--reason (policy|conflict)' "$f" | grep -v -- '--note' | grep -q .; then
    echo "  ✗ : --note 없는 --reason policy|conflict 호출 — 사람이 답해야 할 질문 한 줄을 적으라"; exit 1; fi
  # 맨 needs-human 산문 작성 금지(#151) — 사유 없는 사람 대기는 loop-status 가 warn 하고 재개 스윕이 거부한다.
  # 예외(#214): 4단계 배포 티켓의 발행 직후 라벨 보강 — needs-human 을 **deploy-wait 와 함께**
  # 붙이는 줄은 dispatch 홀드를 새로 만드는 게 아니라, 발행 명령이 이미 명시한 두 라벨이
  # 실제로 붙었는지 확인 후 그대로 되살리는 것뿐이다(hold:* 사유 라벨과 무관한 별개 티켓).
  if grep -nE -- '--add-label "?needs-human"?' "$f" | grep -v -- '--add-label deploy-wait' | grep -q .; then
    echo "  ✗ $f: 산문 --add-label needs-human — runner-held/verify-held/closeout-blocked --reason 을 쓰라"; exit 1; fi
done
for f in SKILL.md SKILL.en.md; do grep -qF "resume-sweep.sh" "$f" || { echo "  ✗ $f: 재개 스윕 배선 없음"; exit 1; }; done
# 루프 현황 대시보드(#163) — 세 루프 ④ Report 가 --post 로 게시해야 깃헙만 보고 현황을 안다.
for f in SKILL.md SKILL.en.md skills/verify-runner/SKILL.md skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  grep -qE 'loop-status\.sh --post (issue-runner|verify-runner|closeout)' "$f" || { echo "  ✗ $f: loop-status.sh --post 배선 없음"; exit 1; }
done

echo "[#144] 전이·스냅샷 스크립트 배선 문서화 검사 — 세 루프 SKILL + 워커 템플릿"
# 루프 문서가 산문 `gh issue edit` 대신 scripts/transition.sh(전이 표 SSOT)를 부르고,
# ④ Report 가 scripts/loop-status.sh 스냅샷을 붙이는지. 배선이 빠지면 라벨이 한쪽만
# 옮겨져 PR·이슈가 갈리고(다음 틱이 어긋난 쪽을 진실로 읽는다), 재고가 아무 보고에도
# 안 나온다.
for tok in 'transition.sh verify-pass' 'transition.sh verify-redispatch' \
           'transition.sh verify-held' 'loop-status.sh'; do
  grep -qF -- "$tok" skills/verify-runner/SKILL.md \
    || { echo "  ✗ skills/verify-runner/SKILL.md 에 '$tok' 배선 없음"; exit 1; }
done
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  for tok in 'transition.sh closeout-pick' 'transition.sh closeout-blocked' \
             'loop-status.sh' '--label spinoff' '--label deploy-wait'; do
    grep -qF -- "$tok" "$f" || { echo "  ✗ $f 에 '$tok' 배선 없음"; exit 1; }
  done
done
for f in SKILL.md SKILL.en.md; do
  grep -qF -- 'loop-status.sh' "$f" || { echo "  ✗ $f 에 loop-status.sh 스냅샷 배선 없음"; exit 1; }
done
for f in references/worker-template.md references/worker-template.en.md; do
  grep -qF -- 'transition.sh handoff-verify' "$f" \
    || { echo "  ✗ $f 에 transition.sh handoff-verify 배선 없음"; exit 1; }
done
# 전이 실패(exit 1 readback 불일치 · 2 gh 실패)를 조용히 넘기지 않는다는 보고 규약이
# 호출부 문서마다 살아 있는지. 이게 빠지면 라벨이 반쯤 이동한 채 루프가 다음으로 넘어간다.
# (문구는 파일마다 다르다 — 워커 템플릿은 종료 보고에 적는 `전이 실패: handoff-verify`,
#  루프 SKILL 은 ④ Report 에 올리는 `BLOCKED: …`, 영문 closeout 은 그 영어판.)
check_phrase() {
  grep -qF -- "$2" "$1" || { echo "  ✗ $1 에 전이 실패 보고 규약('$2') 없음"; exit 1; }
}
check_phrase skills/verify-runner/SKILL.md   'BLOCKED: 전이 실패'
check_phrase skills/closeout/SKILL.md        'BLOCKED: 전이 실패'
check_phrase skills/closeout/SKILL.en.md     'BLOCKED: transition failed'
check_phrase references/worker-template.md    '전이 실패: handoff-verify'
check_phrase references/worker-template.en.md '전이 실패: handoff-verify'
# 산문 회귀 가드 — 위 파일들에서 손수 라벨을 옮기는 형태가 되살아나면 실패.
# (`--add-label` 형태만 본다 — setup-labels.sh 설명·라벨 표의 라벨명 나열은 안 걸린다.)
for f in SKILL.md SKILL.en.md skills/verify-runner/SKILL.md \
         skills/closeout/SKILL.md skills/closeout/SKILL.en.md \
         references/worker-template.md references/worker-template.en.md; do
  if grep -nE -- '--add-label "?(flow:ready|flow:verify|harvesting)"?' "$f"; then
    echo "  ✗ $f: 산문 라벨 이동이 되살아남 — transition.sh 전이를 써라"
    exit 1
  fi
done

echo "[#185] 워커 템플릿 CI 큐 대기 규율 문서화 검사 — 한/영 동기"
# 워커가 run-local-ci.sh 큐 대기 중 조용히 턴을 끝내면 디스패처가 사망으로 오독한다
# (#185 배경). 직접호출 금지·중복실행 금지 규율과, 큐가 실제로 내는 두 실패 모드
# (폐기=HEAD 불일치·중단=짧은 타임아웃)가 워커 템플릿 9단계 한/영 양쪽에 있어야 한다.
for f in references/worker-template.md references/worker-template.en.md; do
  for tok in 'ci-queue.sh status' 'queue.log' '폐기' '중단(INT/TERM)' 'CI 대기 중'; do
    grep -qF -- "$tok" "$f" || { echo "  ✗ $f 에 CI 큐 대기 규율 토큰 없음: $tok"; exit 1; }
  done
  # 겹침 자가검사 회귀 가드 — `ps … | grep '[b]in/ci'` 는 다른 worktree·다른 레포의 CI 까지
  # 잡아 이 워커가 직렬 큐에 줄서는 것조차 막는다(#189 리뷰 P2). 되살아나면 실패.
  if grep -nF -- 'ps -Ao pid,etime,command' "$f"; then
    echo "  ✗ $f: 전역 bin/ci 자가검사가 되살아남 — 겹침은 ci-queue.sh 직렬화에 맡겨라"
    exit 1
  fi
done
grep -qF -- '겹침은 네가 막지 마라' references/worker-template.md \
  || { echo "  ✗ references/worker-template.md 에 '겹침 자가검사 금지' 불릿 없음"; exit 1; }
grep -qF -- 'Do not police overlap yourself' references/worker-template.en.md \
  || { echo "  ✗ references/worker-template.en.md 에 'Do not police overlap yourself' 불릿 없음"; exit 1; }
# 위 다섯 토큰은 언어불변(명령·로그 원문)이라 "bin/ci 직접호출 금지"(계획 항목 a)·
# "CI 무관한 일 먼저"(계획 항목 d) 두 불릿이 지워져도 안 걸린다 — 언어별 문구를 따로 문다.
grep -qF -- '`bin/ci` 를 직접 부르지 마라' references/worker-template.md \
  || { echo "  ✗ references/worker-template.md 에 'bin/ci 직접호출 금지' 불릿 없음"; exit 1; }
