echo "[test] loop-status.sh 파이프라인 스냅샷 버킷·창 필터·warn·부분 실패 (#144)"
bash scripts/tests/loop-status.test.sh
# (#276) 사다리 버킷은 "누가 들고 있나" 로 이름 짓는다 — 옛 버킷 문구(구현중·마감중·사람대기)가
# loop-status·README·스킬·테스트 어디에도 남지 않는다(이슈 #276 수용 기준의 grep 그대로).
# 산문이 옛 이름으로 대시보드 줄을 가리키면 사람이 없는 줄을 찾는다. 새 이름은 라벨/루프
# 이름 그 자체(issue-runner·verify-runner·closeout·needs-human)라 이 grep 이 오탐할 자리가 없다.
echo "[#276] 루프 현황 9줄 — 옛 버킷 문구(구현중·마감중·사람대기) 잔존 0건"
old_bucket_hits=$(grep -rn '구현중\|마감중\|사람대기' scripts README.ko.md README.md skills 2>/dev/null || true)
if [ -n "$old_bucket_hits" ]; then
  echo "  ✗ 옛 버킷 문구가 남아 있다 — issue-runner·closeout·needs-human 으로 (#276):"
  printf '%s\n' "$old_bucket_hits" | head -20 | sed 's/^/      /'
  exit 1
fi
# 9줄 렌더 계약 — RENDER_JQ 의 padded 리터럴에 새 이름 9개가 전부 있고 폭이 같다(15칸 = verify-runner 13 + 2).
for lit in '"waiting":"대기           "' '"claimed":"issue-runner   "' '"verify":"검증대기       "' \
           '"verifying":"verify-runner  "' '"ready":"마감대기       "' '"harvesting":"closeout       "' \
           '"held":"보류           "' '"human_wait":"needs-human    "' '"deploy_wait":"배포대기       "'; do
  grep -qF -- "$lit" scripts/loop-status.sh \
    || { echo "  ✗ scripts/loop-status.sh RENDER_JQ padded 에 $lit 이 없다 (#276 — 9줄 이름·15칸 폭)"; exit 1; }
done

# (#346) 보류 conflict 의 재개 횟수는 loop-status 가 `lib/loop.jq` 의 `unquoted` 로 인용을 걷고 센다 —
# 재개 스윕(resume-sweep.sh 의 JQ_UNQUOTE)과 **같은 정의**여야 대시보드 횟수와 스윕의 승격 판정이
# 같은 수를 본다. 정의 텍스트를 글자 단위로 대조한다(한쪽만 고치면 여기서 빨개진다).
echo "[#346] 인용 제거(def unquoted) — lib/loop.jq 와 resume-sweep.sh JQ_UNQUOTE 동일"
unq_lib=$(grep -o 'def unquoted:.*;' scripts/lib/loop.jq | head -1)
unq_sweep=$(grep -o 'def unquoted:.*;' scripts/resume-sweep.sh | head -1)
[ -n "$unq_lib" ] || { echo "  ✗ scripts/lib/loop.jq 에 def unquoted 가 없다 (#346)"; exit 1; }
[ -n "$unq_sweep" ] || { echo "  ✗ scripts/resume-sweep.sh 에 def unquoted(JQ_UNQUOTE) 가 없다 (#346)"; exit 1; }
[ "$unq_lib" = "$unq_sweep" ] \
  || { echo "  ✗ def unquoted 정의가 lib/loop.jq 와 resume-sweep.sh 에서 다르다 — 한 벌로 맞춰라 (#346)"; exit 1; }
# 소비 배선(loop-status 가 실제로 unquoted 로 걸러 세는가)은 문구 grep 이 아니라 동작으로 문다 —
# loop-status.test.sh 의 Holds #39(인용 마커 1 + 실제 마커 1 → `1/1`, `2/1` 아님).

echo "[test] epic-sweep.sh — leaf 전부 종료 에픽 자동 종료·전용 줄 판정·상한 보류·멱등 (#258)"
# closeout ① 이 `"$SCRIPTS/epic-sweep.sh"` 로 직접 exec 하므로 실행 비트도 여기서 문다
# (비트가 빠지면 조용히 exit 126 → 에픽 스윕이 매 틱 no-op 으로 degrade, PR#173 교훈과 동일 함정).
[ -x scripts/epic-sweep.sh ] || { echo "  ✗ epic-sweep.sh 실행 비트 없음"; exit 1; }
bash scripts/tests/epic-sweep.test.sh

