echo "[test] make-worktree.sh --sync 격자 — 원격 head 강제 동기화·더티 거부·untracked 무해·원격 부재 (#445)"
bash scripts/tests/make-worktree.test.sh

echo "[#206] 진행 증거 술어는 progress-evidence.sh 한 자리 (#200 → #206)"
# 커밋 신선도(STALL_MIN)와 CI 큐 티켓 판정을 다른 스크립트가 자기 벌로 들고 있으면 언젠가
# 한쪽만 고쳐져 두 소비자(timebox-check · finish-classify)가 다른 수를 센다 — 반송 마커
# 집합을 bounce-state.sh 한 자리에 묶은 것과 같은 규율(PR#191 교훈).
# 판정선은 **정의**다: 산문·주석의 언급(`STALL_MIN 이내` 등)은 사본이 아니므로 안 건다.
# (#427) `STALL_MIN` 의 값 정의는 `scripts/lib/constants.sh` 로 옮겼다 — 술어(`queue_alive`)는
# 여전히 progress-evidence.sh 한 자리다. 두 파일 밖에 정의가 생기면 여기서 빨개진다.
dup=$(grep -lE '^STALL_MIN=|^: "\$\{STALL_MIN:=|^queue_alive\(\)' scripts/*.sh scripts/lib/*.sh \
  | grep -v -e '^scripts/progress-evidence.sh$' -e '^scripts/lib/constants.sh$' || true)
[ -z "$dup" ] || { echo "  ✗ 진행 증거 술어 정의가 progress-evidence.sh 밖에도 있다: $dup"; exit 1; }
# 소비자 둘이 `"$SCRIPT_DIR/progress-evidence.sh"` 로 직접 exec 하므로 실행 비트를 문다
# (비트가 빠지면 조용히 exit 126 → 판정이 항상 빈 값이 되고, 그 degrade 가 timebox 는
#  unknown, finish-classify 는 active 로 조용히 새어 완결 유실 회수가 통째로 멈춘다).
[ -x scripts/progress-evidence.sh ] || { echo "  ✗ progress-evidence.sh 실행 비트 없음"; exit 1; }
for f in scripts/timebox-check.sh scripts/finish-classify.sh; do
  grep -qF 'progress-evidence.sh' "$f" || { echo "  ✗ $f 에 progress-evidence.sh 배선 없음"; exit 1; }
done
# 헬퍼 자체의 fail-closed 스모크 — 판정 입력이 형식 불량이면 `none`(증거 없음)이 아니라
# `unknown` 이어야 한다. 그 둘을 섞으면 호출자가 살아있는 워커를 죽인다(PR#139 교훈).
rc=0
out=$(scripts/progress-evidence.sh --now 1780000000 --commit-at "어제" --head-sha none 2>/dev/null) || rc=$?
case "$out $rc" in
  "unknown commit_at_invalid commit=- queue=- claim=- 2") : ;;
  *) echo "  ✗ progress-evidence: 형식 불량 커밋 시각 → '$out' rc=$rc (기대 unknown commit_at_invalid rc=2)"; exit 1 ;;
esac
# 진행 증거 ③(claim)도 같은 3값 어휘를 쓴다 — `unknown`(조회 실패)이 `none`(미부착)으로
# 접히면 조회 실패 한 번에 살아있는 워커의 claim 을 뗀다(#206 attempt 3).
rc=0
out=$(scripts/progress-evidence.sh --now 1780000000 --commit-at none --head-sha none \
  --claimed-at unknown 2>/dev/null) || rc=$?
case "$out $rc" in
  "unknown claimed_at_unknown commit=none queue=none claim=unknown 2") : ;;
  *) echo "  ✗ progress-evidence: claim 조회 실패 → '$out' rc=$rc (기대 unknown claimed_at_unknown rc=2)"; exit 1 ;;
esac
# 반대 방향 — `--claimed-at` 을 아예 안 주면 종전과 똑같이 ①② 만으로 판정한다(옵션 입력).
rc=0
out=$(scripts/progress-evidence.sh --now 1780000000 --commit-at none --head-sha none 2>/dev/null) || rc=$?
case "$out $rc" in
  "none no_progress commit=none queue=none claim=none 0") : ;;
  *) echo "  ✗ progress-evidence: claim 미지정 → '$out' rc=$rc (기대 none no_progress rc=0)"; exit 1 ;;
esac

echo "[#206] 현재 회차 시작 증거 — claim-at.sh 한 자리·ISSUE_TIMEBOX_HOURS 드리프트"
# `agent:claimed` 의 **부착 시각**은 첫 푸시 전 창을 덮는 유일한 신호다(#206 attempt 3
# codex BLOCKER). 조회가 한 자리(claim-at.sh)에 있어야 "존재로 판정하지 않는다"(#196 3항)와
# "부착 시각으로 판정한다"(#206)가 한 문서에서 갈리지 않는다.
[ -x scripts/claim-at.sh ] || { echo "  ✗ claim-at.sh 실행 비트 없음"; exit 1; }
# finish-classify 가 실제로 그 자리를 부르는지(배선). `claimed_arg` 가 사라지면 진행 증거
# ③ 이 조용히 꺼지고 격자 I 절만 빨개지는 게 아니라 **실호출 경로가 통째로 없어진다**.
# 패턴은 `-e` 로 넘긴다 — 맨몸으로 넘기면 `--claimed-at` 이 grep 옵션으로 먹혀 가드가
# 통과가 아니라 **usage 로 죽는다**(progress-evidence.sh:queue_alive 가 같은 함정을 주석에
# 적어 뒀다 — PR#202 교훈의 재판).
for token in 'claim-at.sh' 'claimed_arg' '--claimed-at'; do
  grep -qF -e "$token" -- scripts/finish-classify.sh \
    || { echo "  ✗ scripts/finish-classify.sh 에 $token 배선 없음"; exit 1; }
done
grep -qF -e '--claimed-at' -- scripts/progress-evidence.sh \
  || { echo "  ✗ scripts/progress-evidence.sh 에 --claimed-at 입력 없음"; exit 1; }
# claim 신선도 상한은 timebox 와 **같은 상수**다(두 자리가 같은 경계를 쓴다는 계약).
# 기본값이 갈리면 스윕과 ① Reconcile 이 서로 다른 창에서 같은 워커를 살리고 죽인다.
# (#427) 기본값의 한 자리는 `scripts/lib/constants.sh` 의 `: "${ISSUE_TIMEBOX_HOURS:=1}"` 다.
# 두 리더(timebox-check·progress-evidence)가 자기 기본값을 되살리면 이 검사가 2건을 본다.
tb_defaults=$(grep -ho 'ISSUE_TIMEBOX_HOURS:[-=][0-9]*' scripts/*.sh scripts/lib/*.sh | sort -u)
tb_n=$(printf '%s\n' "$tb_defaults" | grep -c . || true)
[ "$tb_n" -ge 1 ] \
  || { echo "  ✗ ISSUE_TIMEBOX_HOURS 기본값을 읽는 자리가 없다 — 가드가 의미를 잃었다"; exit 1; }
[ "$tb_n" = 1 ] \
  || { echo "  ✗ ISSUE_TIMEBOX_HOURS 기본값이 파일마다 다르다: $(printf '%s ' $tb_defaults)"; exit 1; }
for f in scripts/timebox-check.sh scripts/progress-evidence.sh; do
  grep -qF 'ISSUE_TIMEBOX_HOURS' "$f" \
    || { echo "  ✗ $f 가 ISSUE_TIMEBOX_HOURS 를 읽지 않는다 — 두 자리가 같은 상수를 써야 한다"; exit 1; }
done
# 입력 어휘 3값 스모크 (#206 회차2) — 호출자가 **조회 실패**를 말할 단어(`unknown`)를 갖고,
# 그것이 `none`(부재)과 다른 판정으로 나오는지. 이 어휘가 없으면 호출자는 결국 실패를
# `none` 으로 접고, 그 순간 살아 있는 워커가 재디스패치된다(회차1 BLOCKER).
rc=0
out=$(scripts/progress-evidence.sh --now 1780000000 --commit-at unknown --head-sha unknown 2>/dev/null) || rc=$?
case "$out $rc" in
  "unknown commit_at_unknown commit=unknown queue=- claim=- 2") : ;;
  *) echo "  ✗ progress-evidence: --commit-at unknown → '$out' rc=$rc (기대 unknown commit_at_unknown rc=2)"; exit 1 ;;
esac
rc=0
out=$(scripts/progress-evidence.sh --now 1780000000 --commit-at none --head-sha unknown 2>/dev/null) || rc=$?
case "$out $rc" in
  "unknown head_sha_unknown commit=none queue=unknown claim=- 2") : ;;
  *) echo "  ✗ progress-evidence: --head-sha unknown → '$out' rc=$rc (기대 unknown head_sha_unknown rc=2)"; exit 1 ;;
esac
# 과잉 보수 반증 — `none`(진짜 부재)은 여전히 `none no_progress` rc=0 이다(전부 unknown 으로
# 접으면 완결 유실 회수가 통째로 멈춘다).
rc=0
out=$(PE_QUEUE_LOG=/nonexistent/queue.log scripts/progress-evidence.sh \
  --now 1780000000 --commit-at none --head-sha none 2>/dev/null) || rc=$?
case "$out $rc" in
  "none no_progress commit=none queue=none claim=none 0") : ;;
  *) echo "  ✗ progress-evidence: --commit-at none → '$out' rc=$rc (기대 none no_progress rc=0)"; exit 1 ;;
esac
# 호출부 tripwire — head 조회의 **종료코드를 버리면**(`|| head_raw=''`) 실패가 부재로
# 둔갑한다(PR#139). 헬퍼가 아무리 3값을 구분해도 호출부가 삼키면 계약은 거기서 깨진다.
if grep -qE 'pr-head-at\.sh[^|]*\|\|[[:space:]]*head_raw=' scripts/finish-classify.sh; then
  echo "  ✗ finish-classify.sh: pr-head-at.sh 의 종료코드를 버린다(head_rc 로 보존하라)"; exit 1
fi
grep -qF 'head_lookup=unknown' scripts/finish-classify.sh \
  || { echo "  ✗ finish-classify.sh: 조회 실패를 기억하는 head_lookup 플래그가 없다"; exit 1; }

echo "[#206] 브랜치 이슈 추정은 head \`agent/issue-N\` 1순위 — 코드와 한/영 산문이 같은 계약"
# `claimed_arg` 가 이슈 인자 생략 시 고르는 이슈는 "이 PR 이 닫는 이슈" 가 아니라
# **"이 브랜치의 워커가 집어간 이슈"** 다. `closingIssuesReferences[0]` 은 닫는 이슈가 둘
# 이상일 때 남의 이슈를 가리킨다(실측 PR #113 head=`agent/issue-109` refs=`[108,109]`) —
# 그걸 물으면 claim 이 `none` 이 되어 살아있는 워커가 재디스패치된다(#206 회차3 BLOCKER).
#
# 행동 자체는 `scripts/tests/finish-classify.test.sh` 의 격자가 문다(뮤테이션 방증까지).
# 여기서 막는 것은 그 격자가 **못 보는 축**이다: 코드만 고치고 산문이 옛 계약을 계속
# 광고하면 다음 구현자가 되돌린다(PR#191 교훈 — 실제로 그 사고로 한 회차를 태웠다).
grep -qF 'headRefName' scripts/finish-classify.sh \
  || { echo "  ✗ finish-classify.sh 가 head(headRefName)를 안 묻는다 — 브랜치 이슈 추정이 [0] 로 되돌아갔다"; exit 1; }
grep -qF 'agent/issue-' scripts/finish-classify.sh \
  || { echo "  ✗ finish-classify.sh 가 head 의 agent/issue-N 을 파싱하지 않는다"; exit 1; }
# 한/영 산문이 **둘 다** head 1순위를 말해야 한다(한쪽만 고치면 두 독자가 다른 계약을 믿는다).
grep -qF '1순위' skills/closeout/SKILL.md \
  || { echo "  ✗ SKILL.md 가 head 1순위 계약을 안 적었다"; exit 1; }
grep -qF 'first' skills/closeout/SKILL.en.md \
  || { echo "  ✗ SKILL.en.md 가 head-first 계약을 안 적었다"; exit 1; }
# 그리고 **옛 계약 문장이 남아 있으면** 빨갛게 한다 — 새 문장을 덧붙이고 옛 문장을 안 지우는
# 것이 PR#191 이 실제로 겪은 실패 형태다.
if grep -qF '안 주면 `closingIssuesReferences` 로 한 번 묻는다' skills/closeout/SKILL.md; then
  echo "  ✗ SKILL.md 에 옛 계약 문장이 남아 있다(closingIssuesReferences 로 묻는다)"; exit 1
fi
if grep -qF 'asks `closingIssuesReferences` once when omitted' skills/closeout/SKILL.en.md; then
  echo "  ✗ SKILL.en.md 에 옛 계약 문장이 남아 있다"; exit 1
fi

echo "[#206] iso_to_epoch 형식 패턴은 모든 사본에서 동일 (한쪽만 느슨해지면 조용히 갈린다)"
# finish-classify.sh 와 progress-evidence.sh 는 같은 시각 문자열을 각자 파싱한다. 패턴이
# 갈리면 한쪽은 성공·한쪽은 `commit_at_invalid` 가 되어 🔄 계열 회수가 통째로 멈춘다
# (전자는 판정을 내고 후자는 항상 active 를 만든다).
pat_count=$(grep -h -o '\[0-9\]\[0-9\]\[0-9\]\[0-9\]-\[0-9\]\[0-9\]-.*Z) ;;' scripts/*.sh | sort -u | wc -l | tr -d ' ')
[ "$pat_count" = 1 ] || {
  echo "  ✗ iso_to_epoch 형식 패턴이 ${pat_count}가지다 — 한 문장으로 통일하라:"
  grep -hn -o '\[0-9\]\[0-9\]\[0-9\]\[0-9\]-\[0-9\]\[0-9\]-.*Z) ;;' scripts/*.sh | sort -u | sed 's/^/      /'
  exit 1; }
for f in $(grep -l '^iso_to_epoch()' scripts/*.sh); do
  grep -qF '[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z) ;;' "$f" \
    || { echo "  ✗ $f: iso_to_epoch 에 형식 검사가 없다(GNU date 가 빈 값을 통과시킨다)"; exit 1; }
done

echo "[test] timebox-check.sh 진행 증거 판정·queue.log 마지막 줄·유예 상한 (#200)"
# 디스패처가 `"$SCRIPTS/timebox-check.sh"` 로 직접 exec 하므로 실행 비트도 여기서 문다
# (비트가 빠지면 조용히 exit 126 → 판정 줄이 빈 값이 되고 그 이슈의 timebox 가 무판정으로 샌다).
[ -x scripts/timebox-check.sh ] || { echo "  ✗ timebox-check.sh 실행 비트 없음"; exit 1; }
bash scripts/tests/timebox-check.test.sh

echo "[test] lessons-trim.sh lessons-verifier.md 캡 수렴 정리 — 항목 정의·오래된 순 삭제·멱등·append 잠금 (#208)"
# closeout 1·6단계가 append 직후 `$SCRIPTS/lessons-trim.sh append <파일> 20 "<줄>"`
# 한 자리로 부르는 계약이므로 실행 비트도 여기서 문다(비트가 빠지면 exit 126 → 캡
# 정리가 조용히 no-op 으로 degrade, PR#173 교훈과 동일 함정).
[ -x scripts/lessons-trim.sh ] || { echo "  ✗ lessons-trim.sh 실행 비트 없음"; exit 1; }
bash scripts/tests/lessons-trim.test.sh

echo "[#200] timebox 진행 증거 판정 배선 검사 — 한/영 SKILL 동기"
# 상수(STALL_MIN·MAX_TIMEBOX_GRACE) + 판정자 호출이 한/영 양쪽에 있어야 한다. 스크립트만
# 고치고 프롬프트에 옛 규칙("경과가 넘으면 중단")이 남으면 **디스패처는 옛 규칙을 따른다** —
# 이 루프에서 실제로 판정하는 것은 프롬프트다.
for f in SKILL.md SKILL.en.md; do
  for token in 'STALL_MIN' 'MAX_TIMEBOX_GRACE' 'timebox-check.sh'; do
    grep -qF "$token" "$f" \
      || { echo "  ✗ $f 에 $token 배선 없음"; exit 1; }
  done
done
# 값 드리프트 검사 — 종전엔 "스크립트 기본값 == SKILL 이 적은 값" 을 대조했다. (#427) 이제
# 값은 `scripts/lib/constants.sh` **한 자리**에만 있고 SKILL 은 이름과 뜻만 적으므로, 대조 대신
# **값이 문서로 되살아나지 않았는지**를 문다 — 두 벌이 없으면 드리프트도 없다.
#   ⑴ 상수 파일에 기본값이 있는가(SSOT 가 비면 소비처가 `set -u` 로 죽는다)
#   ⑵ SKILL 이 그 이름을 부르고 상수 파일을 가리키는가(디스패처가 값을 찾아갈 경로)
#   ⑶ SKILL 에 `이름 = 숫자` 가 되살아나지 않았는가(두 벌 복원 금지)
# 만료 조건: `## 상수` 절이 값을 적지 않는 형태를 유지하는 한 이 검사가 그 형태의 강제자다.
for name in STALL_MIN MAX_TIMEBOX_GRACE ISSUE_TIMEBOX_HOURS; do
  want=$(sed -n "s/^: \"\${$name:=\([0-9][0-9]*\)}\".*/\1/p" scripts/lib/constants.sh | head -1)
  [ -n "$want" ] || { echo "  ✗ scripts/lib/constants.sh 에서 $name 기본값을 읽지 못함"; exit 1; }
  for f in SKILL.md SKILL.en.md; do
    grep -qF "$name" "$f" \
      || { echo "  ✗ $f 에 $name 이름이 없다 — 디스패처가 그 경계를 모른다"; exit 1; }
    grep -qF 'scripts/lib/constants.sh' "$f" \
      || { echo "  ✗ $f 가 값의 자리(scripts/lib/constants.sh)를 가리키지 않는다 (#427)"; exit 1; }
    if grep -qE "\`$name = [0-9]" "$f"; then
      echo "  ✗ $f 가 $name 값을 다시 적었다 — 값은 scripts/lib/constants.sh 한 자리다 (#427)"; exit 1
    fi
  done
done

echo "[#109] repo-flag.sh repos.conf 플래그 파싱 스모크"
# 3번째 이후 필드가 플래그. 주석 줄 무시, 경로 자리 `-` 는 기본 경로 폴백(repo-dir.sh).
tmp=$(mktemp -d)
cat > "$tmp/repos.conf" <<'EOF'
# acme/commented /x link-secrets
acme/plain /path/to/plain
acme/flagged /path/to/flagged link-secrets
acme/multi /path/to/multi other-flag link-secrets
acme/dashpath - link-secrets
EOF
rflag() { ISSUE_RUNNER_REPOS_CONF="$tmp/repos.conf" bash scripts/repo-flag.sh "$1" link-secrets; }
rflag acme/flagged || { echo "  ✗ repo-flag: 플래그 있는 줄을 못 읽음"; rm -rf "$tmp"; exit 1; }
rflag acme/multi   || { echo "  ✗ repo-flag: 플래그 2개 중 뒤쪽을 못 읽음"; rm -rf "$tmp"; exit 1; }
if rflag acme/plain;     then echo "  ✗ repo-flag: 플래그 없는 줄이 통과"; rm -rf "$tmp"; exit 1; fi
if rflag acme/commented; then echo "  ✗ repo-flag: 주석 줄이 통과"; rm -rf "$tmp"; exit 1; fi
if rflag acme/absent;    then echo "  ✗ repo-flag: conf 에 없는 레포가 통과"; rm -rf "$tmp"; exit 1; fi
# conf 자체가 없으면 전부 off (기본 안전값)
if ISSUE_RUNNER_REPOS_CONF="$tmp/nope.conf" bash scripts/repo-flag.sh acme/flagged link-secrets; then
  echo "  ✗ repo-flag: conf 부재인데 통과"; rm -rf "$tmp"; exit 1
fi
# 경로 자리 `-` → 기본 경로 해석으로 폴백
out=$(ISSUE_RUNNER_REPOS_CONF="$tmp/repos.conf" ISSUE_RUNNER_PROJECTS_ROOT=/tmp \
  bash scripts/repo-dir.sh acme/dashpath)
[ "$out" = "/tmp/dashpath" ] || { echo "  ✗ repo-dir: '-' 경로 폴백 실패: $out"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[#109] make-worktree.sh 시크릿 심링크 opt-in 스모크 (기본 off·플래그 on·회수)"
# 기본은 워크트리에 라이브 시크릿을 안 깐다. repos.conf link-secrets 를 켠 레포에서만
# 심링크하고, 껐는데 이전에 깔린 심링크가 남아 있으면 회수한다.
mkwt="$PWD/scripts/make-worktree.sh"
tmp=$(mktemp -d); mkdir -p "$tmp/stub" "$tmp/proj"
printf '#!/bin/sh\ncase "$*" in *defaultBranchRef*) echo main ;; *) echo "" ;; esac\n' > "$tmp/stub/gh"
chmod +x "$tmp/stub/gh"
git init -q --bare "$tmp/origin.git"
git init -q -b main "$tmp/proj/r"
git -C "$tmp/proj/r" config user.email t@t; git -C "$tmp/proj/r" config user.name t
git -C "$tmp/proj/r" commit -q --allow-empty -m init
git -C "$tmp/proj/r" remote add origin "$tmp/origin.git"
git -C "$tmp/proj/r" push -q -u origin main
printf 'SECRET=live\n' > "$tmp/proj/r/.env"          # 메인 체크아웃의 라이브 시크릿
printf 'o/r - link-secrets\n' > "$tmp/on.conf"
printf 'o/r -\n'              > "$tmp/off.conf"
run_mkwt() {  # $1=conf $2=issue-num
  ISSUE_RUNNER_REPOS_CONF="$1" ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" PATH="$tmp/stub:$PATH" \
    bash "$mkwt" o/r "$2" 2>/dev/null
}
# (a) 플래그 off → 심링크 미생성
w=$(run_mkwt "$tmp/off.conf" 5)
[ -d "$w" ] || { echo "  ✗ make-worktree off: worktree 미생성"; rm -rf "$tmp"; exit 1; }
[ ! -e "$w/.env" ] || { echo "  ✗ make-worktree off: .env 가 워크트리에 깔림(유출 벡터 잔존)"; rm -rf "$tmp"; exit 1; }
# (b) 플래그 on → 심링크 생성 + 메인 파일을 가리킴
w=$(run_mkwt "$tmp/on.conf" 6)
[ -L "$w/.env" ] || { echo "  ✗ make-worktree on: .env 심링크 미생성"; rm -rf "$tmp"; exit 1; }
grep -q 'SECRET=live' "$w/.env" || { echo "  ✗ make-worktree on: 심링크가 메인 .env 를 안 가리킴"; rm -rf "$tmp"; exit 1; }
# (c) 같은 worktree 를 플래그 off 로 재실행 → 기존 심링크 회수
w=$(run_mkwt "$tmp/off.conf" 6)
[ ! -e "$w/.env" ] || { echo "  ✗ make-worktree 회수: 기존 .env 심링크가 안 지워짐"; rm -rf "$tmp"; exit 1; }
# (d) 워커가 만든 실제 파일은 회수 대상 아님(심링크만 지운다)
printf 'worker-local\n' > "$w/.env"
w=$(run_mkwt "$tmp/off.conf" 6)
[ -f "$w/.env" ] && ! [ -L "$w/.env" ] \
  || { echo "  ✗ make-worktree 회수: 심링크 아닌 실제 파일을 지웠다"; rm -rf "$tmp"; exit 1; }
# (e) 우리 대상이 아닌 심링크는 회수 대상 아님 — "우리가 만든 것만 지운다"가 계약.
printf 'other\n' > "$tmp/other.env"
rm -f "$w/.env"; ln -s "$tmp/other.env" "$w/.env"
w=$(run_mkwt "$tmp/off.conf" 6)
[ -L "$w/.env" ] && [ "$(readlink "$w/.env")" = "$tmp/other.env" ] \
  || { echo "  ✗ make-worktree 회수: 우리 것 아닌 심링크를 지웠다"; rm -rf "$tmp"; exit 1; }
# (f) 플래그 on 이어도 다른 대상의 심링크를 조용히 갈아끼우지 않는다.
w=$(run_mkwt "$tmp/on.conf" 6)
[ "$(readlink "$w/.env")" = "$tmp/other.env" ] \
  || { echo "  ✗ make-worktree on: 기존 심링크 대상을 덮어썼다"; rm -rf "$tmp"; exit 1; }
# (g) 깨진 심링크가 있어도 플래그 on 이 크래시하지 않는다 (`[ ! -e ]` 가 참이라
#     대상 확인 없이 ln -s 를 부르면 "File exists" 로 죽는 경로).
rm -f "$w/.env"; ln -s "$tmp/does-not-exist" "$w/.env"
rc=0; w=$(run_mkwt "$tmp/on.conf" 6) || rc=$?
[ "$rc" = 0 ] || { echo "  ✗ make-worktree on: 깨진 심링크에서 exit $rc (크래시)"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[#108] claim-issue.sh 원자적 잠금 스모크 (경합 1명만 통과·스테일 잠금 진행·fail-closed)"
# 잠금 = create-only ref(POST /git/refs). 상태 있는 gh 스텁(잠금 파일 카운터)으로
# 첫 호출만 201, 이후 422 를 내게 해 "정확히 하나만 claim" 을 검증한다.
claim="$PWD/scripts/claim-issue.sh"
tmp=$(mktemp -d); mkdir -p "$tmp/stub"
# 상태 있는 스텁: $tmp/lock = 잠금 ref 존재, $tmp/claimed = agent:claimed 부착됨.
# 사전 재확인(--json labels,state)은 **항상** OPEN·라벨 없음을 돌려준다 — 두 경쟁자가
# 원자화 이전처럼 나란히 게이트를 통과하는 상황을 고정 재현하기 위함(그래야 이 스모크가
# 잠금만 검증한다). 그 뒤의 조회(--json labels)는 실제 상태를 따른다.
cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"--json labels,state"*) echo '{"state":"OPEN","labels":[]}' ;;
  *"--json labels"*)
    if [ -f "$tmp/claimed" ]; then echo '{"labels":[{"name":"agent:claimed"}]}'
    else echo '{"labels":[]}'; fi ;;
  *"git/ref/heads/agent/issue-5"*) exit 1 ;;      # 원격 브랜치 없음 → 앵커 base
  *".default_branch"*) echo "main" ;;
  *"git/ref/heads/main"*) echo "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef" ;;   # 40자 hex — claim-issue.sh 가 앵커 sha 형태를 검증한다
  # 잠금 ref 와 takeover ref 는 **별개의 create-only 자원**이다 — 한 파일로 흉내내면
  # takeover 가 1차 잠금의 422 를 물려받아 스테일 인수 경로를 검증할 수 없다.
  #
  # 단 **D/F(디렉토리/파일) 충돌은 반드시 재현한다**: git ref 네임스페이스는 파일시스템
  # 처럼 동작해 앵커 ref 가 있으면 그 하위의 takeover 자식 ref 는 거부된다(실측: 422
  # \`Reference update failed\` — \`already exists\` 가 아니다). takeover 는 정의상 1차 잠금이
  # 있을 때만 시도되므로, 자식 경로를 쓰면 인수가 **항상** 실패한다. 이 규칙이 없으면
  # 스텁이 불가능한 동작을 성공으로 흉내내 그 회귀를 통째로 놓친다(실증: 그렇게 통과한
  # 스모크가 codex 재검증까지 CLEAN 을 받았다).
  # 패턴은 **앵커 무관**이어야 한다 — 자식형만 슬래시-takeover 를 포함하고 형제형(하이픈)은
  # 포함하지 않으므로, 앵커가 \`base\` 든 40자 sha 든 규칙이 그대로 성립한다. 리터럴 앵커에
  # 묶으면 앵커 형태가 바뀌는 순간 규칙이 조용히 무력화된다(전건 초록불 채로).
  *"git/refs"*"/takeover"*)
    echo '{"message":"Reference update failed","status":"422"}'; exit 1 ;;
  *"git/refs"*takeover*)
    if [ -f "$tmp/takeover" ]; then
      echo '{"message":"Reference already exists","status":"422"}'; exit 1
    fi
    : > "$tmp/takeover"; echo '{"ref":"refs/issue-runner/claim/5/base-takeover"}' ;;
  *"git/refs"*)
    if [ -f "$tmp/lock" ]; then
      echo '{"message":"Reference already exists","status":"422"}'; exit 1
    fi
    : > "$tmp/lock"; echo '{"ref":"refs/issue-runner/claim/5/base"}' ;;
  *"issue edit"*) : > "$tmp/claimed" ;;
  *) echo "" ;;
esac
STUB
chmod +x "$tmp/stub/gh"
run_claim() { PATH="$tmp/stub:$PATH" CLAIM_STALE_WAIT=0 bash "$claim" o/r 5 2>/dev/null; }
# (a) 경합: 사전 재확인은 둘 다 통과하지만 잠금은 하나만 잡는다. 패배자의 재조회는
#     승자가 붙인 agent:claimed 를 본다 → 정확히 1회만 "claimed:".
rm -f "$tmp/lock" "$tmp/claimed" "$tmp/takeover"
wins=0
rc=0; out=$(run_claim) || rc=$?
case "$out" in *"claimed: o/r#5"*) wins=$((wins + 1)) ;; esac
rc=0; out=$(run_claim) || rc=$?
case "$out" in *"claimed: o/r#5"*) wins=$((wins + 1)) ;; esac
[ "$wins" = 1 ] || { echo "  ✗ claim 경합: 통과 $wins 회 (기대 1 — 이중 claim)"; rm -rf "$tmp"; exit 1; }
[ "$rc" = 1 ] || { echo "  ✗ claim 경합: 패배자 exit $rc (기대 1)"; rm -rf "$tmp"; exit 1; }
# (b) 스테일 잠금: 잠금 ref 는 있는데(이전 attempt) 재조회에 agent:claimed 가 없다 →
#     죽은 attempt 의 잔여 잠금으로 보고 진행해야 한다(재디스패치가 영구히 막히면 안 됨).
rm -f "$tmp/claimed" "$tmp/takeover"; : > "$tmp/lock"  # 잠금만 남음(커밋 0 으로 죽은 attempt)
rc=0; out=$(run_claim) || rc=$?
case "$out" in
  *"claimed: o/r#5"*) : ;;
  *) echo "  ✗ claim 스테일 잠금: 재디스패치가 막혔다 (exit $rc out='$out')"; rm -rf "$tmp"; exit 1 ;;
esac
# (b2) 스테일 잠금에 **신규 세션 둘이 동시에** 들어오는 경우 — 1차 잠금은 이미 남이 만든
#      것이라 이들 사이의 중재력이 없다. takeover ref 가 중재하지 않으면 둘 다 라벨 없음을
#      보고 둘 다 claim 한다(원자성 재파괴). 정확히 1회만 통과해야 한다.
#
#      스모크는 두 호출을 순차로 돌리므로, 승자가 붙인 라벨을 패배자의 **1차 재조회**가
#      보면 takeover 에 닿기 전에 "경합 패배"로 닫혀 이 경로를 검증하지 못한다(동시 실행이
#      아닌 데서 오는 인공물). 그래서 재조회 응답을 호출별 카운터로 제어해 "둘 다 대기창
#      내내 라벨 없음" 을 고정한다 — 그러면 takeover 만이 유일한 중재자가 된다.
mkdir -p "$tmp/stub2"
cat > "$tmp/stub2/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"--json labels,state"*) echo '{"state":"OPEN","labels":[]}' ;;
  *"--json labels"*)
    n=0; [ -f "\$STUB_COUNTER" ] && n=\$(cat "\$STUB_COUNTER")
    n=\$((n + 1)); echo "\$n" > "\$STUB_COUNTER"
    # 앞의 STUB_EMPTY_UNTIL 회는 라벨 없음(= 잠금 후 재조회), 그 뒤는 부착됨(= post-check).
    if [ "\$n" -le "\$STUB_EMPTY_UNTIL" ]; then echo '{"labels":[]}'
    else echo '{"labels":[{"name":"agent:claimed"}]}'; fi ;;
  *"git/ref/heads/agent/issue-5"*) exit 1 ;;
  *".default_branch"*) echo "main" ;;
  *"git/ref/heads/main"*) echo "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef" ;;   # 40자 hex — claim-issue.sh 가 앵커 sha 형태를 검증한다
  # D/F 충돌 재현(메인 스텁과 동일 계약) — 자식 경로면 인수가 항상 실패해야 한다.
  *"git/refs"*"/takeover"*)
    echo '{"message":"Reference update failed","status":"422"}'; exit 1 ;;
  *"git/refs"*takeover*)
    if [ -f "$tmp/takeover" ]; then
      echo '{"message":"Reference already exists","status":"422"}'; exit 1
    fi
    : > "$tmp/takeover"; echo '{"ref":"x-takeover"}' ;;
  *"git/refs"*) echo '{"message":"Reference already exists","status":"422"}'; exit 1 ;;
  *"issue edit"*) : > "$tmp/claimed2" ;;
  *) echo "" ;;
esac
STUB
chmod +x "$tmp/stub2/gh"
rm -f "$tmp/takeover" "$tmp/claimed2" "$tmp/c1" "$tmp/c2"
wins=0
# 세션 A: 재조회 1회는 라벨 없음 → takeover 획득 → edit → post-check(2회차)는 부착 확인
outA=$(PATH="$tmp/stub2:$PATH" CLAIM_STALE_WAIT=0 STUB_COUNTER="$tmp/c1" STUB_EMPTY_UNTIL=1 \
  bash "$claim" o/r 5 2>&1) || true
case "$outA" in *"claimed: o/r#5"*) wins=$((wins + 1)) ;; esac
# 세션 B: 재조회(1회차)에 라벨 없음 → takeover 만이 중재 → 422 → 패배.
#   B 도 A 와 같은 EMPTY_UNTIL=1 을 쓴다 — 중재가 없으면 B 가 edit 까지 가고 그때의
#   post-check(2회차)는 부착을 보게 되므로, 이중 claim 이 `wins=2` 로 그대로 드러난다
#   (실환경 등가). B 를 항상-빈으로 두면 변이가 post-check 실패로 가려진다.
outB=$(PATH="$tmp/stub2:$PATH" CLAIM_STALE_WAIT=0 STUB_COUNTER="$tmp/c2" STUB_EMPTY_UNTIL=1 \
  bash "$claim" o/r 5 2>&1) || true
case "$outB" in *"claimed: o/r#5"*) wins=$((wins + 1)) ;; esac
[ "$wins" = 1 ] \
  || { echo "  ✗ claim 스테일 잠금 동시 2회: 통과 $wins 회 (기대 1 — 인수 중재 없이 이중 claim)"; rm -rf "$tmp"; exit 1; }
case "$outB" in
  *"인수 경합 패배"*) : ;;
  *) echo "  ✗ claim 스테일 잠금 동시 2회: 패배 사유가 인수 경합이 아니다 (outB='$outB')"; rm -rf "$tmp"; exit 1 ;;
esac
# (b3) takeover 까지 스테일(인수한 워커도 커밋 0 으로 사망) → fail-closed 로 닫는다.
#      인수의 인수를 허용하면 무한 후퇴 끝에 이중 claim 이 되므로 의도된 절충이다.
rm -f "$tmp/claimed"; : > "$tmp/lock"; : > "$tmp/takeover"
rc=0; out=$(run_claim) || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ claim takeover 스테일: exit $rc (기대 1 — fail-closed)"; rm -rf "$tmp"; exit 1; }
case "$out" in *"claimed:"*) echo "  ✗ claim takeover 스테일: claim 됨"; rm -rf "$tmp"; exit 1 ;; esac
[ ! -f "$tmp/claimed" ] || { echo "  ✗ claim takeover 스테일: 라벨 부착까지 진행됨"; rm -rf "$tmp"; exit 1; }
# fail-closed 케이스들의 판정 기준 — exit code·"claimed:" 부재만으로는 약하다.
# claim 을 진행했는데 그 뒤(post-check)에서 죽어도 같은 관측이 나오기 때문. 그래서
# "라벨 부착(gh issue edit)이 **아예 일어나지 않았다**"를 직접 단정한다. 아래 스텁들은
# issue edit 을 $tmp/claimed sentinel 로 기록하고, post-check 는 그 뒤라 통과시킨다.
assert_no_edit() {  # $1=케이스명 $2=rc $3=stdout
  [ "$2" = 1 ] || { echo "  ✗ claim $1: exit $2 (기대 1)"; rm -rf "$tmp"; exit 1; }
  case "$3" in *"claimed:"*) echo "  ✗ claim $1: claim 됨"; rm -rf "$tmp"; exit 1 ;; esac
  [ ! -f "$tmp/claimed" ] || { echo "  ✗ claim $1: 라벨 부착까지 진행됨(fail-open)"; rm -rf "$tmp"; exit 1; }
}
# (c) fail-closed: 잠금 생성이 422 아닌 이유로 실패하면 claim 하지 않는다.
cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"--json labels,state"*) echo '{"state":"OPEN","labels":[]}' ;;
  *"--json labels"*)
    if [ -f "$tmp/claimed" ]; then echo '{"labels":[{"name":"agent:claimed"}]}'
    else echo '{"labels":[]}'; fi ;;
  *"git/ref/heads/agent/issue-5"*) exit 1 ;;
  *".default_branch"*) echo "main" ;;
  *"git/ref/heads/main"*) echo "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef" ;;   # 40자 hex — claim-issue.sh 가 앵커 sha 형태를 검증한다
  *"git/refs"*) echo '{"message":"Bad credentials","status":"401"}'; exit 1 ;;
  *"issue edit"*) : > "$tmp/claimed" ;;
  *) echo "" ;;
esac
STUB
chmod +x "$tmp/stub/gh"
rm -f "$tmp/claimed"
rc=0; out=$(run_claim) || rc=$?
assert_no_edit "fail-closed(잠금 401)" "$rc" "$out"
# (d) 앵커 sha 조회 실패(기본 브랜치 미확인) → 잠금 없이 claim 금지
cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"--json labels,state"*) echo '{"state":"OPEN","labels":[]}' ;;
  *"--json labels"*)
    if [ -f "$tmp/claimed" ]; then echo '{"labels":[{"name":"agent:claimed"}]}'
    else echo '{"labels":[]}'; fi ;;
  *"git/ref/heads/agent/issue-5"*) exit 1 ;;
  *".default_branch"*) exit 1 ;;
  *"issue edit"*) : > "$tmp/claimed" ;;
  *) echo "" ;;
esac
STUB
chmod +x "$tmp/stub/gh"
rm -f "$tmp/claimed"
rc=0; out=$(run_claim) || rc=$?
assert_no_edit "기본 브랜치 조회 실패" "$rc" "$out"
# (d2) 기본 브랜치는 알아냈지만 그 head sha 를 못 읽는 경우 — (d) 는 기본 브랜치 가드에서
#      먼저 걸려 이 경로(앵커 sha 가드)를 지나가지 않으므로 따로 덮는다.
cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"--json labels,state"*) echo '{"state":"OPEN","labels":[]}' ;;
  *"--json labels"*)
    if [ -f "$tmp/claimed" ]; then echo '{"labels":[{"name":"agent:claimed"}]}'
    else echo '{"labels":[]}'; fi ;;
  *"git/ref/heads/agent/issue-5"*) exit 1 ;;
  *".default_branch"*) echo "main" ;;
  *"git/ref/heads/main"*) exit 1 ;;
  *"issue edit"*) : > "$tmp/claimed" ;;
  *) echo "" ;;
esac
STUB
chmod +x "$tmp/stub/gh"
rm -f "$tmp/claimed"
rc=0; out=$(run_claim) || rc=$?
assert_no_edit "앵커 sha 조회 실패" "$rc" "$out"
# (e) 잠금 후 재조회 자체가 실패 → 소유자 확인 불가 → claim 금지(fail-closed).
#     ("라벨 없음" 으로 대체하면 스테일 잠금으로 오인해 살아있는 소유자를 덮친다.)
#     재조회는 edit **전**이라 sentinel 이 없을 때만 실패시킨다 — post-check(edit 후)는
#     통과시켜야, 이 케이스가 "재조회에서 닫혔는지"를 post-check 사망과 구분해 잡는다.
cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"--json labels,state"*) echo '{"state":"OPEN","labels":[]}' ;;
  *"--json labels"*)
    if [ -f "$tmp/claimed" ]; then echo '{"labels":[{"name":"agent:claimed"}]}'; else exit 1; fi ;;
  *"git/ref/heads/agent/issue-5"*) exit 1 ;;
  *".default_branch"*) echo "main" ;;
  *"git/ref/heads/main"*) echo "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef" ;;   # 40자 hex — claim-issue.sh 가 앵커 sha 형태를 검증한다
  *"git/refs"*) echo '{"message":"Reference already exists","status":"422"}'; exit 1 ;;
  *"issue edit"*) : > "$tmp/claimed" ;;
  *) echo "" ;;
esac
STUB
chmod +x "$tmp/stub/gh"
rm -f "$tmp/claimed"
rc=0; out=$(run_claim) || rc=$?
assert_no_edit "잠금 후 재조회 실패" "$rc" "$out"
# (f) live-holder 지연 경합: 잠금은 남이 잡았고 라벨은 **늦게** 뜬다. 재조회가 1회면
#     "라벨 없음 = 스테일" 로 오판해 살아있는 소유자를 덮친다 → 대기창 안에서 반복
#     조회하다 라벨이 뜨면 패배로 접어야 한다. 스텁은 첫 조회에만 라벨을 숨긴다.
rm -f "$tmp/rechecks"
cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"--json labels,state"*) echo '{"state":"OPEN","labels":[]}' ;;
  *"--json labels"*)
    n=0; [ -f "$tmp/rechecks" ] && n=\$(cat "$tmp/rechecks")
    n=\$((n + 1)); echo "\$n" > "$tmp/rechecks"
    if [ "\$n" -le 1 ]; then echo '{"labels":[]}'
    else echo '{"labels":[{"name":"agent:claimed"}]}'; fi ;;
  *"git/ref/heads/agent/issue-5"*) exit 1 ;;
  *".default_branch"*) echo "main" ;;
  *"git/ref/heads/main"*) echo "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef" ;;   # 40자 hex — claim-issue.sh 가 앵커 sha 형태를 검증한다
  *"git/refs"*) echo '{"message":"Reference already exists","status":"422"}'; exit 1 ;;
  *"issue edit"*) : > "$tmp/claimed" ;;
  *) echo "" ;;
esac
STUB
chmod +x "$tmp/stub/gh"
rc=0
out=$(PATH="$tmp/stub:$PATH" CLAIM_STALE_WAIT=2 CLAIM_POLL_STEP=1 bash "$claim" o/r 5 2>/dev/null) || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ claim live-holder 지연: exit $rc (기대 1 — 살아있는 소유자를 덮쳤다)"; rm -rf "$tmp"; exit 1; }
case "$out" in *"claimed:"*) echo "  ✗ claim live-holder 지연: 늦게 뜬 라벨을 못 보고 claim 됨"; rm -rf "$tmp"; exit 1 ;; esac
[ "$(cat "$tmp/rechecks")" -ge 2 ] \
  || { echo "  ✗ claim live-holder 지연: 재조회가 1회뿐(대기창 폴링 미동작)"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[#147] 검증 사다리 배선 검사 — 네 문서가 사다리를 가리킨다"
# 실측 필요는 멈출 이유가 아니라 다음 할 일이다(Plans/live-verification-ladder.md). 사다리 참조가
# 빠지면 워커·검증·마감이 다시 "라이브 항목은 [ ]" 로 도망간다.
# ('이월' 금지 sweep 은 #398 로 걷었다 — 산문 어휘 핀이라 읽는 스크립트가 없다.)
[ -f references/live-verification-ladder.md ] || { echo "  ✗ references/live-verification-ladder.md 없음"; exit 1; }
for f in references/worker-template.md references/worker-template.en.md skills/verify-runner/SKILL.md skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  grep -qF "live-verification-ladder.md" "$f" || { echo "  ✗ $f: 검증 사다리 참조 없음"; exit 1; }
done
for f in SKILL.md SKILL.en.md skills/verify-runner/SKILL.md skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  if grep -nE 'transition\.sh (verify-held|closeout-blocked|runner-held) [^\n]*' "$f" | grep -v -- '--reason' | grep -q .; then
    echo "  ✗ $f: --reason 없는 verify-held/closeout-blocked/runner-held 호출"; exit 1; fi
  # policy·conflict 사유엔 --note 한 줄이 필수(#155) — policy 는 사람이 답할 질문, conflict 는
  # 재개 워커가 받을 범위(#344, closeout ③ CONFLICTING 항목). 어느 쪽이든 없으면 빨강.
  if grep -nE 'transition\.sh [a-z-]+ <repo>[^\n]*--reason (policy|conflict)' "$f" | grep -v -- '--note' | grep -q .; then
    echo "  ✗ $f: --note 없는 --reason policy|conflict 호출 — policy 는 질문 한 줄, conflict 는 워커 재개 범위 한 줄(#344)을 적으라"; exit 1; fi
  # 맨 needs-human 산문 작성 금지(#151) — 사유 없는 사람 대기는 loop-status 가 warn 하고 재개 스윕이 거부한다.
  # #214 의 예외(4단계 배포 티켓 발행 직후 라벨 보강이 needs-human 을 deploy-wait 와 함께
  # 되살리는 줄)는 #243 으로 **소비자가 사라져** 걷어냈다 — 그 보강은 이제 deploy-wait 하나만
  # 붙인다. 예외를 남겨 두면 산문으로 needs-human 을 되돌릴 통로가 그대로 열려 있다.
  if grep -nE -- '--add-label "?needs-human"?' "$f" | grep -q .; then
    echo "  ✗ $f: 산문 --add-label needs-human — runner-held/verify-held/closeout-blocked --reason 을 쓰라"; exit 1; fi
done
for f in SKILL.md SKILL.en.md; do grep -qF "resume-sweep.sh" "$f" || { echo "  ✗ $f: 재개 스윕 배선 없음"; exit 1; }; done
# (#244) 재심 "사람 몫 유지" 판정의 needs-human 부착 배선 — 이게 빠지면 `hold:policy` 재심이
# 끝나도 사람 호출 신호가 아무 데도 안 남는다(기계 정지에서 needs-human 을 뗀 뒤 남는 유일한
# 생산자다). 산문 `--add-label needs-human` 은 위 가드가 막으므로 전이로만 배선된다.
for f in SKILL.md SKILL.en.md; do
  grep -qF 'transition.sh policy-kept' "$f" \
    || { echo "  ✗ $f: 재심 '사람 몫 유지' 의 policy-kept 배선 없음 (#244)"; exit 1; }
done
grep -qE '^  policy-kept\)' scripts/transition.sh \
  || { echo "  ✗ scripts/transition.sh: policy-kept 전이 없음 (#244)"; exit 1; }
# (#244) 순서 계약 — **전이 먼저, 마커 나중**. `<!-- policy-review: kept -->` 는 resume-sweep 이
# "재심 끝"(reviewed)으로 읽는 유일한 신호라, 마커를 전이보다 먼저 올리면 `policy-kept` 가
# exit 1/2/64 로 죽어도 다음 틱부터 그 건이 접혀 `needs-human` 이 영영 안 붙고 `policy_review_due`
# 가 다시는 안 난다(사람 결정이 needs-human 칸에서 봉인). 문단 스코프로 좁힌다(#223) — 파일 다른
# 곳의 같은 문자열이 순서를 대신 만족시키면 가드가 무의미해진다.
for f in SKILL.md SKILL.en.md; do
  pr_s=$(grep -n '^- `policy_review_due`' "$f" | head -1 | cut -d: -f1)
  pr_e=$(grep -n '^- `waiting`' "$f" | head -1 | cut -d: -f1)
  { [ -n "$pr_s" ] && [ -n "$pr_e" ]; } \
    || { echo "  ✗ $f: policy_review_due 불릿 경계(다음 불릿 \`waiting\`)를 못 찾았다 (#244)"; exit 1; }
  pr_body=$(sed -n "${pr_s},${pr_e}p" "$f")
  t_line=$(printf '%s\n' "$pr_body" | grep -nF 'transition.sh policy-kept' | head -1 | cut -d: -f1)
  m_line=$(printf '%s\n' "$pr_body" | grep -nF '<!-- policy-review: kept -->' | head -1 | cut -d: -f1)
  { [ -n "$t_line" ] && [ -n "$m_line" ]; } \
    || { echo "  ✗ $f: policy_review_due 불릿에 policy-kept 전이 또는 kept 마커가 없다 (#244)"; exit 1; }
  [ "$t_line" -lt "$m_line" ] \
    || { echo "  ✗ $f: kept 마커가 policy-kept 전이보다 앞이다 — 전이가 죽으면 재심이 봉인된다 (#244)"; exit 1; }
  printf '%s\n' "$pr_body" | grep -qF 'BLOCKED: 전이 실패 policy-kept' \
    || { echo "  ✗ $f: 전이 비0 시의 목적지(\`BLOCKED: 전이 실패 policy-kept\` · 마커 미부착)가 없다 (#244)"; exit 1; }
done
# (#244) closeout ①-b 스윕 **대상 필터** — 기계 정지의 마지막 소비자. 이 필터는 `needs-human`
# 미부착만 보던 자리인데, #244 가 기계 정지에서 그 라벨을 떼므로 홀드된 PR(harvesting·
# flow:verify·needs-human 이 전부 없고 `hold:*` 만 남은 PR)이 매 틱 다시 대상이 된다 —
# hold-note 를 다시 달고, `stale_reverify` 갈래에선 `closeout-redispatch` 가 verify-runner 가
# 방금 세운 홀드를 통째로 벗긴다(#151 재현). 그래서 ⑴ **대상 문단 안에** `hold:` 접두
# 미부착이 함께 적혀 있어야 하고(문단 스코프 — 파일 아무 데나 `hold:` 가 있다고 통과하지
# 않는다), ⑵ 같은 두 파일이 기계 정지를 `needs-human`+`hold:*` **쌍**으로 계속 광고하면
# 안 된다(전이는 이제 사유 라벨 하나만 붙인다 — 읽는 사람과 다음 구현자가 서로 다른
# 계약을 믿게 된다, #191).
awk 'BEGIN{RS="";ok=0} /\*\*대상\*\*:/ && /`hold:` 접두 미부착/ {ok=1} END{exit ok?0:1}' skills/closeout/SKILL.md \
  || { echo "  ✗ skills/closeout/SKILL.md: ①-b 대상 문단에 \`hold:\` 접두 미부착 필터 없음 (#244)"; exit 1; }
awk 'BEGIN{RS="";ok=0} /\*\*Targets\*\*:/ && /no `hold:`-prefixed label/ {ok=1} END{exit ok?0:1}' skills/closeout/SKILL.en.md \
  || { echo "  ✗ skills/closeout/SKILL.en.md: ①-b Targets 문단에 no \`hold:\`-prefixed label 필터 없음 (#244)"; exit 1; }
# (#275) 같은 대상 문단이 verify-runner **점유** 라벨 `verifying` 도 제외해야 한다 — `flow:verify`
# 는 검증대기이고 `verifying` 은 verify-runner 가 집는 순간 flow:verify 를 떼고 붙이는 점유
# 라벨(harvesting 동형)이라, 이 문단이 `flow:verify` 만 보면 검증이 **지금 도는** PR 이
# 스윕의 입양·재디스패치 대상이 된다(closeout-eligible.sh 는 둘 다 제외한다 — 스윕 문단만
# 빠지면 두 필터가 갈린다). 문단 스코프로 잰다 — 파일 아무 데나 `verifying` 이 있다고 통과하지 않는다.
awk 'BEGIN{RS="";ok=0} /\*\*대상\*\*:/ && /`verifying` 미부착/ {ok=1} END{exit ok?0:1}' skills/closeout/SKILL.md \
  || { echo "  ✗ skills/closeout/SKILL.md: ①-b 대상 문단에 \`verifying\` 미부착 필터 없음 (#275)"; exit 1; }
awk 'BEGIN{RS="";ok=0} /\*\*Targets\*\*:/ && /not labeled `verifying`/ {ok=1} END{exit ok?0:1}' skills/closeout/SKILL.en.md \
  || { echo "  ✗ skills/closeout/SKILL.en.md: ①-b Targets 문단에 not labeled \`verifying\` 필터 없음 (#275)"; exit 1; }
# issue-runner ② Maintain 규칙0(단계 라벨 보정)·소유 규칙도 `verifying` PR 을 건드리지 않아야 한다 —
# 보정이 `🔄` 만 보고 `flow:verify` 를 되붙이면 검증 중인 PR 에 단계 라벨이 둘이 된다.
awk 'BEGIN{RS="";ok=0} /\*\*0\. 단계 라벨 보정/ && /`verifying`/ {ok=1} END{exit ok?0:1}' SKILL.md \
  || { echo "  ✗ SKILL.md: ② Maintain 규칙0 문단이 \`verifying\` PR 을 건너뛰지 않는다 (#275)"; exit 1; }
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md skills/verify-runner/SKILL.md; do
  if grep -nE '`needs-human` *\+ *`hold:' "$f" | grep -q .; then
    echo "  ✗ $f: 기계 정지를 \`needs-human\` + \`hold:*\` 쌍으로 서술 — #244 이후 전이는 사유 라벨 하나만 붙인다"; exit 1; fi
done
# (#244 WARN) 같은 파일 안에서 계약이 **두 값**으로 갈리지 않게 — `verify-runner` 의 ④ held 절차문은
# `transition.sh verify-held` 가 붙일 수 있는 라벨(`hold:<reason>`)만 광고해야 한다. 옛 문구(재디스패치
# 상한 초과를 `needs-human` 으로 승격)는 붙일 수 없는 라벨이라 읽는 사람과 다음 구현자가 서로 다른
# 계약을 믿는다(#191 과 같은 자리). #375 부터 리뷰 반송 상한은 held 사유가 아니다(codex 2회 → 3회차
# 자체 리뷰 완료) — 그 옛 서술(`상한 초과 → hold:policy`)이 되살아나면 여기서 빨강.
if grep -nE '`needs-human` *으로 승격' skills/verify-runner/SKILL.md | grep -q .; then
  echo "  ✗ skills/verify-runner/SKILL.md: 재디스패치 상한 초과를 needs-human 승격으로 서술 — 정지는 \`hold:<reason>\` 다 (#244)"; exit 1; fi
grep -qF 'verify-held <repo> <issue|-> <pr> --reason' skills/verify-runner/SKILL.md \
  || { echo "  ✗ skills/verify-runner/SKILL.md: held 가 transition.sh verify-held --reason 으로 정지한다는 서술 없음 (#244)"; exit 1; }
if grep -qE '상한 초과\*\* → `policy`|재디스패치 상한 초과\(VERIFY_ATTEMPTS_LIMIT\)' skills/verify-runner/SKILL.md; then
  echo "  ✗ skills/verify-runner/SKILL.md: 리뷰 반송 상한 초과를 hold:policy 사유로 서술 — #375 부터 3회차는 자체 리뷰로 완료한다"; exit 1; fi
# 루프 현황 대시보드(#163) — 세 루프 ④ Report 가 --post 로 게시해야 깃헙만 보고 현황을 안다.
for f in SKILL.md SKILL.en.md skills/verify-runner/SKILL.md skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  grep -qE 'loop-status\.sh --post (issue-runner|verify-runner|closeout)' "$f" || { echo "  ✗ $f: loop-status.sh --post 배선 없음"; exit 1; }
done

echo "[#144] 전이·스냅샷 스크립트 배선 문서화 검사 — 세 루프 SKILL + 워커 템플릿"
# 루프 문서가 산문 `gh issue edit` 대신 scripts/transition.sh(전이 표 SSOT)를 부르고,
# ④ Report 가 scripts/loop-status.sh 스냅샷을 붙이는지. 배선이 빠지면 라벨이 한쪽만
# 옮겨져 PR·이슈가 갈리고(다음 틱이 어긋난 쪽을 진실로 읽는다), 재고가 아무 보고에도
# 안 나온다.
for tok in 'transition.sh verify-pass' 'transition.sh verify-redispatch' \
           'transition.sh verify-held' 'loop-status.sh'; do
  grep -qF -- "$tok" skills/verify-runner/SKILL.md \
    || { echo "  ✗ skills/verify-runner/SKILL.md 에 '$tok' 배선 없음"; exit 1; }
done
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  for tok in 'transition.sh closeout-pick' 'transition.sh closeout-blocked' \
             'loop-status.sh' '--label spinoff' '--label deploy-wait'; do
    grep -qF -- "$tok" "$f" || { echo "  ✗ $f 에 '$tok' 배선 없음"; exit 1; }
  done
done
for f in SKILL.md SKILL.en.md; do
  grep -qF -- 'loop-status.sh' "$f" || { echo "  ✗ $f 에 loop-status.sh 스냅샷 배선 없음"; exit 1; }
done
for f in references/worker-template.md references/worker-template.en.md; do
  grep -qF -- 'transition.sh handoff-verify' "$f" \
    || { echo "  ✗ $f 에 transition.sh handoff-verify 배선 없음"; exit 1; }
done
# 전이 실패(exit 1 readback 불일치 · 2 gh 실패)를 조용히 넘기지 않는다는 보고 규약이
# 호출부 문서마다 살아 있는지. 이게 빠지면 라벨이 반쯤 이동한 채 루프가 다음으로 넘어간다.
# (문구는 파일마다 다르다 — 워커 템플릿은 종료 보고에 적는 `전이 실패: handoff-verify`,
#  루프 SKILL 은 ④ Report 에 올리는 `BLOCKED: …`, 영문 closeout 은 그 영어판.)
check_phrase() {
  grep -qF -- "$2" "$1" || { echo "  ✗ $1 에 전이 실패 보고 규약('$2') 없음"; exit 1; }
}
check_phrase skills/verify-runner/SKILL.md   'BLOCKED: 전이 실패'
check_phrase skills/closeout/SKILL.md        'BLOCKED: 전이 실패'
check_phrase skills/closeout/SKILL.en.md     'BLOCKED: transition failed'
check_phrase references/worker-template.md    '전이 실패: handoff-verify'
check_phrase references/worker-template.en.md '전이 실패: handoff-verify'
# 산문 회귀 가드 — 위 파일들에서 손수 라벨을 옮기는 형태가 되살아나면 실패.
# (`--add-label` 형태만 본다 — setup-labels.sh 설명·라벨 표의 라벨명 나열은 안 걸린다.)
for f in SKILL.md SKILL.en.md skills/verify-runner/SKILL.md \
         skills/closeout/SKILL.md skills/closeout/SKILL.en.md \
         references/worker-template.md references/worker-template.en.md; do
  if grep -nE -- '--add-label "?(flow:ready|flow:verify|harvesting)"?' "$f"; then
    echo "  ✗ $f: 산문 라벨 이동이 되살아남 — transition.sh 전이를 써라"
    exit 1
  fi
done

echo "[#292] loop-status 에픽 닫힌 leaf 조회 — 검색 쿼리 형태·단일 epic_of·헤더 계약"
# ⑴ 상태는 **`--state closed` 플래그**로 준다. 쿼리 문자열의 `is:closed` 는 `gh` 가
#    오파싱한 실측 전례가 있다(#236 — resume-sweep.sh 가 같은 이유로 플래그로 옮겼다).
#    형태가 뒤집히면 조회가 열린 이슈까지 물어 닫힌 leaf 수가 통째로 틀린다.
#    검사 대상은 **코드 줄만**이다(양쪽 다). 헤더/인라인 주석이 이 조회 형태를 그대로
#    인용하므로, 주석까지 세면 **코드만 되돌려도 초록**이 된다(사전 리뷰 실측: `--state all`
#    이나 `--search` 절 삭제로 되돌린 사본이 이 블록을 통째로 통과했다). 반대로 `is:closed`
#    금지는 주석이 왜 안 쓰는지 설명하며 그 문자열을 인용하니 주석을 세면 자기 근거를 금지한다.
#    한 번만 뽑아 둘 다 이 변수로 본다 — 파일이 없으면 빈 문자열이라 아래 첫 검사가
#    바로 빨개진다(fail-closed).
#    `grep -q` 에는 **here-string** 으로 준다(`printf … | grep -q` 가 아니라): `$ls_code` 는
#    40KB 가 넘고 `-q` 는 첫 매치에서 끊으므로, 파이프 버퍼가 작게 잡힌 박스(pipe 메모리
#    압박)에서는 아직 못 쓴 뒤쪽을 들고 있던 printf 가 SIGPIPE(141) 로 죽고 `pipefail` 이
#    그것을 "매치 없음" 으로 읽는다 — 문자열이 실재하는 트리에서 이 줄이 빨갛게 뜬 실측
#    (local-ci 96bbde2c, #343). here-string 은 임시 파일이라 읽는 쪽이 먼저 끝나도 무해하다.
ls_code=$(grep -vE '^[[:space:]]*#' scripts/loop-status.sh || true)
grep -qF -- "--state closed --search '\"Epic #\" in:body'" <<<"$ls_code" \
  || { echo "  ✗ scripts/loop-status.sh 의 에픽 닫힌 leaf 조회(코드)가 예상 형태가 아니다(--state closed 플래그 + \"Epic #\" in:body)"; exit 1; }
if printf '%s\n' "$ls_code" | grep -nF -- 'is:closed'; then
  echo "  ✗ scripts/loop-status.sh 검색 쿼리(코드)에 is:closed 가 들어갔다 — gh 가 오파싱한다(#236). --state closed 플래그로"
  exit 1
fi
#    `--limit` 이 `EPIC_CLOSED_LIMIT` 로 전달되는지도 코드 줄에서 센다 — 리터럴 상한으로
#    되돌리면 창이 PR 이전으로 돌아가는데 상한 판정은 env 를 읽어 `capped` 도 안 뜬다.
grep -qF -- '--limit "$EPIC_CLOSED_LIMIT"' <<<"$ls_code" \
  || { echo "  ✗ scripts/loop-status.sh 의 에픽 닫힌 leaf 조회가 --limit \"\$EPIC_CLOSED_LIMIT\" 로 안 간다(#292)"; exit 1; }
# ⑵ `epic_of` 정규식은 이 파일에 **한 벌**뿐이어야 한다(이슈 #292 개발 계획 3항).
#    복제본이 생기면 두 계산기가 서로 다른 leaf 를 세고, 그 차이는 출력에 안 보인다.
#    `-F` 로 고정 문자열 비교한다 — 이 패턴 자체가 정규식 메타문자 덩어리라 BRE 로 적으면
#    이스케이프 하나가 어긋나도 **0벌**이 되어 가드가 조용히 통과한다(실제로 그렇게 틀렸다).
#    `set -e` 아래라 `grep -c` 가 0매치로 exit 1 하면 스크립트가 죽으므로 `|| true` 로 받는다.
#    성격 주의: 이건 **미래의 복제를 막는 불변식**이지 이 PR 의 되돌림 탐지기가 아니다 —
#    merge-base 에서도 이미 한 벌이었다(전체 되돌림 트리에서도 이 조항은 초록이다).
epic_of_n=$(grep -cF -- 'capture("^[[:space:]]*epic[[:space:]]+#' scripts/loop-status.sh || true)
[ "$epic_of_n" = 1 ] \
  || { echo "  ✗ scripts/loop-status.sh 의 epic_of 정규식이 $epic_of_n 벌이다 — 한 벌이어야 한다(#292)"; exit 1; }
# ⑶ 헤더 주석 계약이 코드와 같은 조건을 광고하는지 (#191 — 코드만 좁히면 헤더가 옛
#    조건을 계속 가르친다). 닫힌 이슈 200건 절단 warn 은 없앴고, 새 자리는 EPIC_CLOSED_LIMIT 다.
#    이 루프는 **주석을 일부러 센다** — 헤더 동기화가 검사 대상이라서다. 코드 되돌림은
#    위 ⑴(코드 줄 전용)과 스위트가 맡는다. 둘을 같은 조항으로 섞지 마라.
for tok in 'EPIC_CLOSED_LIMIT' '종료 미상' '에픽 닫힌 leaf'; do
  grep -qF -- "$tok" scripts/loop-status.sh \
    || { echo "  ✗ scripts/loop-status.sh 헤더/코드에 '$tok' 계약이 없다(#292)"; exit 1; }
done
#    닫힌 이슈(최근 200건) 절단 warn 이 되살아나면 빨강. **렌더된 문자열이 아니라 후보
#    목록의 항목**을 본다 — warn 문구는 `"목록 상한 200 도달 — 창 절단 가능(\(.what))"`
#    처럼 jq 보간으로 만들어지므로 `창 절단 가능(닫힌 이슈)` 리터럴은 **되돌린 트리에도
#    없다**(merge-base `19cba3c8:scripts/loop-status.sh:826,831` 실측 — 옛 코드도 보간형).
#    리터럴로 적으면 태어날 때부터 죽은 조항이 된다.
if grep -nF -- 'what: "닫힌 이슈"' scripts/loop-status.sh; then
  echo "  ✗ 최근 닫힌 200건이 절단 warn 후보 목록에 되살아났다 — bodat 에서 매 틱 뜨는 상시 소음이다(#292/#190)"
  exit 1
fi

echo "[setup-labels] 라벨 정의 존재 — full-cycle 추가·기존 라벨 정의 생존·RESUME_AFTER_MIN 상수 (#245 · #364)"
# 플랜 4단계(label-taxonomy-cleanup). 스크립트가 읽는 것은 라벨 **이름**뿐이라
# 여기 남기는 것도 `gh label create <이름>` 정의의 존재다 — `--description` 문구 대조와
# README 라벨 표 행 검사, resume-sweep.sh 머리 주석 문구 대조는 #398 로 걷었다
# (그 문자열을 읽는 스크립트가 0 — 산문 드리프트는 리뷰 몫이다).
# ⑴ full-cycle — 지금까지 스크립트가 만들지 않아 새로 옵트인하는 레포에서 `--add-label
#    full-cycle` 편집이 통째로 실패했다(`transition.sh` 의 "레포에 없는 라벨" 계열).
grep -qF 'gh label create "full-cycle"' scripts/setup-labels.sh \
  || { echo "  ✗ scripts/setup-labels.sh: full-cycle 라벨 정의 누락 (#245)"; exit 1; }
# ⑵ 이 축 정리는 **추가와 설명 변경만** 한다 — 기존 라벨 정의가 하나라도 사라지면 빨강
#    (이름 변경·삭제는 다중 레포 마이그레이션이라 범위 밖이고, transition.sh 가 붙이는
#    라벨이 레포에 없으면 편집 전체가 실패한다).
#    예외 하나: `P2` 는 #401 이 축을 P0·P1 둘로 줄이며 **의도적으로** 목록에서 뺐다
#    (레포별 라벨 삭제는 여전히 데이터 작업이라 이 스크립트 밖이다 — 더 만들지 않을 뿐).
for lbl in agent-ready agent:claimed needs-human P0 P1 harvesting epic flow:ci flow:verify \
           flow:codex flow:ready spinoff deploy-wait loop-dashboard hold:conflict hold:policy hold:ladder dup; do
  grep -qE "gh label create \"?${lbl}\"? " scripts/setup-labels.sh \
    || { echo "  ✗ scripts/setup-labels.sh: 기존 라벨 '$lbl' 정의가 사라짐 — 이 축 정리는 삭제·이름변경을 하지 않는다 (#245)"; exit 1; }
done
# ⑶ (#364) hold:ladder 설명이 가리키는 창 상수명은 resume-sweep.sh 의 실제 정의와 같은
#    철자여야 한다 — 상수를 개명하면 설명이 없는 이름을 가리킨다.
# (#427) 정의 자리는 `scripts/lib/constants.sh` 로 이사했다 — 철자 대조라는 취지는 그대로다.
grep -qE '^: "\$\{RESUME_AFTER_MIN:=' scripts/lib/constants.sh \
  || { echo "  ✗ scripts/lib/constants.sh: 창 상수 RESUME_AFTER_MIN 정의가 없다 — hold:ladder 설명이 가리키는 상수명 (#364)"; exit 1; }
# ⑷ (#346 반송) 라벨 설명은 **100자 이하** — GitHub 라벨 description 상한. 넘으면
#    `gh label create --force` 가 validation 으로 실패하고 이 스크립트는 `set -e` 라 그 뒤의
#    라벨·레포 설정 전부가 중단된다(실측: hold:conflict 설명 138자 → 이후 라벨 미생성).
#    글자 수는 문자(char) 기준 — UTF-8 바이트가 아니다(한글 설명이 대부분이라 바이트로 재면
#    전부 빨갛다). 설명이 한 줄 안에 `--description "…"` 로 닫혀 있어야 이 grep 이 센다.
sl_over=$(grep -o -- '--description "[^"]*"' scripts/setup-labels.sh \
  | sed 's/^--description "//; s/"$//' \
  | while IFS= read -r sl_desc; do
      sl_len=$(printf '%s' "$sl_desc" | LC_ALL=en_US.UTF-8 wc -m | tr -d ' ')
      [ "$sl_len" -le 100 ] || printf '%s자: %s\n' "$sl_len" "$sl_desc"
    done)
[ -z "$sl_over" ] || { echo "  ✗ scripts/setup-labels.sh: 라벨 설명이 100자를 넘는다 — gh label create 가 실패하고 set -e 로 뒤가 전부 멈춘다 (#346)"; printf '%s\n' "$sl_over"; exit 1; }
sl_n=$(grep -c -- '--description "' scripts/setup-labels.sh)
[ "$sl_n" -ge 20 ] || { echo "  ✗ scripts/setup-labels.sh: 한 줄 --description 정의가 $sl_n 건뿐 — 길이 검사가 설명을 못 보고 있다"; exit 1; }

# [#308] 반송 마커 시각이 스테일 클록에 든다 — 판별은 bounce-state.sh 한 자리
echo "[#308] 반송 마커 시각 = 스테일 클록의 네 번째 입력 (판별 한 자리·한/영 산문)"
# 배선 — `finish-classify.sh` 는 마커 판별을 **되묻는다**. 이 호출이 사라지면 반송 직후
# 라벨 공백 창이 다시 열려 살아 있는 반송 회차에 `완결 유실(검증 전 사망)` 이 찍힌다.
grep -qF 'bounce-state.sh' scripts/finish-classify.sh \
  || { echo "  ✗ scripts/finish-classify.sh 에 bounce-state.sh 되묻기 배선 없음"; exit 1; }
# 마커 집합 정의가 한 자리인지는 위 `[closeout] 반송 마커 집합은 bounce-state.sh 한 자리`
# 블록이 이미 전수로 검사한다 — 여기 두 번째 술어를 만들지 않는다(PR#216 규율).
# 소비자가 `"$SCRIPT_DIR/bounce-state.sh"` 로 직접 exec 하므로 실행 비트를 문다
# (비트가 빠지면 exit 126 → 판정 불가 → 모든 🔄 갈래가 조용히 active 로 접혀 완결 유실
#  회수가 통째로 멈춘다 — progress-evidence.sh 의 같은 자리와 같은 함정).
[ -x scripts/bounce-state.sh ] || { echo "  ✗ bounce-state.sh 실행 비트 없음"; exit 1; }
# 행동 스모크 — 같은 형상에서 반송 마커 시각 하나만 움직였을 때 판정이 갈리는가.
# (격자·뮤테이션 방증은 scripts/tests/finish-classify.test.sh 의 J 절이 문다.)
ci308_now=$(date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "2026-07-05T12:00:00Z" +%s 2>/dev/null \
  || date -u -d "2026-07-05T12:00:00Z" +%s)
ci308_tmp=$(mktemp -d); : > "$ci308_tmp/empty.log"
ci308_run() {  # ci308_run <반송 마커 createdAt>
  FC_NOW="$ci308_now" FC_FAILING=0 STALE_FINISH_MIN=30 STALL_MIN=25 ISSUE_TIMEBOX_HOURS=1 \
    FC_COMMENTS_JSON="[{\"body\":\"머지 판정: 🔄 진행 중\",\"createdAt\":\"2026-07-05T10:30:00Z\"},
                       {\"body\":\"재검증 실패: #308 — E2E 1건 실패\",\"createdAt\":\"$1\"}]" \
    FC_HEAD_AT="2026-07-05T10:00:00Z" FC_HEAD_SHA=none FC_QUEUE_LOG="$ci308_tmp/empty.log" \
    FC_CLAIMED_AT=none scripts/finish-classify.sh owner/repo 1 2>/dev/null
}
out308=$(ci308_run "2026-07-05T11:55:00Z")
[ "$out308" = active ] || { rm -rf "$ci308_tmp"; echo "  ✗ finish-classify: 반송 마커 신선(5분 전) → '$out308' (기대 active)"; exit 1; }
out308=$(ci308_run "2026-07-05T11:25:00Z")
[ "$out308" = stale_reverify ] || { rm -rf "$ci308_tmp"; echo "  ✗ finish-classify: 반송 마커 old(35분 전) → '$out308' (기대 stale_reverify — 예외 갈래가 죽었다)"; exit 1; }
rm -rf "$ci308_tmp"
# 산문 — 한/영 ①-b 예외 갈래 문단이 이 입력을 광고해야 한다. 문서가 "커밋·CI·claim
# 셋뿐" 이라는 옛 계약을 계속 광고하면 다음 구현자가 그 창을 다시 연다(#206 과 같은 형상).
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  grep -qF '#308' "$f" \
    || { echo "  ✗ $f 에 반송 마커 스테일 클록(#308) 표기 없음"; exit 1; }
  awk 'BEGIN{RS="";ok=0} /#308/ && /bounce-state\.sh/ && /finish-classify\.sh/ {ok=1} END{exit ok?0:1}' "$f" \
    || { echo "  ✗ $f: #308 문단이 판별 출처(bounce-state.sh)·소비자(finish-classify.sh)를 같이 적지 않았다"; exit 1; }
done
grep -qF '라벨 공백 창' skills/closeout/SKILL.md \
  || { echo "  ✗ skills/closeout/SKILL.md 에 반송 직후 '라벨 공백 창' 표기 없음"; exit 1; }
grep -qF 'label gap' skills/closeout/SKILL.en.md \
  || { echo "  ✗ skills/closeout/SKILL.en.md 에 반송 직후 'label gap' 미러 없음"; exit 1; }


echo "[#507] SKILL 의 rationale·conventions §N 포인터 — 실재하는 절만 가리킨다 (헤더 중복도 빨강)"
# 3단계(#451)로 근거 서사는 references/<루프>-rationale.md 로, 공용 규약은 references/loop-conventions.md 로
# 갔다. SKILL 문단 끝 `(근거: <루프>-rationale §N)` · `references/loop-conventions.md §N` · 영문판의
# `(rationale §N)` 이 그 절로 가는 유일한 실인데, 이 포인터를 읽는 스크립트가 없어 다음 편집이 번호만
# 바꾸거나 절을 지워도 아무도 못 잡는다(#453 구현 보고 · #452 는 손으로 검산했다).
# 검사: 네 문서의 `## §N` 헤더 집합 ⊇ 인용 집합. 없는 절이면 파일:줄·포인터를 찍고 exit 1.
# 문서명 없는 `rationale §N` 은 인용 파일의 자리로 루프를 정한다(루트 SKILL* → issue-runner,
# skills/<루프>/SKILL* → <루프>). 문서 파일이 아직 없는 루프(closeout, #453 진행 중)는 인용이 0건인 동안만
# 건너뛴다 — 인용이 생기면 그 문서도 있어야 한다.
# 허용 형태(실측 전수): `<문서명>[.md][`] §N` 과 `·` 로 잇는 나열 `§N·§M` 만 — `§3, §4`·`§3~§5`·대문자
# `Rationale` 은 형태 자체가 없으니 잡지 않는다. 새 형태를 쓰려면 sec_re 를 같이 넓혀라.
# 만료 조건: 포인터를 앵커 링크로 바꾸고 링크 검사기가 들어오면 지운다.
sec_re='(loop-conventions|([a-z-]+-)?rationale)(\.md)?`? §[0-9]+(·§[0-9]+)*'
sec_fail=0; sec_n=0
for doc in loop-conventions issue-runner-rationale verify-runner-rationale closeout-rationale; do
  [ -f "references/$doc.md" ] || continue
  sec_h=$(grep -oE '^## §[0-9]+' "references/$doc.md" | sed 's/^## §//')
  [ -n "$sec_h" ] || { echo "  ✗ references/$doc.md: '## §N' 헤더가 0개 — 형식이 바뀌었으면 이 검사도 같이 옮겨라"; exit 1; }
  sec_d=$(printf '%s\n' "$sec_h" | sort -n | uniq -d | sed 's/^/§/' | tr '\n' ' ')
  [ -z "$sec_d" ] || { echo "  ✗ references/$doc.md: 절 번호 중복 — ${sec_d% }"; sec_fail=1; }
done
for f in SKILL.md SKILL.en.md skills/*/SKILL*.md references/worker-template*.md; do
  # 아래 `grep … || true` 는 미매치(exit 1)와 파일 부재(exit 2)를 같이 삼킨다 — 부재는 여기서 먼저 닫는다.
  [ -f "$f" ] || { echo "  ✗ $f 없음 — 인용 파일 목록이 실제 파일과 어긋났다"; exit 1; }
  case "$f" in
    SKILL*.md) sec_own=issue-runner-rationale ;;
    skills/*/SKILL*.md) sec_own="$(basename "$(dirname "$f")")-rationale" ;;
    *) sec_own="" ;;
  esac
  while IFS=: read -r ln m; do
    [ -n "$m" ] || continue
    sec_n=$((sec_n + 1))
    name=${m%% §*}; name=${name%\`}; name=${name%.md}
    case "$name" in
      rationale) doc="$sec_own" ;;
      *) doc="$name" ;;
    esac
    [ -n "$doc" ] || { echo "  ✗ $f:$ln: '$m' — 문서명 없는 rationale 포인터인데 파일 자리로 루프를 정할 수 없다"; sec_fail=1; continue; }
    [ -f "references/$doc.md" ] || { echo "  ✗ $f:$ln: '$m' → references/$doc.md 없음"; sec_fail=1; continue; }
    for n in $(printf '%s' "${m#* }" | grep -oE '[0-9]+'); do
      grep -qE "^## §$n( |$)" "references/$doc.md" \
        || { echo "  ✗ $f:$ln: '$m' — references/$doc.md 에 §$n 절 없음"; sec_fail=1; }
    done
  done < <(grep -noE "$sec_re" "$f" || true)
done
[ "$sec_n" -gt 0 ] || { echo "  ✗ §N 포인터를 한 건도 못 찾았다 — 인용 형태가 바뀌었으면 sec_re 를 같이 옮겨라"; exit 1; }
[ "$sec_fail" = 0 ] || exit 1
echo "  포인터 ${sec_n}건 검사"
