#!/usr/bin/env bash
# 로컬 CI — hooks/local-ci.sh 계약 (GitHub Actions 미사용. 설치는 README §설치 4단계)
set -euo pipefail
cd "$(dirname "$0")/.."

echo "[1/5] bash 문법 검사 (bash -n)"
fail=0
for f in scripts/*.sh hooks/*.sh bin/ci; do
  if ! bash -n "$f"; then
    echo "  ✗ $f"
    fail=1
  fi
done
[ "$fail" = 0 ] || exit 1

echo "[2/5] shellcheck (설치 시)"
if command -v shellcheck >/dev/null 2>&1; then
  shellcheck -S warning scripts/*.sh hooks/*.sh bin/ci
else
  echo "  shellcheck 미설치 — skip"
fi

echo "[lint] 인용 안 한 heredoc 본문의 미이스케이프 백틱·\$( 검사 (#119)"
# 구분자를 인용하지 않은 heredoc 은 본문의 백틱·$( 를 **바깥 셸이 전개**한다 — 스텁 주석에
# 백틱을 쓰면 그 안이 실행되고 그 자리가 빈 문자열로 치환돼 주석이 조용히 지워진다.
# bin/ci 자신도 검사 대상이다(그 결함이 실제로 여기 있었다).
scripts/lint-heredoc.sh scripts/*.sh hooks/*.sh bin/ci \
  || { echo "  ↑ 백틱은 \\\` 로, 명령치환은 \\\$( 로 이스케이프하거나 <<'DELIM' 로 인용하라"; exit 1; }

echo "[hooks] 동봉 hook 은 전부 README 설치 섹션에 문서화 (영/한)"
# ship 하는 모든 hooks/*.sh 는 두 README 에 파일명이 나타나야 한다 — 문서화 없이
# hook 을 추가/이름변경하면 사용자가 등록법을 알 수 없다(설명·settings.json 누락 방지).
for hp in hooks/*.sh; do
  hb=$(basename "$hp")
  grep -qF "$hb" README.md    || { echo "  ✗ README.md 에 hook '$hb' 문서 없음"; exit 1; }
  grep -qF "$hb" README.ko.md || { echo "  ✗ README.ko.md 에 hook '$hb' 문서 없음"; exit 1; }
done

echo "[3/5] repo-dir.sh 스모크 테스트"
out=$(ISSUE_RUNNER_PROJECTS_ROOT=/tmp scripts/repo-dir.sh owner/some-repo)
[ "$out" = "/tmp/some-repo" ] || { echo "  ✗ 기본 경로 해석 실패: $out"; exit 1; }

echo "[4/5] 한/영 SKILL 구조 동기화 검사 (## 헤더 개수·순서)"
fail=0
for pair in "SKILL.md:SKILL.en.md" "skills/loop-issues/SKILL.md:skills/loop-issues/SKILL.en.md" "skills/closeout/SKILL.md:skills/closeout/SKILL.en.md" "references/worker-template.md:references/worker-template.en.md"; do
  ko="${pair%%:*}"
  en="${pair#*:}"
  if [ ! -f "$ko" ] || [ ! -f "$en" ]; then
    echo "  ✗ 파일 누락: $ko ↔ $en 쌍이 모두 존재해야 한다"
    fail=1
    continue
  fi
  ko_count=$(grep -c '^## ' "$ko" || true)
  en_count=$(grep -c '^## ' "$en" || true)
  if [ "$ko_count" != "$en_count" ]; then
    echo "  ✗ 섹션 개수 불일치: $ko(${ko_count}개) vs $en(${en_count}개)"
    echo "    --- $ko"
    grep -n '^## ' "$ko" | sed 's/^/      /'
    echo "    --- $en"
    grep -n '^## ' "$en" | sed 's/^/      /'
    fail=1
    continue
  fi
  # 순서 검사: 헤더 제목은 번역되므로 텍스트 비교 불가 —
  # 언어 불변 마커(원형 숫자 ①②…)가 같은 위치에서 일치하는지 본다
  i=0
  while IFS=$'\t' read -r ko_h en_h; do
    i=$((i + 1))
    ko_mark=$(printf '%s\n' "$ko_h" | grep -o '[①②③④⑤⑥⑦⑧⑨⑩]' | head -1 || true)
    en_mark=$(printf '%s\n' "$en_h" | grep -o '[①②③④⑤⑥⑦⑧⑨⑩]' | head -1 || true)
    if [ "$ko_mark" != "$en_mark" ]; then
      echo "  ✗ 섹션 순서 불일치 (${i}번째 헤더): $ko '$ko_h' ↔ $en '$en_h'"
      fail=1
    fi
  done < <(paste <(grep '^## ' "$ko") <(grep '^## ' "$en"))
  # worker-template 쌍 한정: ## 헤더가 없는 파일이므로 절차 번호 줄(^N.) 개수도 검사
  if [ "$ko" = "references/worker-template.md" ]; then
    ko_steps=$(grep -c '^[0-9][0-9]*\.' "$ko" || true)
    en_steps=$(grep -c '^[0-9][0-9]*\.' "$en" || true)
    if [ "$ko_steps" != "$en_steps" ]; then
      echo "  ✗ 절차 번호 줄 개수 불일치: $ko(${ko_steps}개) vs $en(${en_steps}개)"
      fail=1
    fi
    # 필수 placeholder 존재 검사 — 디스패처가 런타임에 치환하는 계약
    # (<LESSONS_OR_ 는 언어별 접미사("없음"/"none")가 달라 접두만 본다)
    for ph in '<WT_PATH>' '<REPO>' '<NUM>' '<TITLE>' '<DEFAULT_BRANCH>' '<LESSONS_OR_'; do
      for f in "$ko" "$en"; do
        if ! grep -qF "$ph" "$f"; then
          echo "  ✗ 필수 placeholder 누락: $f 에 $ph 없음"
          fail=1
        fi
      done
    done
  fi
done
[ "$fail" = 0 ] || exit 1

echo "[5/5] 머지 게이트 PR 대상 파싱 스모크 테스트 (fail-closed)"
# gh 가 전부 실패하는 환경에서 <번호>·<URL>·<브랜치> 세 형태 모두 게이트가
# exit 2(차단)여야 한다 — 0 이면 식별 실패가 머지 우회로 새는 회귀.
tmp=$(mktemp -d)
mkdir "$tmp/stub"
printf '#!/bin/sh\nexit 1\n' > "$tmp/stub/gh"
chmod +x "$tmp/stub/gh"
gate="$PWD/hooks/ci-gate-before-pr-merge.sh"
fail=0
for form in "123" "https://github.com/o/r/pull/123" "feature-branch"; do
  rc=0
  printf '{"tool_input":{"command":"gh pr merge %s --squash"}}' "$form" \
    | (cd "$tmp" && PATH="$tmp/stub:$PATH" bash "$gate") >/dev/null 2>&1 || rc=$?
  if [ "$rc" != 2 ]; then
    echo "  ✗ gh pr merge $form → exit $rc (기대: 2 — 게이트 우회 회귀)"
    fail=1
  fi
done
rm -rf "$tmp"
[ "$fail" = 0 ] || exit 1

echo "[closeout] setup-labels.sh 에 harvesting·epic 라벨 정의 존재 검사"
for lbl in harvesting epic; do
  grep -qF "gh label create $lbl " scripts/setup-labels.sh || {
    echo "  ✗ setup-labels.sh 에 $lbl 라벨 정의 누락"; exit 1; }
done

echo "[closeout] ci-pass 헬퍼 fail-closed 스모크"
tmp=$(mktemp -d); mkdir "$tmp/stub"
printf '#!/bin/sh\nexit 1\n' > "$tmp/stub/gh"; chmod +x "$tmp/stub/gh"
rc=0; PATH="$tmp/stub:$PATH" bash scripts/closeout-ci-pass.sh owner/r 123 >/dev/null 2>&1 || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ ci-pass: gh 실패 시 exit $rc (기대 1)"; exit 1; }
rm -rf "$tmp"

echo "[closeout] pr-head-at 헬퍼 fail-closed·실행비트 스모크 (#171)"
# head 시각을 못 얻으면 **아무것도 안 내고 exit 1** 이어야 한다 — 빈 결과를 유효값으로
# 둔갑시키면 머지 게이트(finish-classify 의 ✅ 갈래)가 증명 없이 열린다.
# 소비자가 `"$SCRIPT_DIR/pr-head-at.sh"` 로 직접 exec 하므로 실행 비트도 여기서 함께 문다
# (비트가 빠지면 조용히 exit 126 → head 시각이 항상 빈 값으로 degrade 된다).
[ -x scripts/pr-head-at.sh ] || { echo "  ✗ pr-head-at.sh 실행 비트 없음"; exit 1; }
tmp=$(mktemp -d); mkdir "$tmp/stub"
printf '#!/bin/sh\nexit 1\n' > "$tmp/stub/gh"; chmod +x "$tmp/stub/gh"
rc=0; out=$(PATH="$tmp/stub:$PATH" scripts/pr-head-at.sh owner/r 123 2>/dev/null) || rc=$?
[ "$rc" = 1 ] && [ -z "$out" ] \
  || { echo "  ✗ pr-head-at: gh 실패 시 rc=$rc out='$out' (기대 rc=1·무출력)"; rm -rf "$tmp"; exit 1; }
# headRefOid 는 얻었는데 그 커밋 조회가 빈 값 → 역시 exit 1 (부분 성공을 통과로 안 본다).
cat > "$tmp/stub/gh" <<'STUB'
#!/bin/sh
case "$*" in
  *"--json headRefOid"*) echo '{"headRefOid":"feed0070ab"}' ;;
  *) echo '' ;;
esac
STUB
chmod +x "$tmp/stub/gh"
rc=0; out=$(PATH="$tmp/stub:$PATH" scripts/pr-head-at.sh owner/r 123 2>/dev/null) || rc=$?
[ "$rc" = 1 ] && [ -z "$out" ] \
  || { echo "  ✗ pr-head-at: 커밋 조회 빈값 rc=$rc out='$out' (기대 rc=1·무출력)"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] closeout-step1-marker 헬퍼 fail-closed·실행비트 스모크 (#271)"
# 1단계 마커 판정을 못 하면 **아무것도 안 내고 exit≠0** 이어야 한다 — 빈 결과를
# `skip` 쪽으로 둔갑시키면 검증 안 된 head 가 2단계 머지 게이트를 그냥 통과한다.
# ① Reconcile 프로즈가 `$SCRIPTS/closeout-step1-marker.sh` 로 직접 exec 하므로 실행 비트도
# 여기서 문다(빠지면 조용히 exit 126 → 판정이 항상 빈 값으로 degrade 된다, PR#173 교훈).
[ -x scripts/closeout-step1-marker.sh ] || { echo "  ✗ closeout-step1-marker.sh 실행 비트 없음"; exit 1; }
tmp=$(mktemp -d); mkdir "$tmp/stub"
printf '#!/bin/sh\nexit 1\n' > "$tmp/stub/gh"; chmod +x "$tmp/stub/gh"
rc=0; out=$(PATH="$tmp/stub:$PATH" scripts/closeout-step1-marker.sh owner/r 123 2>/dev/null) || rc=$?
[ "$rc" != 0 ] && [ -z "$out" ] \
  || { echo "  ✗ closeout-step1-marker: gh 실패 시 rc=$rc out='$out' (기대 rc≠0·무출력)"; rm -rf "$tmp"; exit 1; }
rc=0; out=$(PATH="$tmp/stub:$PATH" scripts/closeout-step1-marker.sh 2>/dev/null) || rc=$?
[ "$rc" != 0 ] && [ -z "$out" ] \
  || { echo "  ✗ closeout-step1-marker: 인자 누락 시 rc=$rc out='$out' (기대 rc≠0·무출력)"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"
# `bounce-state.sh --marker-index` 계약 스모크 — 소비자가 이 모드로 반송 선후를 받는다.
tmp=$(mktemp -d)
printf '%s' '[{"body":"X","createdAt":"2026-09-11T00:00:00Z"},{"body":"재디스패치: #271 — 사유","createdAt":"2026-09-11T01:00:00Z"}]' > "$tmp/c.json"
mi=$(BOUNCE_COMMENTS_FILE="$tmp/c.json" scripts/bounce-state.sh --marker-index owner/r 1)
[ "$mi" = 1 ] || { echo "  ✗ bounce-state --marker-index: 기대 1 실제 '$mi'"; rm -rf "$tmp"; exit 1; }
printf '%s' '[{"body":"X","createdAt":"2026-09-11T00:00:00Z"}]' > "$tmp/c.json"
mi=$(BOUNCE_COMMENTS_FILE="$tmp/c.json" scripts/bounce-state.sh --marker-index owner/r 1)
[ "$mi" = none ] || { echo "  ✗ bounce-state --marker-index: 마커 없을 때 기대 none 실제 '$mi'"; rm -rf "$tmp"; exit 1; }
# 기본 모드가 안 바뀌었는지(모드 추가가 기존 소비자를 건드리면 안 된다).
st=$(BOUNCE_COMMENTS_FILE="$tmp/c.json" scripts/bounce-state.sh owner/r 1)
[ "$st" = ok ] || { echo "  ✗ bounce-state 기본 모드 회귀: 기대 ok 실제 '$st'"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] bounce-state 헬퍼 fail-closed·실행비트 스모크 (#196)"
# 반송 판정을 못 하면 **아무것도 안 내고 exit≠0** 이어야 한다 — 빈 결과를 유효값으로
# 둔갑시키면 CONFLICTING 입양 게이트가 증명 없이 열린다(PR#139 교훈).
# 소비자(closeout-eligible.sh · closeout SKILL ①-b 프로즈)가 직접 exec 하므로 실행 비트도
# 여기서 함께 문다(비트가 빠지면 조용히 exit 126 → 판정이 항상 빈 값으로 degrade 된다).
[ -x scripts/bounce-state.sh ] || { echo "  ✗ bounce-state.sh 실행 비트 없음"; exit 1; }
tmp=$(mktemp -d); mkdir "$tmp/stub"
printf '#!/bin/sh\nexit 1\n' > "$tmp/stub/gh"; chmod +x "$tmp/stub/gh"
rc=0; out=$(PATH="$tmp/stub:$PATH" scripts/bounce-state.sh owner/r 123 2>/dev/null) || rc=$?
[ "$rc" != 0 ] && [ -z "$out" ] \
  || { echo "  ✗ bounce-state: gh 실패 시 rc=$rc out='$out' (기대 rc≠0·무출력)"; rm -rf "$tmp"; exit 1; }
# 인자 누락도 조용한 `ok` 가 아니라 판정 실패다.
rc=0; out=$(PATH="$tmp/stub:$PATH" scripts/bounce-state.sh 2>/dev/null) || rc=$?
[ "$rc" != 0 ] && [ -z "$out" ] \
  || { echo "  ✗ bounce-state: 인자 누락 rc=$rc out='$out' (기대 rc≠0·무출력)"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] 반송 마커 집합은 bounce-state.sh 한 자리 (#171 · #196)"
# 마커 집합을 다른 스크립트가 자기 벌로 들고 있으면 새 반송 어휘가 생겼을 때 한쪽만
# 고쳐져 fail-open 이 된다(실제로 verify-runner 채널이 그렇게 빠져 있었다).
# 판정선은 **집합 정의(`BOUNCE_MARKERS`)의 존재**다 — 마커 문자열 자체는 다른 파일의
# 설명 주석에도 나오고(그건 사본이 아니다), 정의만 한 자리면 계약이 지켜진다.
dup=$(grep -l 'BOUNCE_MARKERS' scripts/*.sh | grep -v '^scripts/bounce-state.sh$' || true)
[ -z "$dup" ] || { echo "  ✗ 반송 마커 집합 정의가 bounce-state.sh 밖에도 있다: $dup"; exit 1; }

echo "[closeout·verify-runner] bounce-comment 헬퍼 실행비트·생성 본문 판정 스모크 (#212 · #221)"
# 문구 생성 헬퍼가 실행 비트 없이 배포되면 조용히 exit 126 → 두 SKILL 이 부르는 반송
# 코멘트가 전부 게시 실패로 degrade 한다(PR#173 교훈, bounce-state.sh 와 같은 함정).
[ -x scripts/bounce-comment.sh ] || { echo "  ✗ bounce-comment.sh 실행 비트 없음"; exit 1; }
tmp=$(mktemp -d); mkdir "$tmp/stub"
# gh 스텁은 **마지막 인자**(호출 계약상 항상 --body 값)만 파일에 그대로 쓴다 — 이
# 레포는 bash 3.2 를 지원해야 해 mapfile/연관배열을 못 쓴다(transition.sh:177 선례).
# body 는 개행을 담을 수 있으므로(reverify-fail) 널/줄바꿈 구분자로 여러 인자를
# 합쳐 쓰지 않고, "마지막 인자 하나만 통째로" 쓰는 방식으로 그 문제를 피한다.
cat > "$tmp/stub/gh" <<'STUB'
#!/bin/sh
last=""
for a in "$@"; do last="$a"; done
printf '%s' "$last" > "$STUB_CAPTURE"
exit 0
STUB
chmod +x "$tmp/stub/gh"
# 판정 호출용 별도 스텁 — 항상 실패한다(주입 경로가 gh 를 타면 안 된다는 계약의 봉인).
mkdir "$tmp/nogh"
printf '#!/bin/sh\nexit 1\n' > "$tmp/nogh/gh"; chmod +x "$tmp/nogh/gh"
# 생성 본문이 판정기에 실제로 걸리는지를 문다 — **리터럴 대조가 아니라** 그 본문을
# `BOUNCE_COMMENTS_FILE` 로 `bounce-state.sh` 에 먹여 `bounced` 가 나오는지로 판정한다
# (#221 ②). 옛 방식은 본문을 **이 검사 안의 마커 리터럴**과 맞췄고, 그래서 SSOT
# (`bounce-state.sh` 의 `BOUNCE_MARKERS`)만 바뀌면 헬퍼와 판정기가 **둘 다 낡은 채로**
# CI 가 초록이었다 — 바로 위 "마커 집합은 한 자리" 검사가 세운 원칙을 검사 자신이 어긴
# 자리다. 이제 이 블록에는 마커 리터럴이 한 글자도 없어, 마커 집합이 바뀌면 검사가
# 자동으로 따라간다(가짜 마커를 하나 더해도 이 스모크는 그 형태를 그대로 받아들인다).
for args in \
  "redispatch owner/r 1 2" \
  "reverify-fail owner/r 1 2 3 사유" \
  "closeout-blocker owner/r 1 2 사유"; do
  # shellcheck disable=SC2086
  out=$(PATH="$tmp/stub:$PATH" STUB_CAPTURE="$tmp/cap" scripts/bounce-comment.sh $args 2>&1)
  rc=$?
  [ "$rc" = 0 ] || { echo "  ✗ bounce-comment.sh $args 실패(rc=$rc): $out"; rm -rf "$tmp"; exit 1; }
  # 본문은 개행을 담을 수 있으므로(reverify-fail) 통째로 한 문자열로 싸서 넘긴다.
  # 선행 `머지 판정: ✅` 를 함께 깔아 **실제 판정 형상**(✅ 뒤에 반송이 달린 PR)으로 묻는다
  # — 마커 1건만 넣으면 "✅ 0건이면 bounced" 라는 다른 분기에 기대게 된다.
  jq -Rs '[{body: "머지 판정: ✅ 머지 가능\n<!-- bodat:worker -->", createdAt: "2026-01-01T00:00:00Z"},
           {body: ., createdAt: "2026-01-01T00:00:01Z"}]' < "$tmp/cap" > "$tmp/inject.json" \
    || { echo "  ✗ bounce-comment.sh $args 본문을 판정 입력으로 싸지 못했다"; rm -rf "$tmp"; exit 1; }
  # 판정 실패(exit≠0)와 `ok` 를 같은 방향(실패)으로 받는다 — 반송으로 읽힌다는 것을
  # **증명**해야 통과다(PR#139: 증명 실패는 통과가 아니다).
  # PATH 의 `gh` 는 항상 실패하는 스텁이다 — 주입 경로가 실조회로 새면(계약 위반) 판정이
  # 빈 값이 되어 여기서 즉시 빨개진다. CI 머신의 gh 인증 상태에 이 검사가 기대지 않는다.
  state=$(PATH="$tmp/nogh:$PATH" BOUNCE_COMMENTS_FILE="$tmp/inject.json" \
    scripts/bounce-state.sh owner/r 1) || state=""
  [ "$state" = bounced ] \
    || { echo "  ✗ bounce-comment.sh $args 가 낸 본문을 bounce-state.sh 가 반송으로 못 읽는다(판정=[$state]): $(cat "$tmp/cap")"; rm -rf "$tmp"; exit 1; }
done
rm -rf "$tmp"

echo "[closeout·verify-runner] 스킬 문서가 반송 마커를 손으로 게시하지 않는지 (#271 — #212 재발)"
# #212 는 "SKILL 산문에 박힌 예시 문자열을 손으로 옮겨 적다 콜론·어순이 변형된다" 는
# 사고였고, `bounce-comment.sh` 가 그 문구를 만드는 한 자리다. 그런데 **채널이 없는
# 갈래**(closeout ③-1 마감 검증 BLOCKER 반송)가 남아 있어 2026-09-11 에 같은 마커를
# 두 번 손으로 적었다(#271). 채널을 더하는 것만으로는 재발을 못 막는다 — 다음 편집자가
# 산문에 게시 명령을 다시 적을 수 있다. 그래서 **게시 형태**를 금지한다.
#
# 판정선: 산문의 `--body`(= `gh pr|issue comment` 줄의 `-b`) 값이 **반송 마커로 시작**하면
# 그건 손으로 적은 반송 코멘트다.
# (`gh pr comment … --body "<마커>: …"`). 이 결은 바로 아래 `--reason` 없는 전이 호출·
# 산문 `--add-label needs-human` 가드와 같다 — 금지하는 것은 어휘가 아니라 **명령**이다.
# 어휘 자체는 못 막는다: 종료 보고 형식(`재디스패치: #4770(bodat, stale_reverify)`)·
# 표·설명문에 같은 낱말이 정당하게 쓰인다.
# 마커는 SSOT(`bounce-state.sh` 의 마커 배열)에서 **읽어 온다** — 여기 리터럴로 베껴
# 두면 집합이 바뀔 때 가드가 낡은 채로 초록이다(#221 이 같은 자리에서 밟은 함정).
bc_json=$(sed -n "s/^BOUNCE_MARKERS='\(.*\)'\$/\1/p" scripts/bounce-state.sh | head -1)
[ -n "$bc_json" ] \
  || { echo "  ✗ bounce-state.sh 에서 BOUNCE_MARKERS 정의 줄을 못 찾았다 — 가드가 의미를 잃었다"; exit 1; }
bc_markers=$(printf '%s' "$bc_json" | jq -r '.[]') \
  || { echo "  ✗ BOUNCE_MARKERS JSON 파싱 실패(jq 부재?): $bc_json"; exit 1; }
[ -n "$bc_markers" ] \
  || { echo "  ✗ bounce-state.sh 에서 반송 마커를 하나도 못 읽었다 — 가드가 의미를 잃었다"; exit 1; }
bc_hit=0
# 대상 목록은 하드코딩이다(스킬·템플릿이 몇 안 되고 언어판 비대칭 — verify-runner 는
# 영문판이 없다). 그래서 **파일 부재를 통과로 두지 않는다** — 개명·이동이 가드를 조용히
# 무력화하는 fail-open 이 이 레포의 상습 함정이다(#219 형).
for f in SKILL.md SKILL.en.md skills/closeout/SKILL.md skills/closeout/SKILL.en.md \
         skills/verify-runner/SKILL.md references/worker-template.md references/worker-template.en.md; do
  [ -f "$f" ] \
    || { echo "  ✗ 반송 마커 게시 가드의 대상 파일이 없다: $f (개명·이동이면 목록을 고쳐라)"; exit 1; }
  while IFS= read -r m; do
    [ -n "$m" ] || continue
    # `--body` 뒤 값이 마커로 **시작**하는지. 같은 줄(`--body "…"`·`--body=…`·공백 여러 칸)과
    # **다음 줄로 넘어간 값**(`--body` 로 줄이 끝나거나 `\` 로 이어지는 형태)을 함께 본다 —
    # 한 칸+따옴표만 보던 판본은 긴 gh 명령을 줄바꿈으로 잇는 문서 관행에 그대로 샜다.
    # 단축형 `-b` 도 같이 문다 — 단, **`gh pr|issue comment` 명령줄에 한정**한다(그 줄에서
    # 이어지는 `\` 연속 줄 포함). `-b` 는 `git switch -b` 같은 무관한 용례가 있어 전역으로
    # 물면 오탐이 나는데, 게시 명령으로 한정하면 그 결이 남지 않는다(#271 WARN).
    bc_lines=$(awk -v m="$m" -v q="\"'" '
      function strip(s,   c) {
        sub(/^[[:space:]=]*/, "", s)
        c = substr(s, 1, 1)
        if (c != "" && index(q, c) > 0) s = substr(s, 2)
        sub(/^[[:space:]]*/, "", s)
        return s
      }
      {
        if (pend == 1 && index(strip($0), m) == 1) print NR ": " $0
        pend = 0
        isghc = ($0 ~ /gh[[:space:]]+(pr|issue)[[:space:]]+comment/) || ghc
        off = 0
        i = index($0, "--body")
        if (i > 0) off = i + 6
        else if (isghc && match($0, /(^|[[:space:]])-b([[:space:]=]|$)/))
          off = RSTART + (substr($0, RSTART, 1) == "-" ? 0 : 1) + 2
        if (off > 0) {
          rest = strip(substr($0, off))
          if (index(rest, m) == 1) print NR ": " $0
          else if (rest == "" || rest == "\\") pend = 1
        }
        ghc = (isghc && $0 ~ /\\[[:space:]]*$/) ? 1 : 0
      }
    ' "$f")
    if [ -n "$bc_lines" ]; then
      echo "  ✗ $f: 산문이 반송 마커('$m')를 --body/-b 로 직접 게시한다 — \$SCRIPTS/bounce-comment.sh <채널> 을 쓰라 (#212 · #271)"
      printf '%s\n' "$bc_lines" | head -3
      bc_hit=1
    fi
  done <<EOF
$bc_markers
EOF
done
[ "$bc_hit" = 0 ] || exit 1

echo "[closeout ③-1 ⓐ] 반송 갈래 제어 흐름 — 성공 갈래가 먼저인지 · 반쯤 성공한 전이의 회수 지시가 양쪽 점유를 되살리는지 (#271)"
# 이 레포에선 산문이 곧 실행 코드다. ③-1 ⓐ 절을 **글자 그대로 순차 실행**하는 봇이 빠지는
# 구멍 셋을 문장 순서와 문장 존재로 막는다:
#  ⑴ "코멘트가 비0이면 전이를 하지 마라" 실패 갈래 **뒤**에 전이 호출이 오면, 봇은 그
#     "이어서" 를 성공 갈래 복귀가 아니라 연속 지시로 읽어 전이를 돌린다 — 이슈는
#     `agent-ready`·PR 엔 반송 마커 없음 이 되고 `bounce-state.sh` 가 `ok` 를 내어
#     `closeout-eligible` 이 옛 ✅ 로 재상정한다(그 문단이 막으려던 바로 그 상태).
#  ⑵ `transition.sh` 의 **편집 단계**에서 이슈 쪽이 실패하면(exit 2) `harvesting` 없는 PR 이
#     남아 ①-b(`bounced` 무접촉)·`closeout-eligible`(`bounced` 제외) 어느 레인도 회수하지
#     않는다. 회수 지시(`closeout-pick` 재호출로 점유 되살리기)가 절 안에 있어야 한다.
#  ⑶ 그런데 `transition.sh` 는 **양쪽 편집을 먼저 끝낸 뒤 readback** 한다. 그래서 readback
#     실패(exit 1 불일치·exit 2 조회 실패)는 이슈가 **이미** `agent-ready` + `harvesting` 없음
#     + `agent:claimed` 없음 인 뒤에 난다 — 그건 디스패치 자격이다. 회수 지시가
#     `<repo> - <pr>`(PR 만)면 그 자격이 살아남아 워커와 closeout 이 같은 브랜치를 동시에
#     들고, 다음 틱 `closeout-redispatch` 재시도가 살아 있는 워커의 `agent:claimed` 를 뗀다.
#     그래서 회수 호출의 **인자 모양**까지 문다 — `<repo> <issue> <pr>` 여야 한다.
# 스코프는 **ⓐ~ⓑ 구간**이다 — 파일 전체를 보면 ② Pick 의 `closeout-pick`·①-b 의
# `closeout-redispatch` 같은 다른 절의 같은 문자열에 걸려 가드가 뜻을 잃는다(#223 형).
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  case "$f" in
    *.en.md) fail_anchor='exits non-zero' ;;
    *)       fail_anchor='코멘트가 비0으로 끝나면' ;;
  esac
  a_line=$(grep -nE '^- ⓐ \*\*' "$f" | head -1 | cut -d: -f1) || a_line=""
  b_line=$(grep -nE '^- ⓑ \*\*' "$f" | head -1 | cut -d: -f1) || b_line=""
  { [ -n "$a_line" ] && [ -n "$b_line" ]; } \
    || { echo "  ✗ $f: ③-1 의 ⓐ/ⓑ 갈래 앵커를 못 찾았다 — 개명·이동이면 앵커를 고쳐라"; exit 1; }
  [ "$b_line" -gt "$a_line" ] \
    || { echo "  ✗ $f: ⓑ 앵커가 ⓐ 보다 앞이다 — 구간 스코프가 성립하지 않는다"; exit 1; }
  seg=$(sed -n "${a_line},$((b_line - 1))p" "$f")
  t_rel=$(printf '%s\n' "$seg" | grep -nF -- 'transition.sh closeout-redispatch' | head -1 | cut -d: -f1) || t_rel=""
  f_rel=$(printf '%s\n' "$seg" | grep -nF -- "$fail_anchor" | head -1 | cut -d: -f1) || f_rel=""
  p_rel=$(printf '%s\n' "$seg" | grep -nF -- 'transition.sh closeout-pick' | head -1 | cut -d: -f1) || p_rel=""
  [ -n "$t_rel" ] \
    || { echo "  ✗ $f: ③-1 ⓐ 구간에 transition.sh closeout-redispatch 호출이 없다"; exit 1; }
  [ -n "$f_rel" ] \
    || { echo "  ✗ $f: ③-1 ⓐ 구간에 반송 코멘트 실패 갈래('$fail_anchor')가 없다"; exit 1; }
  [ "$t_rel" -lt "$f_rel" ] \
    || { echo "  ✗ $f: ③-1 ⓐ 의 전이 호출이 실패 갈래보다 뒤다 — 순차 실행하면 코멘트 실패 뒤에도 전이가 돈다 (#271 ⑴)"; exit 1; }
  [ -n "$p_rel" ] \
    || { echo "  ✗ $f: ③-1 ⓐ 구간에 반쯤 성공한 전이의 회수 지시(transition.sh closeout-pick 재호출)가 없다 (#271 ⑵)"; exit 1; }
  # ⑶ 그 회수 호출은 **이슈 인자를 갖춘 형태**여야 한다. `transition.sh` 는 양쪽 편집을 먼저
  #    끝낸 뒤 readback 하므로, readback 실패(exit 1·2)는 **이슈가 이미 `agent-ready` +
  #    `harvesting` 없음 + `agent:claimed` 없음** 인 뒤에 난다 — 그 상태는 디스패치 자격이라
  #    `<repo> - <pr>` 로 PR 만 되살리면 워커와 closeout 이 같은 브랜치를 동시에 든다.
  #    이 갈래엔 연결 이슈가 항상 있으므로(없으면 ⓑ) `<repo> <issue> <pr>` 로 양쪽을 되살린다.
  printf '%s\n' "$seg" | grep -qF -- 'transition.sh closeout-pick <repo> <issue> <pr>' \
    || { echo "  ✗ $f: ③-1 ⓐ 의 회수 호출이 이슈 인자를 안 받는다 — closeout-pick <repo> <issue> <pr> 로 양쪽 점유를 되살려라 (#271 ⑶)"; exit 1; }
  if printf '%s\n' "$seg" | grep -qF -- 'transition.sh closeout-pick <repo> - '; then
    echo "  ✗ $f: ③-1 ⓐ 의 회수 호출이 PR 만 되살리는 '<repo> - <pr>' 형태다 — 이슈 점유가 빈 채로 남아 디스패처가 그 이슈를 집는다 (#271 ⑶)"
    exit 1
  fi
done

echo "[closeout ① Reconcile] resume 재개 지점이 반송 마커를 탄다 — bounce-state 와 closeout-redispatch 가 한 문단에 (#271 ⑷)"
# ③-1 ⓐ 의 회수가 성공하면 PR·이슈에 `harvesting` 이 남아 **다음 틱 ① Reconcile 이 `resume`**
# 을 낸다. 그때 재개 지점을 마커표가 정하면, 이전 회차가 남긴 1단계 마커(`마감 검증:`)가
# 이미 있는 PR 은 ③-1 을 건너뛰고 2단계 머지 게이트로 간다 — 게이트 조건(CI 캐시 pass ·
# `검증자 리뷰:` BLOCKER 0 · MERGEABLE)은 반송 직전 상태 그대로 전부 참이라 **방금 BLOCKER 를
# 낸 head 가 머지된다.** 그래서 ① Reconcile 절은 "반송 상태가 마커표보다 먼저" 를 적어야 하고,
# 그 규칙이 성립하려면 **판정(`bounce-state.sh`)과 행선지(`closeout-redispatch` 재시도 지점)가
# 같은 문단에서 이어져야** 한다 — 둘 중 하나만 남으면 규칙이 반쪽이라 봇이 마커표로 되돌아간다.
# 줄 단위가 아니라 **문단(빈 줄로 끊긴 덩어리)** 단위로 보는 이유: 이 레포 산문은 ~90자에서
# 되접히고 값표는 여러 줄에 걸친다 — 한 줄을 요구하면 재줄바꿈만으로 빨개진다(가드가 뜻이
# 아니라 형태를 물면 다음 편집자가 가드를 지운다).
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  r_start=$(grep -nE '^## ① Reconcile' "$f" | head -1 | cut -d: -f1) || r_start=""
  [ -n "$r_start" ] \
    || { echo "  ✗ $f 에 '## ① Reconcile' 절 앵커가 없다 — 개명·이동이면 앵커를 고쳐라"; exit 1; }
  r_end=$(awk -v s="$r_start" 'NR>s && /^## / { print NR; exit }' "$f")
  [ -n "$r_end" ] \
    || { echo "  ✗ $f: ① Reconcile 다음 절 앵커를 못 찾았다 — 구간 스코프가 성립하지 않는다"; exit 1; }
  sed -n "${r_start},$((r_end - 1))p" "$f" | awk '
    function flush() { if (hb && hr) found = 1; hb = 0; hr = 0 }
    /^[[:space:]]*$/ { flush(); next }
    { if (index($0, "bounce-state.sh")) hb = 1
      if (index($0, "closeout-redispatch")) hr = 1 }
    END { flush(); exit(found ? 0 : 1) }
  ' \
    || { echo "  ✗ $f: ① Reconcile 절에 bounce-state.sh 와 closeout-redispatch 가 **한 문단에** 함께 없다 — resume 재개 규칙이 지워졌다(마커표를 타면 반송된 head 가 2단계 머지로 샌다, #271 ⑷)"; exit 1; }
done

echo "[closeout ① 마커표] 1단계 마커가 head 신선도를 탄다 — 한/영 (#271 ⑸)"
# 옛 마커표는 1단계를 "`마감 검증:` 코멘트가 **있으면** 건너뜀" 한 줄로 적었다. 그 전제는
# 세 방향으로 거짓일 수 있고(⒜ 가장 늦은 마감 검증이 `⚠ 보류` · ⒝ 마커가 현재 head 보다
# 이름 · ⒞ 마커가 최신 반송 마커보다 앞), 셋 다 결말이 같다 — 검증 안 된 head 가 2단계
# 머지 게이트로 가서 머지된다. 그래서 1단계 행은 **판정 헬퍼를 지명**해야 하고, 옛 문구가
# 남아 있으면 안 된다(둘 다 걸린다: 지명 없음 → 규칙 소실 · 옛 문구 잔존 → 두 계약 병존).
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  case "$f" in
    *.en.md) row='^\| 1 verify \|'; oldtxt='if present, skip step 1' ;;
    *)       row='^\| 1 검증 \|';   oldtxt='있으면 1단계 건너뜀' ;;
  esac
  s1_row=$(grep -E "$row" "$f" | head -1)
  [ -n "$s1_row" ] \
    || { echo "  ✗ $f: 멱등 마커표의 1단계 행을 못 찾았다 — 개명·이동이면 앵커를 고쳐라"; exit 1; }
  printf '%s\n' "$s1_row" | grep -qF 'closeout-step1-marker.sh' \
    || { echo "  ✗ $f: 마커표 1단계 행이 판정 헬퍼(closeout-step1-marker.sh)를 안 지명한다 — '있으면 건너뜀' 으로 되돌아가면 검증 안 된 head 가 2단계 머지로 샌다 (#271 ⑸)"; exit 1; }
  if printf '%s\n' "$s1_row" | grep -qF "$oldtxt"; then
    echo "  ✗ $f: 마커표 1단계 행에 옛 문구('$oldtxt')가 남아 있다 — 두 계약이 병존한다 (#271 ⑸)"
    exit 1
  fi
  # 세 축이 산문에 남아 있는지 — 축을 하나 지우면 다음 편집자가 그 갈래를 안 의심한다.
  r_start=$(grep -nE '^## ① Reconcile' "$f" | head -1 | cut -d: -f1)
  r_end=$(awk -v s="$r_start" 'NR>s && /^## / { print NR; exit }' "$f")
  { [ -n "$r_start" ] && [ -n "$r_end" ]; } \
    || { echo "  ✗ $f: ① Reconcile 구간 앵커를 못 찾았다"; exit 1; }
  seg=$(sed -n "${r_start},$((r_end - 1))p" "$f")
  printf '%s\n' "$seg" | grep -qF 'bounce-state.sh --marker-index' \
    || { echo "  ✗ $f: ① Reconcile 절이 반송 선후를 bounce-state.sh --marker-index 한 자리에서 받는다고 적지 않았다 — 마커 매칭이 두 벌이 되면 #171 로 되돌아간다"; exit 1; }
  for ax in '(A)' '(B)' '(C)'; do
    printf '%s\n' "$seg" | grep -qF "$ax" \
      || { echo "  ✗ $f: ① Reconcile 절에 1단계 마커 판정의 축 $ax 설명이 없다 (#271 ⑸)"; exit 1; }
  done
done
# 헬퍼 자신이 세 축을 **전부** 물고 있는지 — 산문만 고치고 코드가 두 축이면 거짓 계약이다.
for mut in MUT-A MUT-B MUT-C; do
  grep -qF "# $mut" scripts/closeout-step1-marker.sh \
    || { echo "  ✗ scripts/closeout-step1-marker.sh 에 $mut 앵커가 없다 — 뮤테이션 방증이 의미를 잃었다 (#271 ⑸)"; exit 1; }
done

echo "[closeout ③-1 ⓐ] 반송 코멘트 실패 갈래가 사람 보류로 접히는지 — 한/영 (#271 ⑹)"
# 코멘트 게시가 실패하면 원장에 반송 흔적이 0 이라 다음 틱 `bounce-state.sh` 가 `ok` 를
# 내고 `resume` 이 마커표 경로로 간다. 그 갈래가 **아무 지속 상태도 안 남기고** 끝나면
# 이번 틱의 BLOCKER 가 원장 어디에도 없는 채 2단계 머지 게이트가 다시 열릴 수 있다.
# 그래서 그 갈래는 라벨 채널(`closeout-blocked`)로 사람 보류에 내려야 한다 — 코멘트
# 채널이 방금 실패했으므로 같은 채널로 남기는 것은 답이 아니다.
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  case "$f" in
    *.en.md) fail_anchor='exits non-zero (gh failure / bad args)' ;;
    *)       fail_anchor='코멘트가 비0으로 끝나면' ;;
  esac
  a_line=$(grep -nE '^- ⓐ \*\*' "$f" | head -1 | cut -d: -f1)
  b_line=$(grep -nE '^- ⓑ \*\*' "$f" | head -1 | cut -d: -f1)
  { [ -n "$a_line" ] && [ -n "$b_line" ] && [ "$b_line" -gt "$a_line" ]; } \
    || { echo "  ✗ $f: ③-1 의 ⓐ/ⓑ 갈래 앵커를 못 찾았다"; exit 1; }
  seg=$(sed -n "${a_line},$((b_line - 1))p" "$f")
  f_rel=$(printf '%s\n' "$seg" | grep -nF -- "$fail_anchor" | head -1 | cut -d: -f1)
  cb_rel=$(printf '%s\n' "$seg" | grep -nF -- 'transition.sh closeout-blocked' | head -1 | cut -d: -f1)
  [ -n "$f_rel" ] \
    || { echo "  ✗ $f: ③-1 ⓐ 구간에 반송 코멘트 실패 갈래('$fail_anchor')가 없다"; exit 1; }
  [ -n "$cb_rel" ] \
    || { echo "  ✗ $f: ③-1 ⓐ 의 코멘트 실패 갈래가 사람 보류(transition.sh closeout-blocked)로 접히지 않는다 — 지속 상태를 아무것도 안 남기면 다음 틱 마커표가 옛 ✅ 로 2단계 머지를 연다 (#271 ⑹)"; exit 1; }
  [ "$cb_rel" -gt "$f_rel" ] \
    || { echo "  ✗ $f: ③-1 ⓐ 의 closeout-blocked 호출이 실패 갈래보다 앞이다 — 성공 갈래가 사람 보류로 새어 나간다 (#271 ⑹)"; exit 1; }
done

echo "[closeout ① Reconcile] OPEN PR 의 사람 보류 게이트 — needs-human 을 resume 으로 태우지 않는다 (#271 ⑺)"
# `resume` 는 `bounced` 재개 절차로 이어져 `closeout-redispatch` 를 거는데, 그 전이는
# `needs-human`·`hold:*` 를 뗀다 — 사람이 조사하려고 방금 붙인 보류가 조용히 벗겨진다
# (①-b 가 대상 필터로 명시 배제하는 바로 그 위험, #151).
grep -qF 'needs-human' scripts/closeout-reconcile.sh \
  || { echo "  ✗ closeout-reconcile.sh 의 OPEN 갈래에 needs-human 검사가 없다 (#271 ⑺)"; exit 1; }
grep -qF 'human_hold' scripts/closeout-reconcile.sh \
  || { echo "  ✗ closeout-reconcile.sh 에 human_hold 이벤트가 없다 (#271 ⑺)"; exit 1; }
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  grep -qF 'human_hold' "$f" \
    || { echo "  ✗ $f 의 ① Reconcile 이벤트 목록에 human_hold 행선지가 없다 — 이벤트에 목적지가 없으면 봇이 무시한다 (#271 ⑺)"; exit 1; }
done
# 런타임 3케이스: needs-human 있음 → human_hold · 없음 → resume · 라벨 미상 → human_hold.
# 스텁은 `gh api search/issues` 가 이미 `-q` 를 적용한 결과를 낸다고 보고 그 자리에 픽스처를
# 꽂는다(실 gh 와 같은 계약: 이 스크립트는 `-q` 결과만 읽는다).
hrun() {  # $1 = items JSON(스크립트가 -q 로 받는 형상)
  tmp=$(mktemp -d); mkdir "$tmp/sc"
  cp scripts/closeout-reconcile.sh "$tmp/sc/closeout-reconcile.sh"
  cat > "$tmp/sc/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"search/issues"*) echo '$1' ;;
  *"pr view"*state*) echo 'OPEN' ;;
  *) echo '' ;;
esac
STUB
  chmod +x "$tmp/sc/gh"
  hout=$(PATH="$tmp/sc:$PATH" bash "$tmp/sc/closeout-reconcile.sh" 2>/dev/null)
  rm -rf "$tmp"
}
hrun '[{"repo":"o/r","num":80,"hh":"true"}]'
printf '%s' "$hout" | jq -e 'select(.event=="human_hold" and .why=="needs-human")' >/dev/null 2>&1 \
  || { echo "  ✗ closeout-reconcile: needs-human PR 이 human_hold 가 아니다 out='$hout'"; exit 1; }
hrun '[{"repo":"o/r","num":80,"hh":"false"}]'
printf '%s' "$hout" | jq -e 'select(.event=="resume")' >/dev/null 2>&1 \
  || { echo "  ✗ closeout-reconcile: 보류 없는 OPEN PR 이 resume 이 아니다 out='$hout'"; exit 1; }
hrun '[{"repo":"o/r","num":80,"hh":false}]'
printf '%s' "$hout" | jq -e 'select(.event=="resume")' >/dev/null 2>&1 \
  || { echo "  ✗ closeout-reconcile: 불리언 false(보류 없음)가 resume 이 아니다 — \`.hh // \"unknown\"\` 관용구는 false 에도 걸려 레인을 통째로 멈춘다 out='$hout'"; exit 1; }
hrun '[{"repo":"o/r","num":80}]'
printf '%s' "$hout" | jq -e 'select(.event=="human_hold")' >/dev/null 2>&1 \
  || { echo "  ✗ closeout-reconcile: 라벨 미상(hh 필드 부재)이 human_hold 로 fail-closed 되지 않는다 out='$hout'"; exit 1; }

echo "[worker] 반송 해소 보고 접두가 마커 집합 밖인지 — 한/영 템플릿 (#251 ②)"
# #251 ② 는 판정기가 아니라 **문안**으로 닫혔다: 워커의 반송 해소 보고가 반송 마커로
# 시작하면 안전망이 그걸 반송으로 읽어, 아무도 반송하지 않은 PR 이 마감 후보에서 빠진다.
# 그 경계를 어휘(`완료`·`해소`)로 판정기 안에서 가르려던 판본은 조사·부정 어미·과거
# 인용에서 **진짜 반송을 `ok` 로 흘려**(main 대조 실측 7형태) 되돌렸다.
# 그래서 계약은 "보고는 마커 밖 접두로 시작한다" 한 줄이고, 여기서 두 가지를 문다:
#   ⑴ 한/영 템플릿 **둘 다** 그 접두를 규정한다(한쪽만 고치면 영문 워커가 옛 문안을 쓴다)
#   ⑵ 그 접두로 시작하는 실제 보고 한 줄이 `bounce-state.sh` 에서 **`ok`** 로 떨어진다
#      — 접두 리터럴을 이 검사에 **한 글자도 베껴 쓰지 않고** 한글 템플릿의 지시문에서
#      뽑아 먹인다(접두를 바꾸면 검사가 자동으로 따라간다). 마커 집합이 늘어 접두와
#      겹치는 날(예 마커에 `반송` 을 추가) 이 검사가 즉시 빨개진다.
wt_prefix=$(sed -n 's/.*\*\*`\([^`]*\)`\*\* *접두로 시작하라.*/\1/p' references/worker-template.md | head -1)
[ -n "$wt_prefix" ] \
  || { echo "  ✗ references/worker-template.md 에서 반송 해소 보고 접두 지시문을 못 찾았다(**\`접두\`** 접두로 시작하라 형태 필요)"; exit 1; }
for f in references/worker-template.md references/worker-template.en.md; do
  grep -qF "\`$wt_prefix\`" "$f" \
    || { echo "  ✗ $f 에 반송 해소 보고 접두('$wt_prefix') 규정이 없다 — 한/영 중 한쪽만 고치면 옛 문안이 살아남는다"; exit 1; }
done
tmp=$(mktemp -d); mkdir "$tmp/nogh"
printf '#!/bin/sh\nexit 1\n' > "$tmp/nogh/gh"; chmod +x "$tmp/nogh/gh"
jq -n --arg b "$wt_prefix: 마감 검증 BLOCKER(계획 부합) 해소 — 재푸시·로컬 CI pass" '[
  {body:"머지 판정: ✅ 머지 가능\n<!-- bodat:worker -->", createdAt:"2026-01-01T00:00:00Z"},
  {body:$b, createdAt:"2026-01-01T00:00:01Z"}]' > "$tmp/report.json" \
  || { echo "  ✗ 보고 문안 판정 입력을 만들지 못했다"; rm -rf "$tmp"; exit 1; }
state=$(PATH="$tmp/nogh:$PATH" BOUNCE_COMMENTS_FILE="$tmp/report.json" \
  scripts/bounce-state.sh owner/r 1) || state=""
[ "$state" = ok ] \
  || { echo "  ✗ 반송 해소 보고 문안('$wt_prefix …')을 bounce-state.sh 가 반송으로 읽는다(판정=[$state]) — 접두가 마커 집합 안이다"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] ①-b 반송 게이트가 갈래 앞에 배선돼 있는지 — 한/영 SKILL (#196·#218)"
# 반송 안전망은 프로즈가 bounce-state.sh 를 직접 부르는 배선 하나로만 선다. 원래
# CONFLICTING 갈래 안에만 있었으나(#196) MERGEABLE stale_reverify/held 갈래는 안 걸려
# #218 사고(반송된 PR 을 "검증 전 사망"으로 오분류·재디스패치)가 났다 — 그래서 게이트를
# mergeable 판정 **앞**(1))으로 끌어올려 두 갈래가 한 자리를 공유하게 했다. 그 호출이
# 사라지거나 다시 갈래 안으로 밀려나면 #196·#218 사고가 그대로 되살아난다 — 문서
# 회귀를 여기서 문다.
# 존재만 보면 문서 아무 데나 적혀 있어도 통과한다(사전 리뷰 NIT) — **finish-classify.sh
# 호출보다 앞**에 있는지까지 본다. 헤더 문구는 번역되므로 언어 불변 앵커를 쓴다: 호출 줄
# (`$SCRIPTS/bounce-state.sh`)이 2) 절의 첫 줄(`$SCRIPTS/finish-classify.sh`)보다 **앞**이어야
# 갈래를 가르기 전에 게이트가 선다.
# 탐색 범위는 **①-b 절 안**이다 — 파일 전체를 `head -1` 로 훑으면 ① Reconcile 의 `resume`
# 재개 갈래가 같은 헬퍼를 부르는 순간(#271 ⑷) 그 줄이 첫 매치를 가로채, ①-b 의 게이트가
# 통째로 지워져도 부등식이 우연히 성립해 초록이 된다(PR#306 이 같은 형태로 밟은 함정).
for f in skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  bb_start=$(grep -nE '^## ①-b' "$f" | head -1 | cut -d: -f1) || bb_start=""
  [ -n "$bb_start" ] \
    || { echo "  ✗ $f 에 '## ①-b' 절 앵커가 없다 — 개명·이동이면 앵커를 고쳐라"; exit 1; }
  bb_end=$(awk -v s="$bb_start" 'NR>s && /^## / { print NR; exit }' "$f")
  [ -n "$bb_end" ] || bb_end=$(wc -l < "$f")
  bb_seg=$(sed -n "${bb_start},${bb_end}p" "$f")
  b_line=$(printf '%s\n' "$bb_seg" | grep -nF '$SCRIPTS/bounce-state.sh' | head -1 | cut -d: -f1)
  fc_line=$(printf '%s\n' "$bb_seg" | grep -nF '$SCRIPTS/finish-classify.sh' | head -1 | cut -d: -f1)
  mg_line=$(printf '%s\n' "$bb_seg" | grep -nF -- '--json mergeable' | head -1 | cut -d: -f1)
  [ -n "$b_line" ] \
    || { echo "  ✗ $f 의 ①-b 절에 반송 게이트(\$SCRIPTS/bounce-state.sh) 호출 없음"; exit 1; }
  [ -n "$fc_line" ] \
    || { echo "  ✗ $f 에 \$SCRIPTS/finish-classify.sh 앵커 없음 — 가드가 의미를 잃었다"; exit 1; }
  [ -n "$mg_line" ] \
    || { echo "  ✗ $f 에 --json mergeable 앵커 없음 — 가드가 의미를 잃었다"; exit 1; }
  [ "$b_line" -lt "$fc_line" ] \
    || { echo "  ✗ $f: bounce-state 호출(줄 $b_line)이 2) finish-classify 절(줄 $fc_line) 뒤다 — 갈래를 가르기 전(1))이어야 한다"; exit 1; }
  # #218 의 실제 회귀 판별선 — 위 b_line<fc_line 만으로는 안 걸린다(CONFLICTING 갈래
  # 안에 갇혀 있던 구버전 문서도 그 부등식은 우연히 만족했다). mergeable 분기보다도
  # bounce-state 호출이 앞이어야 "갈래를 가르기 전에 게이트" 가 성립한다 — 그래야
  # MERGEABLE(stale_reverify·held) 갈래도 같은 게이트를 공유한다. 되돌리면(게이트를
  # CONFLICTING 조건문 뒤로 다시 밀면) 이 줄이 먼저 빨개진다.
  [ "$b_line" -lt "$mg_line" ] \
    || { echo "  ✗ $f: bounce-state 호출(줄 $b_line)이 --json mergeable 분기(줄 $mg_line) 뒤다 — CONFLICTING 갈래 안에 갇혀 MERGEABLE(stale_reverify·held) 이 게이트를 안 탄다(#218)"; exit 1; }
done

echo "[closeout] ci-pass 로컬 CI 분기 세 결과 구분 스모크 (#70 — pass=0/fail=1/부재=2)"
# 로컬 CI 옵트인 레포(root 에 실행가능 bin/ci) → head SHA 캐시 결과로 0/1/2 구분.
# rebase 로 HEAD 가 바뀐 PR 은 새 SHA 결과파일이 부재 → exit 2(재검증 필요)여야 한다.
# (slug 은 repo-dir.sh 의 pwd -P 정규화 경로 기준 — macOS /tmp→/private 심링크 주의.)
ci_pass="$PWD/scripts/closeout-ci-pass.sh"
tmp=$(mktemp -d); mkdir -p "$tmp/stub" "$tmp/proj/r/bin" "$tmp/home"
printf '#!/bin/sh\nexit 0\n' > "$tmp/proj/r/bin/ci"   # 가짜 레포 체크아웃(로컬 CI 옵트인)
chmod +x "$tmp/proj/r/bin/ci"
cat > "$tmp/stub/gh" <<'STUB'
#!/bin/sh
case "$*" in
  *"pr view"*headRefOid*) echo '{"headRefOid":"cafef00d11"}' ;;
  *) echo '' ;;
esac
STUB
chmod +x "$tmp/stub/gh"
realroot=$(cd "$tmp/proj/r" && pwd -P)
slug=$(printf '%s' "$realroot" | sed 's#[/ ]#_#g; s#^_##')
mkdir -p "$tmp/home/.claude/.local-ci/$slug"
run_ci_pass_local() {
  PATH="$tmp/stub:$PATH" HOME="$tmp/home" ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" \
    bash "$ci_pass" o/r 5 >/dev/null 2>&1
}
result="$tmp/home/.claude/.local-ci/$slug/cafef00d11.result"
# (a) 결과파일 부재(현재 HEAD 미실행) → exit 2 (재검증 필요)
rm -f "$result"
rc=0; run_ci_pass_local || rc=$?
[ "$rc" = 2 ] || { echo "  ✗ ci-pass 로컬: 결과파일 부재 → exit $rc (기대 2)"; rm -rf "$tmp"; exit 1; }
# (b) 결과 == pass → exit 0
echo pass > "$result"
rc=0; run_ci_pass_local || rc=$?
[ "$rc" = 0 ] || { echo "  ✗ ci-pass 로컬: pass → exit $rc (기대 0)"; rm -rf "$tmp"; exit 1; }
# (c) 결과 == fail → exit 1
echo fail > "$result"
rc=0; run_ci_pass_local || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ ci-pass 로컬: fail → exit $rc (기대 1)"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] ci-pass rollup 폴백 스모크 (로컬 bin/ci 없는 레포)"
# 로컬 CI 없는 레포(repo-dir.sh 해석 root 에 bin/ci 부재) → GitHub statusCheckRollup
# 으로 판정 (ci-gate 의 그 외 레포 분기와 동일 계약, #51).
ci_pass="$PWD/scripts/closeout-ci-pass.sh"
tmp=$(mktemp -d); mkdir -p "$tmp/stub" "$tmp/proj/r"  # r/bin/ci 일부러 안 만든다
run_ci_pass() {  # $1=rollup JSON 배열 → gh stub 이 statusCheckRollup 으로 반환
  cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *"pr view"*statusCheckRollup*) echo '{"statusCheckRollup":$1}' ;;
  *) echo '' ;;
esac
STUB
  chmod +x "$tmp/stub/gh"
  PATH="$tmp/stub:$PATH" ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" \
    bash "$ci_pass" o/r 5 >/dev/null 2>&1
}
# 전부 SUCCESS (check-run conclusion + 레거시 commit-status state 혼합) → exit 0
rc=0; run_ci_pass '[{"status":"COMPLETED","conclusion":"SUCCESS"},{"state":"SUCCESS"}]' || rc=$?
[ "$rc" = 0 ] || { echo "  ✗ ci-pass rollup: 전부 SUCCESS → exit $rc (기대 0)"; rm -rf "$tmp"; exit 1; }
# FAILURE 포함 → exit 1
rc=0; run_ci_pass '[{"status":"COMPLETED","conclusion":"SUCCESS"},{"status":"COMPLETED","conclusion":"FAILURE"}]' || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ ci-pass rollup: FAILURE 포함 → exit $rc (기대 1)"; rm -rf "$tmp"; exit 1; }
# 미완료(pending) 포함 → exit 1
rc=0; run_ci_pass '[{"status":"IN_PROGRESS"}]' || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ ci-pass rollup: 미완료 포함 → exit $rc (기대 1)"; rm -rf "$tmp"; exit 1; }
# 비-SUCCESS 종결 (열거 안 된 conclusion — STARTUP_FAILURE) 포함 → exit 1
# (SUCCESS 전용 allowlist 판정. denylist 면 여기를 통과시켜 CI 미통과를 pass 로 오인한다.)
rc=0; run_ci_pass '[{"status":"COMPLETED","conclusion":"SUCCESS"},{"status":"COMPLETED","conclusion":"STARTUP_FAILURE"}]' || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ ci-pass rollup: STARTUP_FAILURE 포함 → exit $rc (기대 1)"; rm -rf "$tmp"; exit 1; }
# 알 수 없는 종결값(미래/오타 conclusion) 포함 → exit 1 (allowlist 가 잡아야 한다)
rc=0; run_ci_pass '[{"status":"COMPLETED","conclusion":"UNKNOWN_STATE"}]' || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ ci-pass rollup: 알 수 없는 conclusion 포함 → exit $rc (기대 1)"; rm -rf "$tmp"; exit 1; }
# 빈 rollup(체크 0개) → exit 1
rc=0; run_ci_pass '[]' || rc=$?
[ "$rc" = 1 ] || { echo "  ✗ ci-pass rollup: 빈 rollup → exit $rc (기대 1)"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] eligible 빈-스코프 스모크"
tmp=$(mktemp -d); mkdir "$tmp/stub"
cat > "$tmp/stub/gh" <<'EOF'
#!/bin/sh
case "$*" in *search/issues*) echo '{"items":[]}';; *) echo '';; esac
EOF
chmod +x "$tmp/stub/gh"
out=$(PATH="$tmp/stub:$PATH" bash scripts/closeout-eligible.sh 2>/dev/null); rc=$?
[ "$rc" = 0 ] && [ -z "$out" ] || { echo "  ✗ eligible 빈: rc=$rc out='$out'"; exit 1; }
rm -rf "$tmp"

echo "[closeout] eligible 재검증 후보 분기 스모크 (#70 — exit2=revalidate:true·exit1=탈락·exit0=false)"
# closeout-eligible.sh 가 ci-pass exit code 로 분기하는지 검증(로컬 CI 옵트인 레포).
# 캐시 부재(exit 2)+머지판정✅ → revalidate:true 로 출력, 캐시 fail(exit 1) → 미출력,
# 캐시 pass(exit 0) → revalidate:false. slug 은 ci-pass 와 같은 pwd -P 정규화 경로.
elig="$PWD/scripts/closeout-eligible.sh"
tmp=$(mktemp -d); mkdir -p "$tmp/stub" "$tmp/proj/r/bin" "$tmp/home"
printf '#!/bin/sh\nexit 0\n' > "$tmp/proj/r/bin/ci"   # 가짜 레포(로컬 CI 옵트인)
chmod +x "$tmp/proj/r/bin/ci"
cat > "$tmp/stub/gh" <<'STUB'
#!/bin/sh
# #171: 코멘트는 pr-comments.sh 가 `api .../issues/N/comments --paginate` 로 읽는다
# (`--json comments` 의 첫 100건 상한 회피). 스텁은 --jq 적용 결과 형상(줄줄이 오브젝트)
# 을 그대로 낸다 — 헬퍼가 슬러프해 배열로 만든다.
case "$*" in
  *--paginate*) echo '{"body":"머지 판정: ✅ 머지 가능","createdAt":"2026-01-02T00:00:00Z"}'; exit 0 ;;
esac
case "$*" in
  *"api user"*) echo "tester" ;;
  *"search/issues"*) echo '[{"repo":"o/r","pr":5}]' ;;
  *"pr view"*headRefOid*) echo '{"headRefOid":"feed0070ab"}' ;;
  # #171 반송 4회차 [P1-1]: head 시각은 커밋 목록(상한 100)이 아니라 head SHA 의
  # 커밋 하나를 조회해 얻는다(scripts/pr-head-at.sh).
  *"commits/feed0070ab"*) echo '{"commit":{"committer":{"date":"2026-01-01T00:00:00Z"}}}' ;;
  *"pr view"*headRefName*)
    echo '{"headRefName":"agent/issue-5","mergeable":"MERGEABLE","labels":[],"closingIssuesReferences":[{"number":5}]}' ;;
  *) echo '' ;;
esac
STUB
chmod +x "$tmp/stub/gh"
realroot=$(cd "$tmp/proj/r" && pwd -P)
slug=$(printf '%s' "$realroot" | sed 's#[/ ]#_#g; s#^_##')
mkdir -p "$tmp/home/.claude/.local-ci/$slug"
result="$tmp/home/.claude/.local-ci/$slug/feed0070ab.result"
run_elig() {
  PATH="$tmp/stub:$PATH" HOME="$tmp/home" ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" \
    bash "$elig" 2>/dev/null
}
# (a) 캐시 부재(exit 2) + 머지판정✅ → 후보 출력 + revalidate:true
rm -f "$result"
out=$(run_elig)
printf '%s' "$out" | jq -e 'select(.pr==5 and .revalidate==true)' >/dev/null 2>&1 \
  || { echo "  ✗ eligible 재검증: 캐시 부재 → revalidate:true 미출력 out='$out'"; rm -rf "$tmp"; exit 1; }
# (b) 캐시 fail(exit 1) → 후보 탈락(출력 없음)
echo fail > "$result"
out=$(run_elig)
[ -z "$out" ] || { echo "  ✗ eligible 재검증: 캐시 fail → 탈락 안 됨 out='$out'"; rm -rf "$tmp"; exit 1; }
# (c) 캐시 pass(exit 0) → 후보 출력 + revalidate:false
echo pass > "$result"
out=$(run_elig)
printf '%s' "$out" | jq -e 'select(.pr==5 and .revalidate==false)' >/dev/null 2>&1 \
  || { echo "  ✗ eligible 재검증: 캐시 pass → revalidate:false 미출력 out='$out'"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] eligible sentinel 마커로 머신/사람 코멘트 판정 스모크 (#72)"
# 워커 머신 코멘트는 마지막 줄 <!-- bodat:worker --> 마커로 식별한다. 마커 단 코멘트는
# 접두사 어휘 무관('추가 보정' 같은 자기-노트 포함) unresolved 에서 제외되고, 마커
# 없는 사람 코멘트는 unresolved 로 집계돼 초록불 PR 을 후보에서 탈락시킨다(#72 회귀 가드).
elig="$PWD/scripts/closeout-eligible.sh"
tmp=$(mktemp -d); mkdir -p "$tmp/stub" "$tmp/proj/r/bin" "$tmp/home"
printf '#!/bin/sh\nexit 0\n' > "$tmp/proj/r/bin/ci"; chmod +x "$tmp/proj/r/bin/ci"
realroot=$(cd "$tmp/proj/r" && pwd -P)
slug=$(printf '%s' "$realroot" | sed 's#[/ ]#_#g; s#^_##')
mkdir -p "$tmp/home/.claude/.local-ci/$slug"
echo pass > "$tmp/home/.claude/.local-ci/$slug/feed0070ab.result"   # 캐시 pass → revalidate:false 경로
mkgh() {  # $1 = comments JSON 배열 → 페이지네이션 코멘트 조회 분기에 주입
  # #171: ✅ 신선도 게이트가 판정 시각과 head 커밋 시각을 **둘 다** 요구한다(못 얻으면
  # active=후보 아님). 이 절의 관심사는 마커/unresolved 판정이므로, 시각은 "판정이 커밋보다
  # 늦다" 는 정상 형상으로 자동 부여해 게이트를 상수로 고정한다.
  # 코멘트는 이제 `api .../issues/N/comments --paginate` 로 읽히므로(첫 100건 상한 회피)
  # 파일에 두고 스텁이 --jq 적용 결과 형상(줄줄이 오브젝트)으로 흘린다.
  printf '%s' "$1" | jq -c '[ .[] | {createdAt: "2026-01-02T00:00:00Z"} + . ]' \
    > "$tmp/comments.json"
  cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *--paginate*) jq -c '.[]' "$tmp/comments.json"; exit 0 ;;
esac
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"search/issues"*) echo '[{"repo":"o/r","pr":5}]' ;;
  *"pr view"*headRefOid*) echo '{"headRefOid":"feed0070ab"}' ;;
  # #171 반송 4회차 [P1-1]: head 시각은 커밋 목록(상한 100)이 아니라 head SHA 의
  # 커밋 하나를 조회해 얻는다(scripts/pr-head-at.sh).
  *"commits/feed0070ab"*) echo '{"commit":{"committer":{"date":"2026-01-01T00:00:00Z"}}}' ;;
  *"pr view"*headRefName*)
    echo '{"headRefName":"agent/issue-5","mergeable":"MERGEABLE","labels":[],"closingIssuesReferences":[{"number":5}]}' ;;
  *) echo '' ;;
esac
STUB
  chmod +x "$tmp/stub/gh"
}
run_elig() { PATH="$tmp/stub:$PATH" HOME="$tmp/home" ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" bash "$elig" 2>/dev/null; }
# (a) 머신 코멘트만 (머지판정✅ + 마커 단 자기-노트 '추가 보정') → 후보 출력
mkgh '[{"body":"머지 판정: ✅ 머지 가능 <!-- bodat:worker -->"},{"body":"추가 보정 (e3cb586): revalidate 경로 보정 <!-- bodat:worker -->"}]'
out=$(run_elig)
printf '%s' "$out" | jq -e 'select(.pr==5)' >/dev/null 2>&1 \
  || { echo "  ✗ eligible 마커: 마커 단 머신 코멘트만인데 후보 탈락 out='$out'"; rm -rf "$tmp"; exit 1; }
# (b) 마커 없는 사람 코멘트 추가 → unresolved>0 로 탈락
mkgh '[{"body":"머지 판정: ✅ 머지 가능 <!-- bodat:worker -->"},{"body":"이 부분 다시 확인 부탁드립니다"}]'
out=$(run_elig)
[ -z "$out" ] || { echo "  ✗ eligible 마커: 마커 없는 사람 코멘트가 있는데 탈락 안 됨 out='$out'"; rm -rf "$tmp"; exit 1; }
# (c) 마커 없는 레거시 접두사 코멘트(마커 도입 이전 PR) → 동결 폴백으로 제외 → 후보 출력
mkgh '[{"body":"머지 판정: ✅ 머지 가능"},{"body":"검증자 리뷰: CLEAN"}]'
out=$(run_elig)
printf '%s' "$out" | jq -e 'select(.pr==5)' >/dev/null 2>&1 \
  || { echo "  ✗ eligible 마커: 레거시 접두사(마커 이전) 코멘트가 탈락됨 out='$out'"; rm -rf "$tmp"; exit 1; }
# (d) 영문 긍정 게이트: 영문 머지 판정(Merge verdict: ✅)+마커만 → 후보 출력(긍정 게이트 한·영)
mkgh '[{"body":"Merge verdict: ✅ ready to merge <!-- bodat:worker -->"}]'
out=$(run_elig)
printf '%s' "$out" | jq -e 'select(.pr==5)' >/dev/null 2>&1 \
  || { echo "  ✗ eligible 마커: 영문 머지 판정이 긍정 게이트 통과 못함 out='$out'"; rm -rf "$tmp"; exit 1; }
# (e) 마커가 줄 중간/본문에 있어도 머신으로 제외(contains 위치 무관 — 마지막줄 강제 아님이 계약)
mkgh '[{"body":"머지 판정: ✅ 머지 가능 <!-- bodat:worker -->"},{"body":"중간에 <!-- bodat:worker --> 박힌 자기-노트"}]'
out=$(run_elig)
printf '%s' "$out" | jq -e 'select(.pr==5)' >/dev/null 2>&1 \
  || { echo "  ✗ eligible 마커: 중간 마커 코멘트가 사람으로 오인돼 탈락 out='$out'"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] eligible flow:verify 제외·mergeable UNKNOWN skip 스모크 (#102)"
# closeout 은 verify-runner 소유 라벨(flow:verify) PR 과 mergeable 미판정(UNKNOWN) PR 을
# 후보에서 제외해야 한다 — 두 루프가 같은 PR 을 무는 경합·미판정 머지 방지(#102 회귀 가드).
elig="$PWD/scripts/closeout-eligible.sh"
tmp=$(mktemp -d); mkdir -p "$tmp/stub" "$tmp/proj/r/bin" "$tmp/home"
printf '#!/bin/sh\nexit 0\n' > "$tmp/proj/r/bin/ci"; chmod +x "$tmp/proj/r/bin/ci"
realroot=$(cd "$tmp/proj/r" && pwd -P)
slug=$(printf '%s' "$realroot" | sed 's#[/ ]#_#g; s#^_##')
mkdir -p "$tmp/home/.claude/.local-ci/$slug"
echo pass > "$tmp/home/.claude/.local-ci/$slug/feed0070ab.result"   # 캐시 pass → ci-pass exit 0
mkgh2() {  # $1 = labels JSON 배열, $2 = mergeable 값 → gh pr view headRefName 분기에 주입
  # 코멘트는 #171 이후 페이지네이션 경로(`api .../comments --paginate`)로 읽힌다.
  cat > "$tmp/stub/gh" <<STUB
#!/bin/sh
case "\$*" in
  *--paginate*) echo '{"body":"머지 판정: ✅ 머지 가능 <!-- bodat:worker -->","createdAt":"2026-01-02T00:00:00Z"}'; exit 0 ;;
esac
case "\$*" in
  *"api user"*) echo "tester" ;;
  *"search/issues"*) echo '[{"repo":"o/r","pr":5}]' ;;
  *"pr view"*headRefOid*) echo '{"headRefOid":"feed0070ab"}' ;;
  # #171 반송 4회차 [P1-1]: head 시각은 커밋 목록(상한 100)이 아니라 head SHA 의
  # 커밋 하나를 조회해 얻는다(scripts/pr-head-at.sh).
  *"commits/feed0070ab"*) echo '{"commit":{"committer":{"date":"2026-01-01T00:00:00Z"}}}' ;;
  *"pr view"*headRefName*)
    echo '{"headRefName":"agent/issue-5","mergeable":"$2","labels":$1,"closingIssuesReferences":[{"number":5}]}' ;;
  *) echo '' ;;
esac
STUB
  chmod +x "$tmp/stub/gh"
}
run_elig2() { PATH="$tmp/stub:$PATH" HOME="$tmp/home" ISSUE_RUNNER_PROJECTS_ROOT="$tmp/proj" bash "$elig" 2>/dev/null; }
# (a) 정상 인계: flow:verify 없음 + MERGEABLE + ✅ → 후보 출력
mkgh2 '[]' 'MERGEABLE'
out=$(run_elig2)
printf '%s' "$out" | jq -e 'select(.pr==5)' >/dev/null 2>&1 \
  || { echo "  ✗ eligible #102: 정상 인계 PR 이 후보에서 탈락 out='$out'"; rm -rf "$tmp"; exit 1; }
# (b) flow:verify 라벨 부착(✅ 가 라벨 제거보다 먼저 달린 경합) → 탈락
mkgh2 '[{"name":"flow:verify"}]' 'MERGEABLE'
out=$(run_elig2)
[ -z "$out" ] || { echo "  ✗ eligible #102: flow:verify PR 이 탈락 안 됨 out='$out'"; rm -rf "$tmp"; exit 1; }
# (c) mergeable UNKNOWN(지연 계산 미완) → skip
mkgh2 '[]' 'UNKNOWN'
out=$(run_elig2)
[ -z "$out" ] || { echo "  ✗ eligible #102: mergeable UNKNOWN PR 이 skip 안 됨 out='$out'"; rm -rf "$tmp"; exit 1; }
rm -rf "$tmp"

echo "[closeout] 머신 코멘트 sentinel 마커 주입 지시 검사 (#72)"
# 워커/closeout 머신 코멘트에 <!-- bodat:worker --> 마커를 박으라는 지시가 워커
# 템플릿(한/영)+closeout SKILL(한/영) 양쪽에 있어야 한다. 빠지면 접두사 allowlist 회귀.
for f in references/worker-template.md references/worker-template.en.md \
         skills/closeout/SKILL.md skills/closeout/SKILL.en.md; do
  grep -qF '<!-- bodat:worker -->' "$f" || { echo "  ✗ $f 에 sentinel 마커 주입 지시 없음"; exit 1; }
done

